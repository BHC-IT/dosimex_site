---
import Layout from '@/layouts/Layout.astro'
import { getTranslations, getLocalePaths, type Locale } from '@/i18n/utils'
import { organizationSchema } from '@/data/schemas'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)

const isFr = locale === 'fr'
---

<Layout title={isFr ? 'Politique de Confidentialité — Dosimex' : 'Privacy Policy — Dosimex'} description={isFr ? 'Politique de confidentialité de Dosimex : collecte, utilisation et protection de vos données personnelles conformément au RGPD.' : 'Dosimex privacy policy: collection, use and protection of your personal data in accordance with GDPR.'} jsonLd={[organizationSchema]}>

	<section class="py-12 md:py-20">
		<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
			<h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-foreground tracking-tight">
				{isFr ? 'Politique de Confidentialité' : 'Privacy Policy'}
			</h1>

			<div class="mt-12 space-y-10 text-base text-slate-600 dark:text-slate-400 leading-relaxed">

				<!-- Introduction -->
				<div>
					<h2 class="text-2xl md:text-3xl font-heading font-semibold text-foreground">
						Introduction
					</h2>
					<p class="mt-4">
						{isFr
							? 'La protection de vos données personnelles est une priorité pour Dosimex. Cette politique de confidentialité explique comment nous collectons, utilisons, stockons et protégeons vos informations personnelles conformément au Règlement Général sur la Protection des Données (RGPD).'
							: 'The protection of your personal data is a priority for Dosimex. This privacy policy explains how we collect, use, store and protect your personal information in accordance with the General Data Protection Regulation (GDPR).'}
					</p>
				</div>

				<!-- Conformité RGPD -->
				<div>
					<h2 class="text-2xl md:text-3xl font-heading font-semibold text-foreground">
						{isFr ? 'Conformité RGPD' : 'GDPR Compliance'}
					</h2>
					<p class="mt-4">
						{isFr
							? "Dosimex s'engage à respecter le RGPD et garantit :"
							: 'Dosimex is committed to respecting GDPR and guarantees:'}
					</p>
					<ul class="mt-3 space-y-2 list-disc list-inside">
						<li>{isFr ? 'Responsable du traitement : Dosimex SAS' : 'Data Controller: Dosimex SAS'}</li>
						<li>{isFr ? 'Base légale : Exécution du contrat, consentement, intérêts légitimes' : 'Legal Basis: Contract execution, consent, legitimate interests'}</li>
						<li>{isFr ? 'Protection des données dès la conception et par défaut' : 'Data protection by design and by default'}</li>
					</ul>
				</div>

				<!-- Données collectées -->
				<div>
					<h2 class="text-2xl md:text-3xl font-heading font-semibold text-foreground">
						{isFr ? 'Données collectées' : 'Data Collected'}
					</h2>
					<p class="mt-4">
						{isFr ? 'Nous collectons les données suivantes :' : 'We collect the following data:'}
					</p>
					<ul class="mt-3 space-y-2 list-disc list-inside">
						<li>{isFr ? "Informations d'identification : nom, prénom, adresse e-mail" : 'Identification information: name, first name, email address'}</li>
						<li>{isFr ? "Données d'utilisation : calculs effectués, historique des sessions" : 'Usage data: calculations performed, session history'}</li>
						<li>{isFr ? 'Données techniques : adresse IP, type de navigateur, système d\'exploitation' : 'Technical data: IP address, browser type, operating system'}</li>
					</ul>
				</div>

				<!-- Utilisation des données -->
				<div>
					<h2 class="text-2xl md:text-3xl font-heading font-semibold text-foreground">
						{isFr ? 'Utilisation des données' : 'Data Usage'}
					</h2>
					<ul class="mt-4 space-y-2 list-disc list-inside">
						<li>{isFr ? 'Fourniture et amélioration de nos services' : 'Provision and improvement of our services'}</li>
						<li>{isFr ? "Analyse et amélioration de l'expérience utilisateur" : 'Analysis and improvement of user experience'}</li>
						<li>{isFr ? 'Communication relative au service' : 'Communication related to the service'}</li>
						<li>{isFr ? 'Sécurité et prévention de la fraude' : 'Security and fraud prevention'}</li>
					</ul>
				</div>

				<!-- Conservation des données -->
				<div>
					<h2 class="text-2xl md:text-3xl font-heading font-semibold text-foreground">
						{isFr ? 'Conservation des données' : 'Data Retention'}
					</h2>
					<p class="mt-4">
						{isFr
							? 'Vos données sont conservées pendant la durée nécessaire aux finalités pour lesquelles elles ont été collectées, conformément aux obligations légales et réglementaires.'
							: 'Your data is retained for the time necessary for the purposes for which it was collected, in accordance with legal and regulatory obligations.'}
					</p>
				</div>

				<!-- Vos droits -->
				<div>
					<h2 class="text-2xl md:text-3xl font-heading font-semibold text-foreground">
						{isFr ? 'Vos droits' : 'Your Rights'}
					</h2>
					<p class="mt-4">
						{isFr
							? 'Conformément au RGPD, vous disposez des droits suivants :'
							: 'In accordance with GDPR, you have the following rights:'}
					</p>
					<ul class="mt-3 space-y-2 list-disc list-inside">
						<li>{isFr ? "Droit d'accès : obtenir une copie de vos données" : 'Right of access: obtain a copy of your data'}</li>
						<li>{isFr ? 'Droit de rectification : corriger des données inexactes' : 'Right of rectification: correct inaccurate data'}</li>
						<li>{isFr ? "Droit à l'effacement : demander la suppression de vos données" : 'Right to erasure: request deletion of your data'}</li>
						<li>{isFr ? 'Droit à la portabilité : recevoir vos données dans un format structuré' : 'Right to portability: receive your data in a structured format'}</li>
						<li>{isFr ? "Droit d'opposition : vous opposer au traitement de vos données" : 'Right to object: object to the processing of your data'}</li>
						<li>{isFr ? 'Droit de déposer une plainte auprès de la CNIL' : 'Right to lodge a complaint with the CNIL'}</li>
					</ul>
				</div>

				<!-- Cookies -->
				<div>
					<h2 class="text-2xl md:text-3xl font-heading font-semibold text-foreground">
						{isFr ? 'Cookies et stockage navigateur' : 'Cookies and Browser Storage'}
					</h2>
					<p class="mt-4">
						{isFr
							? "Nous utilisons différents mécanismes de stockage pour vous offrir la meilleure expérience tout en respectant votre vie privée."
							: 'We use different storage mechanisms to provide you with the best experience while respecting your privacy.'}
					</p>

					<h3 class="mt-6 text-lg font-heading font-semibold text-foreground">
						{isFr ? 'Cookies strictement nécessaires' : 'Strictly Necessary Cookies'}
					</h3>
					<p class="mt-2">
						{isFr
							? "Ces cookies sont essentiels au fonctionnement de la plateforme et ne peuvent pas être désactivés. Ils ne nécessitent pas de consentement sous le RGPD car ils sont strictement nécessaires au service."
							: 'These cookies are essential for the platform to function and cannot be disabled. They do not require consent under GDPR as they are strictly necessary for the service.'}
					</p>

					<h3 class="mt-6 text-lg font-heading font-semibold text-foreground">
						{isFr ? 'Stockage local du navigateur' : 'Browser Local Storage'}
					</h3>
					<p class="mt-2">
						{isFr
							? "Nous utilisons le stockage local de votre navigateur (et non des cookies) pour mémoriser vos préférences. Ces données restent sur votre appareil et vous pouvez les supprimer à tout moment."
							: "We use your browser's local storage (not cookies) to remember your preferences. This data stays on your device and you can delete it anytime."}
					</p>

					<h3 class="mt-6 text-lg font-heading font-semibold text-foreground">
						{isFr ? 'Comment gérer le stockage' : 'How to Manage Storage'}
					</h3>
					<p class="mt-2">
						{isFr
							? "Vous pouvez gérer les cookies et le stockage local via les paramètres de votre navigateur. La désactivation des cookies strictement nécessaires vous empêchera d'utiliser la plateforme. L'effacement du stockage local réinitialisera vos préférences."
							: 'You can manage cookies and local storage through your browser settings. Disabling strictly necessary cookies will prevent you from using the platform. Clearing local storage will reset your preferences.'}
					</p>

					<p class="mt-4 font-semibold text-foreground">
						{isFr
							? "Nous n'utilisons aucun cookie d'analyse, de suivi ou de publicité."
							: 'We do not use any analytics, tracking, or advertising cookies.'}
					</p>
				</div>

				<!-- Contact DPO -->
				<div>
					<h2 class="text-2xl md:text-3xl font-heading font-semibold text-foreground">
						{isFr ? 'Contact DPO' : 'DPO Contact'}
					</h2>
					<p class="mt-4">
						{isFr
							? 'Pour toute question concernant vos données personnelles, contactez notre Délégué à la Protection des Données :'
							: 'For any questions regarding your personal data, contact our Data Protection Officer:'}
					</p>
					<p class="mt-2">
						<a href="mailto:dpo@dosimex.com" class="text-primary-600 hover:underline">dpo@dosimex.com</a>
					</p>
				</div>

			</div>
		</div>
	</section>

</Layout>
