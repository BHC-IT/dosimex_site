---
/**
 * HeroGammaDemo — interactive point-source gamma dose-rate widget for the hero.
 *
 * The dose-rate table below is NOT invented: every value was computed by the real
 * Dosismart gamma engine (POST /api/v1/calculator/gamma/dose-rate, H*(10), 1 GBq,
 * point source, 5 cm shield) and is stored in nSv/h exactly as the API returns it.
 * The display formatting mirrors the app (÷1e9 then engineering prefix), so the
 * hero shows the same string a user sees inside Dosismart for the same inputs.
 *
 * Distance is a fixed 3-value toggle rather than a free slider: the engine includes
 * air attenuation, so dose rate is NOT exactly 1/d² and interpolating would drift
 * away from the app. Adding a distance means adding a measured column below.
 *
 * One small single-purpose widget — the mission ("le calcul radioprotection à la
 * portée de tous") made literal, and the top of the acquisition funnel. Framed in
 * WindowFrame per CLAUDE.md › "Voice & UI › Visuals" (rebuilt preview, no screenshot).
 */
import WindowFrame from './WindowFrame.astro'
import type { Locale } from '@/i18n/utils'

interface Props {
	locale: Locale
	class?: string
}

const { locale, class: className = '' } = Astro.props
const isFr = locale === 'fr'

const t = {
	activity: isFr ? 'Source ponctuelle · 1 GBq' : 'Point source · 1 GBq',
	isotope: isFr ? 'Radionucléide' : 'Radionuclide',
	shield: isFr ? 'Écran (épaisseur 5 cm)' : 'Shield (5 cm thick)',
	lead: isFr ? 'Plomb' : 'Lead',
	concrete: isFr ? 'Béton' : 'Concrete',
	distance: isFr ? 'Distance' : 'Distance',
	behind: isFr ? "Débit de dose derrière l'écran" : 'Dose rate behind shield',
	noShield: isFr ? 'sans écran' : 'no shield',
	cta: isFr ? 'Faire le calcul complet dans Dosismart' : 'Run the full calculation in Dosismart',
	demo: isFr
		? 'H*(10) - valeurs calculées par le moteur Dosismart - aperçu illustratif'
		: 'H*(10) - values computed by the Dosismart engine - illustrative preview',
}

const isotopes = [
	{ id: 'cs137', label: 'Cs-137' },
	{ id: 'co60', label: 'Co-60' },
	{ id: 'ir192', label: 'Ir-192' },
]
const shields = [
	{ id: 'lead', label: t.lead },
	{ id: 'concrete', label: t.concrete },
]
const distances = [
	{ id: '1', label: '1 m' },
	{ id: '2', label: '2 m' },
	{ id: '5', label: '5 m' },
]

const seg = 'flex-1 rounded-md px-3 py-1.5 text-sm font-medium transition-colors'
const segActive = 'bg-primary text-primary-foreground shadow-sm'
const segIdle = 'text-muted-foreground hover:text-foreground'
---

<div id="hero-gamma-demo" class:list={['w-full max-w-md', className]}>
	<WindowFrame>
		<div class="space-y-5 p-5 sm:p-6">
			<!-- eyebrow -->
			<span class="block text-xs font-semibold uppercase tracking-widest text-primary">{t.activity}</span>

			<!-- isotope toggle -->
			<div>
				<p class="mb-1.5 text-xs font-medium text-muted-foreground">{t.isotope}</p>
				<div class="inline-flex w-full rounded-lg border border-border bg-muted/40 p-1" role="group" aria-label={t.isotope}>
					{isotopes.map((iso, i) => (
						<button type="button" data-iso={iso.id} aria-pressed={i === 0 ? 'true' : 'false'}
							class:list={[seg, i === 0 ? segActive : segIdle]}>{iso.label}</button>
					))}
				</div>
			</div>

			<!-- shield toggle -->
			<div>
				<p class="mb-1.5 text-xs font-medium text-muted-foreground">{t.shield}</p>
				<div class="inline-flex w-full rounded-lg border border-border bg-muted/40 p-1" role="group" aria-label={t.shield}>
					{shields.map((sh, i) => (
						<button type="button" data-shield={sh.id} aria-pressed={i === 0 ? 'true' : 'false'}
							class:list={[seg, i === 0 ? segActive : segIdle]}>{sh.label}</button>
					))}
				</div>
			</div>

			<!-- distance toggle -->
			<div>
				<p class="mb-1.5 text-xs font-medium text-muted-foreground">{t.distance}</p>
				<div class="inline-flex w-full rounded-lg border border-border bg-muted/40 p-1" role="group" aria-label={t.distance}>
					{distances.map((d, i) => (
						<button type="button" data-distance={d.id} aria-pressed={i === 0 ? 'true' : 'false'}
							class:list={[seg, i === 0 ? segActive : segIdle]}>{d.label}</button>
					))}
				</div>
			</div>

			<!-- result -->
			<div class="rounded-lg border border-border bg-background p-4">
				<p class="text-xs text-muted-foreground">{t.behind}</p>
				<p class="mt-0.5">
					<span data-result class="font-heading text-2xl font-bold text-primary">483.96</span>
					<span data-result-unit class="ml-1 text-sm text-muted-foreground">nSv/h</span>
				</p>
				<p class="mt-2 text-xs text-muted-foreground">
					{t.noShield} : <span data-unshielded class="font-medium text-foreground/70">91.51</span>
					<span data-unshielded-unit>µSv/h</span>
				</p>
			</div>

			<!-- CTA + disclaimer -->
			<div class="flex items-center justify-between gap-3">
				<a href="https://dosismart.com" target="_blank" rel="noopener noreferrer"
					class="inline-flex items-center gap-1 text-sm font-heading font-semibold text-primary hover:underline"
					data-ph-cta="hero-gamma-demo">
					{t.cta}
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>
			<p class="text-xs italic text-muted-foreground/70">{t.demo}</p>
		</div>
	</WindowFrame>
</div>

<script>
	// Dose rates in nSv/h, exactly as the Dosismart API returns them, for
	// H*(10) · point source · 1 GBq · 5 cm shield, at 1 / 2 / 5 m.
	// Regenerate with POST /api/v1/calculator/gamma/dose-rate — never hand-edit.
	type Row = Record<string, readonly [number, number, number]>
	const DISTANCES = ['1', '2', '5'] as const
	const DATA: Record<string, Row> = {
		cs137: {
			unshielded: [91507.79, 22638.91, 3510.44],
			lead: [483.96, 119.78, 18.6],
			concrete: [71806.61, 17772.21, 2759.04],
		},
		co60: {
			unshielded: [346227.06, 85919.94, 13445.56],
			lead: [28533.36, 7081.09, 1108.22],
			concrete: [279271.8, 69304.29, 10845.39],
		},
		ir192: {
			unshielded: [137303.32, 33884.02, 5216.22],
			lead: [41.06, 10.16, 1.58],
			concrete: [126088.45, 31126.81, 4795.16],
		},
	}

	// Mirrors the app's dose-rate formatter: nSv/h → Sv/h, then engineering prefix.
	const PREFIXES = ['n', 'µ', 'm', '', 'k'] as const
	const BASE_INDEX = 3

	function format(nanoSvPerHour: number): { value: string; unit: string } {
		let value = nanoSvPerHour / 1e9
		let power = 0
		while (value >= 1000) {
			value /= 1000
			power++
		}
		while (value > 0 && value < 1) {
			value *= 1000
			power--
		}
		const prefix = PREFIXES[Math.min(Math.max(BASE_INDEX + power, 0), PREFIXES.length - 1)]
		const decimals = Math.abs(value) < 0.01 ? 3 : 2
		const text = value.toFixed(decimals).replace(/\.?0+$/, '') || '0'
		return { value: text, unit: `${prefix}Sv/h` }
	}

	function initHeroGammaDemo() {
		const root = document.getElementById('hero-gamma-demo')
		if (!root || root.dataset.wired === 'true') return
		root.dataset.wired = 'true'

		let iso = 'cs137'
		let shield: 'lead' | 'concrete' = 'lead'
		let distanceIndex = 0

		const resultEl = root.querySelector('[data-result]')!
		const resultUnitEl = root.querySelector('[data-result-unit]')!
		const unshieldedEl = root.querySelector('[data-unshielded]')!
		const unshieldedUnitEl = root.querySelector('[data-unshielded-unit]')!
		const isoBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-iso]'))
		const shieldBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-shield]'))
		const distBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-distance]'))

		const ACTIVE = ['bg-primary', 'text-primary-foreground', 'shadow-sm']
		const IDLE = ['text-muted-foreground', 'hover:text-foreground']
		function setActive(btns: HTMLButtonElement[], match: (b: HTMLButtonElement) => boolean) {
			btns.forEach((b) => {
				const on = match(b)
				b.setAttribute('aria-pressed', on ? 'true' : 'false')
				ACTIVE.forEach((c) => b.classList.toggle(c, on))
				IDLE.forEach((c) => b.classList.toggle(c, !on))
			})
		}

		function render() {
			const row = DATA[iso]
			const shielded = format(row[shield][distanceIndex])
			const unshielded = format(row.unshielded[distanceIndex])
			resultEl.textContent = shielded.value
			resultUnitEl.textContent = shielded.unit
			unshieldedEl.textContent = unshielded.value
			unshieldedUnitEl.textContent = ' ' + unshielded.unit
		}

		isoBtns.forEach((b) =>
			b.addEventListener('click', () => {
				iso = b.dataset.iso!
				setActive(isoBtns, (x) => x.dataset.iso === iso)
				render()
			}),
		)
		shieldBtns.forEach((b) =>
			b.addEventListener('click', () => {
				shield = b.dataset.shield as 'lead' | 'concrete'
				setActive(shieldBtns, (x) => x.dataset.shield === shield)
				render()
			}),
		)
		distBtns.forEach((b) =>
			b.addEventListener('click', () => {
				distanceIndex = DISTANCES.indexOf(b.dataset.distance as (typeof DISTANCES)[number])
				setActive(distBtns, (x) => x.dataset.distance === DISTANCES[distanceIndex])
				render()
			}),
		)

		render()
	}

	initHeroGammaDemo()
	document.addEventListener('astro:page-load', initHeroGammaDemo)
</script>
