---
interface Props {
	videoId: string
	title?: string
	class?: string
}

const { videoId, title = 'YouTube video', class: className = '' } = Astro.props
---

<div
	class:list={['yt-facade relative aspect-video w-full overflow-hidden rounded-xl cursor-pointer bg-black', className]}
	data-video-id={videoId}
	data-video-title={title}
	role="button"
	tabindex="0"
	aria-label={`Play: ${title}`}
>
	<!-- YouTube thumbnail -->
	<img
		src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
		alt={title}
		class="absolute inset-0 h-full w-full object-cover"
		loading="lazy"
	/>
	<!-- Play button overlay -->
	<div class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors hover:bg-black/10">
		<svg class="h-16 w-16 text-white drop-shadow-lg" viewBox="0 0 68 48" fill="none">
			<path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="red"/>
			<path d="M45 24L27 14v20" fill="white"/>
		</svg>
	</div>
</div>

<script>
	function initFacades() {
		document.querySelectorAll<HTMLElement>('.yt-facade').forEach((el) => {
			if (el.dataset.initialized) return
			el.dataset.initialized = 'true'

			const activate = () => {
				const id = el.dataset.videoId
				const title = el.dataset.videoTitle ?? 'YouTube video'

				// PostHog tracking
				if (typeof posthog !== 'undefined') {
					const [, lang] = window.location.pathname.split('/')
					posthog.capture('video_play', {
						locale: lang === 'en' ? 'en' : 'fr',
						page: window.location.pathname,
						video_id: id,
						video_title: title,
					})
				}
				const iframe = document.createElement('iframe')
				iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`
				iframe.title = title
				iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
				iframe.allowFullscreen = true
				iframe.className = 'absolute inset-0 h-full w-full'
				el.replaceChildren(iframe)
				el.classList.remove('cursor-pointer')
				el.removeAttribute('role')
				el.removeAttribute('tabindex')
				el.removeAttribute('aria-label')
			}

			el.addEventListener('click', activate, { once: true })
			el.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault()
					activate()
				}
			}, { once: true })
		})
	}

	initFacades()
	document.addEventListener('astro:page-load', initFacades)
</script>
