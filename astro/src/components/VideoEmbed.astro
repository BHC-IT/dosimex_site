---
interface Props {
	videoId: string
	title?: string
}

const { videoId, title = 'Video' } = Astro.props
const thumbnailUrl = `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`
---

<div
	class="relative aspect-video rounded-lg overflow-hidden shadow-lg cursor-pointer group"
	data-video-id={videoId}
	role="button"
	tabindex="0"
	aria-label={`Play video: ${title}`}
>
	<!-- Thumbnail -->
	<img
		src={thumbnailUrl}
		alt={title}
		class="w-full h-full object-cover"
		loading="lazy"
	/>

	<!-- Overlay -->
	<div class="absolute inset-0 bg-black/35 group-hover:bg-black/25 transition-colors duration-200 flex items-center justify-center">
		<!-- Play button -->
		<div class="w-[72px] h-[72px] bg-primary-600 rounded-full flex items-center justify-center shadow-[0_4px_24px_rgba(219,33,50,0.3)] group-hover:scale-110 transition-transform duration-200">
			<svg class="w-6 h-6 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
				<path d="M8 5v14l11-7z" />
			</svg>
		</div>
	</div>
</div>

<script>
	function initVideoEmbeds() {
		document.querySelectorAll<HTMLElement>('[data-video-id]').forEach((el) => {
			function activate() {
				const id = el.dataset.videoId
				if (!id) return
				const iframe = document.createElement('iframe')
				iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`
				iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
				iframe.allowFullscreen = true
				iframe.className = 'absolute inset-0 w-full h-full'
				iframe.title = el.getAttribute('aria-label') ?? 'Video'
				el.innerHTML = ''
				el.classList.remove('cursor-pointer')
				el.removeAttribute('role')
				el.removeAttribute('tabindex')
				el.appendChild(iframe)
			}
			el.addEventListener('click', activate, { once: true })
			el.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault()
					activate()
				}
			}, { once: true })
		})
	}
	initVideoEmbeds()
	document.addEventListener('astro:page-load', initVideoEmbeds)
</script>
