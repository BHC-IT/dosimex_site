---
interface Props {
	videoId: string
	title?: string
}

const { videoId, title = 'Video' } = Astro.props
const thumbnailUrl = `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`
const embedSrc = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`
---

<div
	class="video-embed relative aspect-video rounded-lg overflow-hidden shadow-lg cursor-pointer group"
	data-embed-src={embedSrc}
	role="button"
	tabindex="0"
	aria-label={`Play video: ${title}`}
>
	<!-- Thumbnail -->
	<img
		src={thumbnailUrl}
		alt={title}
		class="w-full h-full object-cover"
		loading="lazy"
	/>

	<!-- Overlay -->
	<div class="video-overlay absolute inset-0 bg-black/35 group-hover:bg-black/25 transition-colors duration-200 flex items-center justify-center">
		<!-- Play button -->
		<div class="w-12 h-12 bg-primary-600 rounded-full flex items-center justify-center shadow-[0_4px_16px_rgba(61,97,255,0.3)] group-hover:scale-110 transition-transform duration-200">
			<svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
				<path d="M8 5v14l11-7z" />
			</svg>
		</div>
	</div>
</div>

<script>
	function initVideoEmbeds() {
		document.querySelectorAll<HTMLElement>('.video-embed').forEach((el) => {
			if (el.dataset.ready) return
			el.dataset.ready = '1'

			function activate() {
				const src = el.dataset.embedSrc
				if (!src || el.querySelector('iframe')) return

				const iframe = document.createElement('iframe')
				iframe.src = src
				iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
				iframe.referrerPolicy = 'strict-origin-when-cross-origin'
				iframe.allowFullscreen = true
				iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;z-index:10;border:none'
				iframe.title = el.getAttribute('aria-label') ?? 'Video'

				el.appendChild(iframe)
				el.classList.remove('cursor-pointer')
				el.removeAttribute('role')
				el.removeAttribute('tabindex')
			}

			el.addEventListener('click', activate, { once: true })
			el.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault()
					activate()
				}
			}, { once: true })
		})
	}
	initVideoEmbeds()
	document.addEventListener('astro:page-load', initVideoEmbeds)
</script>
