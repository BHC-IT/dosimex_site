---
import Layout from '@/layouts/Layout.astro'
import { getTranslations, getLocalePaths, localePath, type Locale } from '@/i18n/utils'
import { organizationSchema } from '@/data/schemas'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)
const p = t.product

const trialLabel = locale === 'fr' ? 'Essai gratuit 14 jours' : 'Free trial 14 days'
const quoteLabel = locale === 'fr' ? 'Demander un devis' : 'Request a quote'
const monthlyNote = locale === 'fr' ? 'Soit moins de 42\u20AC/mois' : 'Less than \u20AC42/month'

const softwareSchema = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Dosimex 3.2 + Dosismart',
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Windows, Web',
	offers: {
		'@type': 'Offer',
		price: '500',
		priceCurrency: 'EUR',
		description: p.schemaDescription,
	},
}

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: p.faq.questions.map((q) => ({
		'@type': 'Question',
		name: q.question,
		acceptedAnswer: { '@type': 'Answer', text: q.answer },
	})),
}
---

<Layout title={t.seo.product.title} description={t.seo.product.description} jsonLd={[organizationSchema, softwareSchema, faqSchema]}>

	<!-- ═══════════════════════════ HERO ═══════════════════════════ -->
	<section class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-3xl font-semibold tracking-tight text-foreground font-heading md:text-4xl lg:text-5xl">
				{p.title}
			</h1>
			<p class="mx-auto mt-6 max-w-3xl text-base text-slate-600 dark:text-slate-400 leading-relaxed">
				{p.description}
			</p>
		</div>
	</section>

	<!-- ═══════════════════════════ PRICING CARDS ═══════════════════════════ -->
	<section data-ph-section="pricing" class="bg-[#E8E6E3] dark:bg-[#252320] py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-center text-3xl font-semibold text-foreground font-heading">{p.pricing.title}</h2>
			<p class="mt-2 text-center text-slate-600 dark:text-slate-400">{p.pricing.packageTitle}</p>

			<div class="mt-12 grid gap-8 lg:grid-cols-2 max-w-4xl mx-auto">
				<!-- Annual card -->
				<div class="rounded-lg border border-slate-200 dark:border-[#3D3A35] bg-white dark:bg-[#252320] p-8 hover:shadow-sm hover:-translate-y-0.5 transition">
					<h3 class="text-xl font-semibold text-foreground font-heading">{p.pricing.annual.title}</h3>
					<div class="mt-6">
						<span class="text-5xl font-bold text-foreground font-heading">{p.pricing.annual.price}</span>
						<span class="ml-2 text-slate-500">{p.pricing.annual.duration}</span>
					</div>
					<p class="mt-2 text-sm text-slate-500">{monthlyNote}</p>
					<ul class="mt-8 space-y-3">
						{p.pricing.annual.features.map((feature) => (
							<li class="flex items-start gap-3">
								<svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
								</svg>
								<span class="text-slate-600 dark:text-slate-400">{feature}</span>
							</li>
						))}
					</ul>
					<a
						href={localePath(locale, '/contact')}
						class="mt-8 block w-full rounded-[8px] bg-primary-600 hover:bg-primary-700 text-white text-center h-12 leading-[3rem] font-heading font-semibold shadow-lg transition-all hover:shadow-xl"
						data-ph-cta="request_quote"
					>
						{quoteLabel}
					</a>
				</div>

				<!-- 3-year card (best value) -->
				<div class="relative rounded-lg border-t-4 border-t-primary-600 border border-slate-200 dark:border-[#3D3A35] bg-white dark:bg-[#252320] p-8 hover:shadow-sm hover:-translate-y-0.5 transition">
					<div class="absolute -top-4 left-1/2 -translate-x-1/2">
						<span class="inline-block rounded-full bg-accent-400 px-4 py-1 text-xs font-bold text-slate-950">
							{locale === 'fr' ? 'Meilleure offre' : 'Best value'}
						</span>
					</div>
					<h3 class="text-xl font-semibold text-foreground font-heading">{p.pricing.triennial.title}</h3>
					<div class="mt-6">
						<span class="text-5xl font-bold text-foreground font-heading">{p.pricing.triennial.price}</span>
						<span class="ml-2 text-slate-500">{p.pricing.triennial.duration}</span>
					</div>
					<p class="mt-2 text-sm font-semibold text-accent-600">{p.pricing.triennial.savings}</p>
					<ul class="mt-8 space-y-3">
						{p.pricing.triennial.features.map((feature) => (
							<li class="flex items-start gap-3">
								<svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
								</svg>
								<span class="text-slate-600 dark:text-slate-400">{feature}</span>
							</li>
						))}
					</ul>
					<a
						href={localePath(locale, '/contact')}
						class="mt-8 block w-full rounded-[8px] bg-primary-600 hover:bg-primary-700 text-white text-center h-12 leading-[3rem] font-heading font-semibold shadow-lg transition-all hover:shadow-xl"
						data-ph-cta="request_quote"
					>
						{quoteLabel}
					</a>
				</div>
			</div>

			<!-- Free trial link below cards -->
			<div class="mt-8 text-center">
				<a
					href="https://dosismart.com"
					target="_blank"
					rel="noopener noreferrer"
					class="text-primary-600 font-heading font-semibold hover:underline"
					data-ph-cta="try_dosismart"
				>
					{trialLabel} &rarr;
				</a>
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════ TRIAL BANNER ═══════════════════════════ -->
	<section class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="rounded-2xl bg-gradient-to-r from-primary/15 via-accent/10 to-emerald-400/10 p-8 md:p-12">
				<h2 class="text-3xl font-semibold text-foreground font-heading">{p.trialBanner.title}</h2>
				<p class="mt-4 max-w-2xl text-base text-slate-600 dark:text-slate-400">
					{p.trialBanner.text}
				</p>
				<a
					href="https://dosismart.com"
					target="_blank"
					rel="noopener noreferrer"
					class="mt-6 inline-flex items-center gap-2 rounded-[8px] bg-primary-600 hover:bg-primary-700 text-white h-12 px-6 font-heading font-semibold shadow-lg transition-all hover:shadow-xl"
					data-ph-cta="try_dosismart"
				>
					{p.trialBanner.button}
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
					</svg>
				</a>
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════ WHAT'S INCLUDED ═══════════════════════════ -->
	<section class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl font-semibold text-foreground font-heading">{p.partE.title}</h2>
			<div class="mt-8 space-y-4">
				{p.partE.items.map((item) => (
					<div class="rounded-lg border border-slate-200 dark:border-[#3D3A35] bg-white dark:bg-[#252320] p-6 flex items-start gap-4">
						<svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
						</svg>
						<p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">{item}</p>
					</div>
				))}
			</div>
			<div class="mt-8 flex flex-wrap gap-4">
				<a
					href={localePath(locale, '/software')}
					class="text-primary-600 font-heading font-semibold hover:underline"
				>
					{p.partE.softwareLink} &rarr;
				</a>
				<a
					href={localePath(locale, '/manuals')}
					class="text-primary-600 font-heading font-semibold hover:underline"
				>
					{p.partE.manualsLink} &rarr;
				</a>
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════ PREREQUISITES ═══════════════════════════ -->
	<section class="bg-[#E8E6E3] dark:bg-[#252320] py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl font-semibold text-foreground font-heading">{p.prerequisites.title}</h2>
			<p class="mt-4 max-w-3xl text-base text-slate-600 dark:text-slate-400 leading-relaxed">
				{p.prerequisites.text}
			</p>
		</div>
	</section>

	<!-- ═══════════════════════════ FAQ ═══════════════════════════ -->
	<section data-ph-section="faq" class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-center text-3xl font-semibold text-foreground font-heading">{p.faq.title}</h2>
			<div class="mx-auto mt-10 max-w-3xl space-y-4">
				{p.faq.questions.map((item) => (
					<details class="group rounded-lg border border-slate-200 dark:border-[#3D3A35] bg-white dark:bg-[#252320]">
						<summary class="flex items-center justify-between p-6 font-heading font-semibold text-foreground">
							<span>{item.question}</span>
							<svg class="faq-chevron h-5 w-5 shrink-0 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
							</svg>
						</summary>
						<div class="px-6 pb-6">
							<p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">{item.answer}</p>
						</div>
					</details>
				))}
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════ CONTACT CTA ═══════════════════════════ -->
	<section class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="rounded-2xl bg-gradient-to-r from-primary/8 via-accent/5 to-emerald-400/5 p-8 md:p-12 text-center">
				<h2 class="text-3xl font-semibold text-foreground font-heading">{p.contact.title}</h2>
				<p class="mx-auto mt-4 max-w-2xl text-slate-600 dark:text-slate-400">
					{p.contact.text}
					<a href="tel:+33689709035" class="font-semibold text-foreground hover:text-primary transition-colors">
						{p.contact.phone}
					</a>
				</p>
				<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
					<a
						href="https://dosismart.com"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center rounded-[8px] bg-primary-600 hover:bg-primary-700 text-white h-12 px-6 font-heading font-semibold shadow-lg transition-all hover:shadow-xl"
						data-ph-cta="try_dosismart"
					>
						{trialLabel}
					</a>
					<a
						href={localePath(locale, '/contact')}
						class="inline-flex items-center rounded-[8px] border-[1.5px] border-border text-foreground h-12 px-6 font-heading font-semibold hover:bg-muted transition-colors"
						data-ph-cta="contact_us"
					>
						{quoteLabel}
					</a>
				</div>
			</div>
		</div>
	</section>

</Layout>
