---
import Layout from '@/layouts/Layout.astro'
import VideoEmbed from '@/components/VideoEmbed.astro'
import { getTranslations, getLocalePaths, type Locale } from '@/i18n/utils'
import { videoIds } from '@/data/videos'
import { organizationSchema } from '@/data/schemas'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)
const v = t.videos
---

<Layout title={t.seo.videos.title} description={t.seo.videos.description} jsonLd={[organizationSchema]}>

	<!-- Hero -->
	<section class="py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl font-extrabold tracking-tight text-foreground font-lato md:text-5xl">
				{v.header.title}
			</h1>
			<p class="mx-auto mt-6 max-w-3xl text-lg text-foreground/70 leading-relaxed">
				{v.header.description}
			</p>
			<a
				href={videoIds.channelUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-8 inline-flex items-center gap-2 rounded-[8px] border border-primary-600 px-6 h-12 font-heading font-semibold text-primary-600 transition-colors hover:bg-primary/10"
				data-ph-cta="subscribe_channel"
			>
				{v.header.button}
				<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
				</svg>
			</a>
		</div>
	</section>

	<!-- Pack Operational -->
	<section class="py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="mb-10 text-3xl font-heading font-semibold text-foreground">
				{v.packTitle}<span class="text-primary">{v.packOpe.name}</span>
			</h2>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{videoIds.packOpe.map((id) => (
					<VideoEmbed videoId={id} title={v.packOpe.label} />
				))}
			</div>
		</div>
	</section>

	<!-- Pack Pedagogical -->
	<section class="bg-[#E8E6E3] dark:bg-[#252320] py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="mb-10 text-3xl font-heading font-semibold text-foreground">
				{v.packTitle}<span class="text-primary">{v.packPeda.name}</span>
			</h2>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{videoIds.packPeda.map((id) => (
					<VideoEmbed videoId={id} title={v.packPeda.label} />
				))}
			</div>
		</div>
	</section>

	<!-- Pack Measurement -->
	<section class="py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="mb-10 text-3xl font-heading font-semibold text-foreground">
				{v.packTitle}<span class="text-primary">{v.packMes.name}</span>
			</h2>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{videoIds.packMes.map((id) => (
					<VideoEmbed videoId={id} title={v.packMes.label} />
				))}
			</div>
		</div>
	</section>

</Layout>
