---
interface StatItem {
	value: string
	label: string
}

interface Props {
	items: StatItem[]
}

const { items } = Astro.props
---

<section id="stats" data-ph-section="stats" class="relative overflow-hidden py-16 md:py-20">
	<div class="absolute inset-0 -z-10" aria-hidden="true">
		<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[500px] w-[800px] rounded-full bg-primary/5 blur-3xl"></div>
	</div>
	<div class="mx-auto max-w-5xl px-6 grid grid-cols-1 sm:grid-cols-3 gap-10 text-center">
		{items.map((item) => (
			<div class="reveal">
				<div
					class="text-5xl md:text-6xl font-heading font-extrabold text-primary tabular-nums"
					data-count-target={item.value}
				>
					{item.value}
				</div>
				<div class="mt-2 text-base text-muted-foreground">
					{item.label}
				</div>
			</div>
		))}
	</div>
</section>

<script>
	function initCountUp() {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue
					const el = entry.target as HTMLElement
					const target = el.dataset.countTarget ?? ''
					const numMatch = target.match(/[\d\s]+/)
					if (!numMatch) {
						el.textContent = target
						observer.unobserve(el)
						continue
					}
					const numStr = numMatch[0].replace(/\s/g, '')
					const targetNum = parseInt(numStr, 10)
					if (isNaN(targetNum)) {
						el.textContent = target
						observer.unobserve(el)
						continue
					}
					const prefix = target.slice(0, target.indexOf(numStr.charAt(0)))
					const suffix = target.slice(target.indexOf(numStr) + numStr.length)
					const duration = 1500
					const startTime = performance.now()

					function animate(now: number) {
						const elapsed = now - startTime
						const progress = Math.min(elapsed / duration, 1)
						const eased = 1 - Math.pow(1 - progress, 3)
						const current = Math.round(eased * targetNum)
						const formatted = current.toLocaleString('fr-FR')
						el.textContent = `${prefix}${formatted}${suffix}`
						if (progress < 1) requestAnimationFrame(animate)
					}

					requestAnimationFrame(animate)
					observer.unobserve(el)
				}
			},
			{ threshold: 0.3 }
		)

		document.querySelectorAll<HTMLElement>('[data-count-target]').forEach((el) => {
			observer.observe(el)
		})
	}

	initCountUp()
	document.addEventListener('astro:page-load', initCountUp)
</script>
