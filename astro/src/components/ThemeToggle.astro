---
/**
 * Theme toggle mirroring the Dosismart app's ModeToggle: an outline icon
 * button (sun/moon with rotate+scale transition) opening a Light/Dark/System
 * menu. Theme is persisted in localStorage ('light' | 'dark' | 'system') and
 * applied as a `dark` class on <html> (no-flash init lives in Layout.astro).
 */
interface Props {
	locale?: 'fr' | 'en'
}

const { locale = 'fr' } = Astro.props
const labels =
	locale === 'fr'
		? { toggle: 'Changer de thème', light: 'Clair', dark: 'Sombre', system: 'Système' }
		: { toggle: 'Toggle theme', light: 'Light', dark: 'Dark', system: 'System' }
---

<div class="relative" data-theme-menu>
	<button
		type="button"
		data-theme-trigger
		aria-haspopup="menu"
		aria-expanded="false"
		aria-label={labels.toggle}
		class="relative inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-background text-foreground transition-colors hover:bg-muted"
	>
		<!-- Sun (visible in light) -->
		<svg class="h-[1.2rem] w-[1.2rem] rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
		</svg>
		<!-- Moon (visible in dark) -->
		<svg class="absolute h-[1.2rem] w-[1.2rem] rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
		</svg>
	</button>

	<div
		data-theme-panel
		role="menu"
		class="absolute right-0 z-50 mt-2 hidden w-32 rounded-md border border-border bg-card p-1 shadow-md"
	>
		<button type="button" role="menuitem" data-set-theme="light" class="block w-full rounded-sm px-2 py-1.5 text-left text-sm text-card-foreground transition-colors hover:bg-muted">{labels.light}</button>
		<button type="button" role="menuitem" data-set-theme="dark" class="block w-full rounded-sm px-2 py-1.5 text-left text-sm text-card-foreground transition-colors hover:bg-muted">{labels.dark}</button>
		<button type="button" role="menuitem" data-set-theme="system" class="block w-full rounded-sm px-2 py-1.5 text-left text-sm text-card-foreground transition-colors hover:bg-muted">{labels.system}</button>
	</div>
</div>

<script>
	function applyTheme(value: string) {
		const dark =
			value === 'dark' ||
			(value === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
		document.documentElement.classList.toggle('dark', dark)
	}

	function closeAllThemePanels() {
		document.querySelectorAll<HTMLElement>('[data-theme-panel]').forEach((p) => p.classList.add('hidden'))
		document.querySelectorAll<HTMLElement>('[data-theme-trigger]').forEach((t) => t.setAttribute('aria-expanded', 'false'))
	}

	function initThemeMenus() {
		document.querySelectorAll<HTMLElement>('[data-theme-menu]').forEach((menu) => {
			if (menu.dataset.init) return
			menu.dataset.init = '1'

			const trigger = menu.querySelector<HTMLButtonElement>('[data-theme-trigger]')
			const panel = menu.querySelector<HTMLElement>('[data-theme-panel]')
			if (!trigger || !panel) return

			trigger.addEventListener('click', (e) => {
				e.stopPropagation()
				const isOpen = !panel.classList.contains('hidden')
				closeAllThemePanels()
				if (!isOpen) {
					panel.classList.remove('hidden')
					trigger.setAttribute('aria-expanded', 'true')
				}
			})

			menu.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((btn) => {
				btn.addEventListener('click', () => {
					const value = btn.dataset.setTheme ?? 'system'
					localStorage.setItem('theme', value)
					applyTheme(value)
					closeAllThemePanels()
				})
			})
		})

		if (!document.documentElement.dataset.themeMenuGlobal) {
			document.documentElement.dataset.themeMenuGlobal = '1'
			document.addEventListener('click', closeAllThemePanels)
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') closeAllThemePanels()
			})
			// Follow OS preference while in "system" mode
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
				const stored = localStorage.getItem('theme')
				if (!stored || stored === 'system') applyTheme('system')
			})
		}
	}

	initThemeMenus()
	document.addEventListener('astro:page-load', initThemeMenus)
</script>
