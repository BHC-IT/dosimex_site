---
import Layout from '@/layouts/Layout.astro'
import { getTranslations, getLocalePaths, localePath, type Locale } from '@/i18n/utils'
import { testimonials } from '@/data/testimonials'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)
---

<Layout title={t.seo.testimonials.title} description={t.seo.testimonials.description}>

	<section class="py-16 lg:py-24">
		<div class="mx-auto max-w-7xl px-6">
			<div class="max-w-3xl">
				<h1 class="text-3xl md:text-4xl font-heading font-bold text-foreground tracking-tight">
					{t.testimonials.header.title}
				</h1>
				<p class="mt-4 text-lg text-muted-foreground">
					{t.testimonials.header.subtitle}
				</p>
				<p class="mt-2 text-sm text-muted-foreground italic">
					{t.testimonials.header.disclaimer}
				</p>
			</div>

			<div class="mt-12 columns-1 md:columns-2 gap-6 space-y-6">
				{testimonials.map((item) => (
					<div class="break-inside-avoid rounded-xl border bg-card p-6 shadow-sm">
						<div class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-primary mb-4" aria-hidden="true">
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
						</div>
						<blockquote>
							<p class="text-sm md:text-base text-foreground italic leading-relaxed">
								{item.text}
							</p>
						</blockquote>
						<div class="mt-4 flex items-center gap-3">
							<div class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-primary font-heading font-bold text-sm">
								{item.name.charAt(0)}
							</div>
							<div>
								<div class="text-sm font-heading font-semibold text-foreground">
									{item.name}
								</div>
								<div class="text-xs text-muted-foreground">
									{item.role ? `${item.role}, ${item.org}` : item.org}
								</div>
							</div>
						</div>
					</div>
				))}
			</div>

			<div class="mt-16 rounded-2xl bg-gradient-to-r from-primary/15 via-accent/10 to-emerald-400/10 p-8 md:p-12 text-center">
				<h2 class="text-2xl md:text-3xl font-heading font-bold text-foreground">
					{t.testimonials.cta.title}
				</h2>
				<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
					<a
						href={localePath(locale, '/contact')}
						class="inline-flex items-center gap-2 h-12 px-6 text-base font-heading font-semibold text-primary-foreground bg-primary hover:bg-primary/90 rounded-lg shadow-lg transition-all duration-150 hover:shadow-xl"
						data-ph-cta="testimonials-quote"
					>
						{t.testimonials.cta.button}
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</a>
					<a
						href="https://dosismart.com"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 h-12 px-6 text-base font-heading font-semibold text-foreground border border-border hover:bg-muted rounded-lg transition-colors duration-150"
						data-ph-cta="testimonials-trial"
					>
						{t.testimonials.cta.trialButton}
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</a>
				</div>
			</div>
		</div>
	</section>

</Layout>
