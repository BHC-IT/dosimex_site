---
import '@/styles/global.css'
import Navbar from '@/components/Navbar.astro'
import Footer from '@/components/Footer.astro'
import BaseHead from '@/components/BaseHead.astro'
import { getTranslations, getLocaleFromUrl } from '@/i18n/utils'

interface Props {
	title: string
	description?: string
	ogImage?: string
	robots?: string
	jsonLd?: Record<string, unknown>[]
}

const locale = getLocaleFromUrl(Astro.url)
const t = getTranslations(locale)
const defaultDescription = locale === 'en'
	? 'Dosimex — Radiation protection calculation tools'
	: 'Dosimex — Outils de calculs radioprotection'
const { title, description = defaultDescription, ogImage, robots, jsonLd } = Astro.props
---

<!doctype html>
<html lang={Astro.currentLocale ?? 'fr'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			id="gfonts"
			href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&family=Nunito:wght@400;600;700;800&display=swap"
			rel="preload"
			as="style"
		/>
		<noscript>
			<link
				href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&family=Nunito:wght@400;600;700;800&display=swap"
				rel="stylesheet"
			/>
		</noscript>
		<script is:inline>
			var f=document.getElementById('gfonts');if(f){f.onload=function(){f.onload=null;f.rel='stylesheet'}}
		</script>
		<title>{title}</title>
		<BaseHead title={title} description={description} ogImage={ogImage} robots={robots} jsonLd={jsonLd} />
		<!-- Dark mode: only activate if user explicitly chose dark -->
		<script is:inline>
			(function() {
				if (localStorage.getItem('theme') === 'dark') {
					document.documentElement.classList.add('dark')
				}
			})()
		</script>
	</head>
	<body class="min-h-screen bg-background text-foreground font-nunito antialiased">
		<!-- Decorative gradient backgrounds -->
		<div aria-hidden="true" class="pointer-events-none fixed inset-0 overflow-hidden -z-10">
			<div class="absolute -top-24 left-1/2 h-[420px] w-[720px] -translate-x-1/2 rounded-full bg-gradient-to-r from-primary/20 via-accent/10 to-emerald-400/5 blur-3xl"></div>
			<div class="absolute -bottom-44 -right-32 h-[420px] w-[420px] rounded-full bg-primary/5 blur-3xl"></div>
		</div>

		<Navbar t={t} locale={locale} />

		<main>
			<slot />
		</main>

		<Footer t={t} locale={locale} />
	</body>
</html>
