---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { getTranslations, getLocalePaths, localePath, type Locale } from '@/i18n/utils'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)

const allPosts = await getCollection('blog', (entry) =>
	entry.id.startsWith(`${locale}/`)
)

const posts = allPosts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)

function slugFromId(id: string): string {
	return id.split('/').slice(1).join('/')
}
---

<Layout title={t.seo.blog.title} description={t.seo.blog.description}>
	<!-- Hero -->
	<section class="relative py-20 lg:py-28">
		<div class="absolute inset-0 -z-10" aria-hidden="true">
			<div class="absolute -bottom-40 -right-[14rem] hidden h-[380px] w-[500px] rounded-full bg-primary/20 blur-3xl dark:bg-primary/10 lg:block"></div>
			<div class="absolute -bottom-56 -right-[18rem] hidden h-[280px] w-[360px] rounded-full bg-brandred/[0.16] blur-3xl dark:bg-brandred/[0.14] lg:block"></div>
		</div>

		<div class="relative mx-auto max-w-7xl px-6">
			<h1 class="max-w-3xl text-balance text-4xl font-heading font-bold tracking-tight text-foreground md:text-5xl">
				Blog
			</h1>
			<p class="mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed">
				{t.seo.blog.description}
			</p>
		</div>
	</section>

	<!-- Posts -->
	<section class="pb-16 md:pb-24">
		<div class="mx-auto max-w-7xl px-6">
			{posts.length === 0 ? (
				<p class="text-muted-foreground">
					{locale === 'fr' ? 'Aucun article pour le moment.' : 'No posts yet.'}
				</p>
			) : (
				<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
					{posts.map((post) => (
						<a
							href={localePath(locale, `/blog/${slugFromId(post.id)}`)}
							class="group block bg-card rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200"
						>
							<time
								datetime={post.data.pubDate.toISOString()}
								class="text-sm text-muted-foreground"
							>
								{post.data.pubDate.toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</time>
							<h2 class="mt-2 text-xl font-heading font-semibold text-foreground line-clamp-2">
								{post.data.title}
							</h2>
							<p class="mt-2 text-base text-muted-foreground line-clamp-3">
								{post.data.description}
							</p>
							{post.data.tags && (
								<div class="mt-4 flex flex-wrap gap-2">
									{post.data.tags.map((tag) => (
										<span class="inline-block text-xs bg-muted text-muted-foreground rounded-full px-2 py-0.5">
											{tag}
										</span>
									))}
								</div>
							)}
							<span class="mt-4 inline-flex items-center gap-1 text-sm text-primary font-heading font-semibold">
								{locale === 'fr' ? 'Lire la suite' : 'Read more'}
								<svg class="w-3 h-3 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path d="M5 12h14M12 5l7 7-7 7" />
								</svg>
							</span>
						</a>
					))}
				</div>
			)}
		</div>
	</section>
</Layout>
