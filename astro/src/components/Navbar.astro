---
import ThemeToggle from './ThemeToggle.astro'
import MobileMenu from './MobileMenu.tsx'
import { localePath, getAlternateUrl, type Translations, type Locale } from '@/i18n/utils'

interface Props {
	t: Translations
	locale: Locale
	alternateUrl?: string
}

const { t, locale, alternateUrl: alternateOverride } = Astro.props
const currentPath = Astro.url.pathname

const navLinks = [
	{ label: t.navbar.items[0], href: localePath(locale, '/software') },
	{ label: t.navbar.items[1], href: localePath(locale, '/product') },
	{ label: t.navbar.items[2], href: localePath(locale, '/training') },
	{ label: t.navbar.items[3], href: localePath(locale, '/about') },
	{ label: t.navbar.items[4], href: localePath(locale, '/contact') },
	{ label: t.navbar.items[5], href: localePath(locale, '/blog') },
]

const alternateUrl = alternateOverride ?? getAlternateUrl(currentPath)
---

<header
	id="site-nav"
	class="sticky top-0 z-50 border-b bg-background/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/60 transition-transform duration-300"
>
	<div class="mx-auto max-w-7xl px-6 flex items-center justify-between h-16">
		<!-- Logo -->
		<a href={localePath(locale, '/')} class="flex-shrink-0">
			<img
				src="/Images/logo_dosimex_new.webp"
				alt={t.altText.logo}
				class="h-7"
				width="140"
				height="28"
			/>
		</a>

		<!-- Desktop nav -->
		<nav class="hidden lg:flex items-center gap-4" aria-label="Main navigation">
			{navLinks.map((link) => (
					<a
						href={link.href}
						class="text-sm font-medium text-foreground/70 transition-colors hover:text-primary"
					>
						{link.label}
					</a>
			))}
		</nav>

		<!-- Right cluster -->
		<div class="hidden lg:flex items-center gap-4">
			<!-- Language toggle -->
			<a
				href={alternateUrl}
				class="rounded-md px-2 py-1 text-xs font-bold text-foreground/60 transition-colors hover:text-foreground border border-border"
				aria-label={locale === 'fr' ? 'Switch to English' : 'Passer en français'}
			>
				{locale === 'fr' ? 'EN' : 'FR'}
			</a>

			<ThemeToggle />

			<!-- CTA: Quote -->
			<a
				href={localePath(locale, '/product')}
				class="rounded-lg border border-primary px-4 py-2 text-sm font-semibold text-primary transition-colors hover:bg-primary/10"
				data-ph-cta="nav-quote"
			>
				{locale === 'en' ? 'Request a quote' : 'Demander un devis'}
			</a>

			<!-- CTA: Trial -->
			<a
				href="https://dosismart.com"
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
				data-ph-cta="nav-trial"
			>
				{t.navbar.button}
			</a>
		</div>

		<!-- Mobile: trial + hamburger -->
		<div class="flex lg:hidden items-center gap-3">
			<a
				href="https://dosismart.com"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center h-8 px-3 text-sm font-semibold font-heading text-white bg-primary-600 hover:bg-primary-700 rounded-[8px] transition-colors duration-150"
				data-ph-cta="nav-trial-mobile"
			>
				{locale === 'en' ? 'Trial' : 'Essai'}
			</a>
			<MobileMenu
				client:media="(max-width: 1023px)"
				navLinks={navLinks.map((l) => ({ label: l.label, href: l.href }))}
				alternateUrl={alternateUrl}
				locale={locale}
			/>
		</div>
	</div>
</header>

<script>
	function initNavScroll() {
		const nav = document.getElementById('site-nav')
		if (!nav) return

		let lastScrollY = 0
		const threshold = 10

		window.addEventListener('scroll', () => {
			const currentY = window.scrollY
			if (currentY < threshold) {
				nav.classList.remove('nav-hidden')
				nav.classList.add('nav-visible')
			} else if (currentY > lastScrollY + threshold) {
				nav.classList.add('nav-hidden')
				nav.classList.remove('nav-visible')
			} else if (currentY < lastScrollY - threshold) {
				nav.classList.remove('nav-hidden')
				nav.classList.add('nav-visible')
			}
			lastScrollY = currentY
		}, { passive: true })
	}

	initNavScroll()
	document.addEventListener('astro:page-load', initNavScroll)
</script>
