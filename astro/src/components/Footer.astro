---
interface Props {
	t: Record<string, any>
	locale: string
}

const { t, locale } = Astro.props

const resourceLinks = [
	{ label: t.footer.col2.p[0], href: 'https://dosismart.com', external: true },
	{ label: t.footer.col2.p[1], href: locale === 'en' ? '/en/videos' : '/videos' },
	{ label: t.footer.col2.p[2], href: locale === 'en' ? '/en/manuals' : '/manuals' },
	{ label: t.footer.col2.p[3], href: locale === 'en' ? '/en/books' : '/books' },
]

const companyLinks = [
	{ label: t.footer.col3.p[0], href: locale === 'en' ? '/en/about' : '/about' },
	{ label: t.footer.col3.p[1], href: '/Folders/Informations_légales.pdf' },
	{ label: t.footer.col3.p[2], href: locale === 'en' ? '/en/contact' : '/contact' },
]
---

<footer class="mt-20 border-t bg-foreground py-12 text-background/70">
	<div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 md:grid-cols-3 lg:px-8">
		<!-- Company info -->
		<div>
			<a href={locale === 'en' ? '/en/' : '/'} class="inline-block">
				<span class="text-lg font-bold text-background font-lato">DOSIMEX</span>
			</a>
			<p class="mt-3 text-sm">{t.footer.col1.p[0]}</p>
			<p class="text-sm">{t.footer.col1.p[1]}</p>
			<p class="mt-3 text-sm font-medium text-background">{t.footer.col1.p[2]}</p>
			<p class="mt-3 text-sm">{t.footer.col1.p[3]}</p>
			<!-- Social icons -->
			<div class="mt-2 flex gap-4">
				<a
					href="https://www.youtube.com/channel/UCmijJyGaFfJte4xsTk90MVA"
					target="_blank"
					rel="noopener noreferrer"
					class="text-background/60 transition-colors hover:text-background"
					aria-label="YouTube"
				>
					<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
						<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
					</svg>
				</a>
				<a
					href="https://www.linkedin.com/company/dosimex/"
					target="_blank"
					rel="noopener noreferrer"
					class="text-background/60 transition-colors hover:text-background"
					aria-label="LinkedIn"
				>
					<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
				</a>
			</div>
		</div>

		<!-- Resources -->
		<div>
			<h3 class="font-semibold text-background">{t.footer.col2.title}</h3>
			<ul class="mt-3 space-y-2 text-sm">
				{resourceLinks.map((link) => (
					<li>
						<a
							href={link.href}
							class="transition-colors hover:text-background"
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noopener noreferrer' : undefined}
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</div>

		<!-- Company -->
		<div>
			<h3 class="font-semibold text-background">{t.footer.col3.title}</h3>
			<ul class="mt-3 space-y-2 text-sm">
				{companyLinks.map((link) => (
					<li>
						<a href={link.href} class="transition-colors hover:text-background">
							{link.label}
						</a>
					</li>
				))}
				<li>
					<button
						type="button"
						data-cc="show-preferencesModal"
						class="transition-colors hover:text-background cursor-pointer"
					>
						{t.footer.manageCookies}
					</button>
				</li>
			</ul>
		</div>
	</div>
</footer>
