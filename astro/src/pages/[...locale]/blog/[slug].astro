---
import { getCollection, render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { localePath, type Locale } from '@/i18n/utils'

export async function getStaticPaths() {
	const posts = await getCollection('blog')
	const postIds = new Set(posts.map((p) => p.id))

	return posts.map((post) => {
		const [postLocale, ...slugParts] = post.id.split('/')
		const slug = slugParts.join('/')
		const otherLocale = postLocale === 'fr' ? 'en' : 'fr'
		const otherExists = postIds.has(`${otherLocale}/${slug}`)
		const alternateUrl = otherExists
			? (otherLocale === 'fr' ? `/blog/${slug}` : `/en/blog/${slug}`)
			: (otherLocale === 'fr' ? '/blog' : '/en/blog')

		return {
			params: {
				locale: postLocale === 'fr' ? undefined : postLocale,
				slug,
			},
			props: { post, locale: postLocale as Locale, alternateUrl },
		}
	})
}

type BlogEntry = Awaited<ReturnType<typeof getCollection<'blog'>>>[number]

interface Props {
	post: BlogEntry
	locale: Locale
	alternateUrl: string
}

const { post, locale, alternateUrl } = Astro.props
const { Content } = await render(post)

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.pubDate.toISOString(),
	...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
	author: {
		'@type': 'Person',
		name: post.data.author,
	},
	publisher: {
		'@type': 'Organization',
		name: 'Dosimex',
		url: 'https://dosimex.fr',
	},
}
---

<Layout
	title={`${post.data.title} — Dosimex`}
	description={post.data.description}
	jsonLd={[jsonLd]}
	alternateUrl={alternateUrl}
>
	<article class="py-12 md:py-20">
		<div class="mx-auto max-w-3xl px-6">
			<!-- Breadcrumb -->
			<nav class="mb-8 text-sm text-muted-foreground">
				<a href={localePath(locale, '/blog')} class="hover:text-primary transition-colors">
					Blog
				</a>
				<span class="mx-2">/</span>
				<span class="text-foreground">{post.data.title}</span>
			</nav>

			<!-- Header -->
			<header class="mb-8">
				<time
					datetime={post.data.pubDate.toISOString()}
					class="text-sm text-muted-foreground"
				>
					{post.data.pubDate.toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', {
						year: 'numeric',
						month: 'long',
						day: 'numeric',
					})}
				</time>
				<h1 class="mt-2 text-3xl md:text-4xl font-heading font-bold text-foreground tracking-tight">
					{post.data.title}
				</h1>
				<p class="mt-4 text-lg text-muted-foreground">
					{post.data.description}
				</p>
				{post.data.tags && (
					<div class="mt-4 flex flex-wrap gap-2">
						{post.data.tags.map((tag) => (
							<span class="inline-block text-xs bg-muted text-muted-foreground rounded-full px-2 py-0.5">
								{tag}
							</span>
						))}
					</div>
				)}
			</header>

			<!-- Markdown content -->
			<div class="prose dark:prose-invert max-w-none">
				<Content />
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl bg-gradient-to-r from-primary/15 via-accent/10 to-emerald-400/10 p-8 md:p-10 text-center">
				<h2 class="text-2xl font-heading font-semibold text-foreground">
					{locale === 'fr' ? 'Découvrez nos outils de radioprotection' : 'Discover our radiation protection tools'}
				</h2>
				<p class="mx-auto mt-3 max-w-xl text-base text-muted-foreground">
					{locale === 'fr'
						? '17 codes de calcul validés MCNP, disponibles en licence annuelle.'
						: '17 MCNP-validated calculation codes, available as an annual license.'}
				</p>
				<a
					href={localePath(locale, '/product')}
					class="mt-6 inline-flex items-center gap-2 rounded-[8px] bg-primary-600 hover:bg-primary-700 text-white h-12 px-6 font-heading font-semibold shadow-lg transition-all hover:shadow-xl"
					data-ph-cta="blog-product"
				>
					{locale === 'fr' ? "Découvrir l'offre" : 'See our offer'}
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>

			<!-- Back link -->
			<div class="mt-8 pt-8 border-t">
				<a
					href={localePath(locale, '/blog')}
					class="inline-flex items-center gap-2 text-primary font-heading font-semibold hover:underline"
				>
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path d="M19 12H5M12 19l-7-7 7-7" />
					</svg>
					{locale === 'fr' ? 'Retour au blog' : 'Back to blog'}
				</a>
			</div>
		</div>
	</article>
</Layout>
