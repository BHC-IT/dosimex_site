---
import Layout from '@/layouts/Layout.astro'
import { getTranslations } from '@/i18n/utils'
import { manualPdfs } from '@/data/videos'
import { organizationSchema } from '@/data/schemas'

const t = getTranslations('fr')
const m = t.manuals

const anchorIds = ['manuals', 'validations', 'internships'] as const
---

<Layout title={t.seo.manuals.title} description={t.seo.manuals.description} jsonLd={[organizationSchema]}>

	<!-- Header -->
	<section class="py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl font-extrabold tracking-tight text-foreground font-lato md:text-5xl">
				{m.header.title}
			</h1>
			<p class="mx-auto mt-6 max-w-3xl text-lg text-foreground/70 leading-relaxed">
				{m.header.description}
			</p>
			<div class="mt-8 flex flex-wrap justify-center gap-4">
				{m.header.anchors.map((label, i) => (
					<a
						href={`#${anchorIds[i]}`}
						class="rounded-full border border-border px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted/20"
					>
						{label}
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Manuals section -->
	<section id="manuals" class="py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-2xl font-bold font-lato text-foreground">{m.manuals.title}</h2>
			<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				{m.manuals.items.map((name, i) => (
					<a
						href={manualPdfs.manuals[i]}
						target="_blank"
						rel="noopener noreferrer"
						class="group rounded-xl border bg-card p-6 shadow-sm transition-shadow hover:shadow-md text-center"
					>
						<svg class="mx-auto h-10 w-10 text-primary transition-colors group-hover:text-primary/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
						</svg>
						<p class="mt-4 text-sm font-medium text-foreground">{name}</p>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Validations section -->
	<section id="validations" class="bg-muted/10 py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-2xl font-bold font-lato text-foreground">{m.validations.title}</h2>
			<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-5">
				{m.validations.items.map((name, i) => (
					<a
						href={manualPdfs.validations[i]}
						target="_blank"
						rel="noopener noreferrer"
						class="group rounded-xl border bg-card p-6 shadow-sm transition-shadow hover:shadow-md text-center"
					>
						<svg class="mx-auto h-10 w-10 text-primary transition-colors group-hover:text-primary/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
						</svg>
						<p class="mt-4 text-sm font-medium text-foreground">{name}</p>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Internships section -->
	<section id="internships" class="py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-2xl font-bold font-lato text-foreground">{m.internships.title}</h2>
			<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				{m.internships.items.map((name, i) => (
					<a
						href={manualPdfs.internships[i]}
						target="_blank"
						rel="noopener noreferrer"
						class="group rounded-xl border bg-card p-6 shadow-sm transition-shadow hover:shadow-md text-center"
					>
						<svg class="mx-auto h-10 w-10 text-primary transition-colors group-hover:text-primary/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
						</svg>
						<p class="mt-4 text-sm font-medium text-foreground">{name}</p>
					</a>
				))}
			</div>
		</div>
	</section>

</Layout>
