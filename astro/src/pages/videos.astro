---
import Layout from '@/layouts/Layout.astro'
import VideoEmbed from '@/components/VideoEmbed.astro'
import { getTranslations } from '@/i18n/utils'
import { videoIds } from '@/data/videos'

const t = getTranslations('fr')
const v = t.videos
---

<Layout title={`${v.header.title} — Dosimex`} description={v.header.description}>

	<!-- Header -->
	<section class="py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl font-extrabold tracking-tight text-foreground font-lato md:text-5xl">
				{v.header.title}
			</h1>
			<p class="mx-auto mt-6 max-w-3xl text-lg text-foreground/70 leading-relaxed">
				{v.header.description}
			</p>
			<a
				href={videoIds.channelUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-8 inline-flex items-center gap-2 rounded-lg border border-primary px-6 py-3 font-semibold text-primary transition-colors hover:bg-primary/10"
			>
				{v.header.button}
				<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
				</svg>
			</a>
		</div>
	</section>

	<!-- Pack Operational -->
	<section class="py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="mb-10 text-3xl font-bold text-foreground font-lato">
				{v.packTitle}<span class="text-primary">{v.packOpe.name}</span>
			</h2>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
				{videoIds.packOpe.map((id) => (
					<VideoEmbed videoId={id} title={v.packOpe.label} />
				))}
			</div>
		</div>
	</section>

	<!-- Pack Pedagogical -->
	<section class="bg-muted/10 py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="mb-10 text-3xl font-bold text-foreground font-lato">
				{v.packTitle}<span class="text-primary">{v.packPeda.name}</span>
			</h2>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
				{videoIds.packPeda.map((id) => (
					<VideoEmbed videoId={id} title={v.packPeda.label} />
				))}
			</div>
		</div>
	</section>

	<!-- Pack Measurement -->
	<section class="py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="mb-10 text-3xl font-bold text-foreground font-lato">
				{v.packTitle}<span class="text-primary">{v.packMes.name}</span>
			</h2>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
				{videoIds.packMes.map((id) => (
					<VideoEmbed videoId={id} title={v.packMes.label} />
				))}
			</div>
		</div>
	</section>

</Layout>
