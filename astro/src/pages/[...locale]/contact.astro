---
import Layout from '@/layouts/Layout.astro'
import ContactForm from '@/components/ContactForm.tsx'
import ObfuscatedEmail from '@/components/ObfuscatedEmail.astro'
import { getTranslations, getLocalePaths, type Locale } from '@/i18n/utils'
import { organizationSchema } from '@/data/schemas'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)
---

<Layout title={t.seo.contact.title} description={t.seo.contact.description} jsonLd={[organizationSchema]}>

	<!-- Hero -->
	<section class="relative py-20 lg:py-28">
		<div class="absolute inset-0 -z-10" aria-hidden="true">
			<div class="absolute -bottom-40 -right-[14rem] h-[380px] w-[500px] rounded-full bg-primary/20 blur-3xl dark:bg-primary/10"></div>
			<div class="absolute -bottom-56 -right-[18rem] h-[280px] w-[360px] rounded-full bg-brandred/[0.16] blur-3xl dark:bg-brandred/[0.14]"></div>
		</div>

		<div class="relative mx-auto max-w-7xl px-6">
			<h1 class="max-w-3xl text-balance text-4xl font-heading font-bold tracking-tight text-foreground md:text-5xl">
				{t.contact.header.title}
			</h1>
			<p class="mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed">
				{t.contact.header.subtitle}
			</p>
		</div>
	</section>

	<!-- Two-column layout -->
	<section class="pb-16 md:pb-24">
		<div class="mx-auto max-w-7xl px-6">
			<div class="grid gap-12 lg:grid-cols-12">

				<!-- Left: Contact Form -->
				<div class="lg:col-span-7">
					<ContactForm
						client:idle
						locale={locale}
						labels={t.contactForm.labels}
						errors={t.contactForm.errors}
						buttonText={t.contactForm.button}
						sendingText={t.contactForm.sending}
						successText={t.contactForm.messageSent}
						errorText={t.contactForm.messageNotSent}
					/>
				</div>

				<!-- Right: Trust sidebar -->
				<div class="lg:col-span-5">
					<div class="rounded-2xl bg-card p-8 shadow-sm sticky top-8">
						<h2 class="text-xl font-heading font-semibold text-foreground">
							{t.contactForm.title}
						</h2>

						<!-- Contact info items -->
						<div class="mt-6 space-y-5">
							<div class="flex items-start gap-4">
								<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10">
									<svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
									</svg>
								</div>
								<div>
									<p class="text-sm font-medium text-foreground">{t.contact.info.phone.label}</p>
									<p class="text-sm text-foreground/70">
										<a href="tel:+33689709035" class="hover:text-primary transition-colors">{t.contact.info.phone.value}</a>
									</p>
								</div>
							</div>

							<div class="flex items-start gap-4">
								<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10">
									<svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
									</svg>
								</div>
								<div>
									<p class="text-sm font-medium text-foreground">{t.contact.info.email.label}</p>
									<p class="text-sm text-foreground/70">
										<ObfuscatedEmail user="alain.vivier" domain="dosimex.fr" class="hover:text-primary transition-colors" />
									</p>
								</div>
							</div>

							<div class="flex items-start gap-4">
								<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10">
									<svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
									</svg>
								</div>
								<div>
									<p class="text-sm font-medium text-foreground">{t.contact.info.demo.label}</p>
									<p class="text-sm text-foreground/70">{t.contact.info.demo.value}</p>
								</div>
							</div>
						</div>

						<!-- Stats -->
						<div class="mt-10 grid grid-cols-2 gap-4">
							{t.home.numbers.items.slice(0, 2).map((stat) => (
								<div class="text-center">
									<p class="text-2xl font-heading font-bold text-primary">{stat.value}</p>
									<p class="mt-1 text-xs text-foreground/60">{stat.label}</p>
								</div>
							))}
						</div>
					</div>
				</div>

			</div>
		</div>
	</section>

</Layout>
