---
import { Image } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import VideoEmbed from '@/components/VideoEmbed.astro'
import StatsCounter from '@/components/StatsCounter.astro'
import HeroCarousel from '@/components/HeroCarousel.astro'
import { getTranslations, getLocalePaths, localePath, type Locale } from '@/i18n/utils'
import { partnerLogos, partnerLogoAlts, videoIds } from '@/data/videos'
import { organizationSchema, websiteSchema } from '@/data/schemas'
import heroImg from '@/assets/images/home_header_carousel.png'

const heroSlides = [
	{ src: '/Images/ScreenCarousel2.webp', srcSm: '/Images/ScreenCarousel2-sm.webp', alt: 'DOSIMEX-GX — Générateur X', label: 'DOSIMEX-GX — Générateur X', width: 1280, height: 675 },
	{ src: '/Images/ScreenCarousel3.webp', srcSm: '/Images/ScreenCarousel3-sm.webp', alt: 'DOSIMEX-GX — Source cylindrique', label: 'DOSIMEX-GX — Source cylindrique', width: 1280, height: 783 },
	{ src: '/Images/ScreenCarousel1.webp', srcSm: '/Images/ScreenCarousel1-sm.webp', alt: 'DOSIMEX-B — Dose bêta', label: 'DOSIMEX-B — Dose bêta', width: 1280, height: 727 },
	{ src: '/Images/ScreenCarousel4.webp', srcSm: '/Images/ScreenCarousel4-sm.webp', alt: 'DOSIMEX-N — Dose neutrons', label: 'DOSIMEX-N — Dose neutrons', width: 1280, height: 638 },
	{ src: '/Images/dosismart-screenshot.webp', srcSm: '/Images/dosismart-screenshot-sm.webp', alt: 'Dosismart — Calcul gamma dans le navigateur', label: 'Dosismart — Application web', width: 1280, height: 761 },
]

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)

const partnerGlob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logo_partenaires/*.webp', { eager: true })
const partnerImages = partnerLogos.map((filename) => {
	const match = Object.entries(partnerGlob).find(([path]) => path.endsWith(`/${filename}`))
	return match![1].default
})

const offerCards = [
	{ ...t.home.offers.card1, href: localePath(locale, '/software'), icon: 'calculator' as const },
	{ ...t.home.offers.card2, href: 'https://dosismart.com', icon: 'globe' as const, external: true },
	{ ...t.home.offers.card3, href: localePath(locale, '/training'), icon: 'graduation' as const },
]

const packs = [
	{ id: 'ope', label: t.software.packOpe.title, description: t.software.packOpe.description, tools: t.software.packOpe.tools },
	{ id: 'peda', label: t.software.packPeda.title, description: t.software.packPeda.description, tools: t.software.packPeda.tools },
	{ id: 'mes', label: t.software.packMes.title, description: t.software.packMes.description, tools: t.software.packMes.tools },
]

const refsWithMeta = t.home.references.items
---

<Layout title={t.seo.home.title} description={t.seo.home.description} jsonLd={[organizationSchema, websiteSchema(locale)]}>

	<!-- ══════════ HERO ══════════ -->
	<section id="hero" data-ph-section="hero" class="relative overflow-hidden py-16 lg:py-32">
		<div class="absolute -top-24 right-0 h-[400px] w-[600px] rounded-full bg-primary/5 blur-3xl" aria-hidden="true"></div>
		<div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-12 gap-12 items-center relative">
			<div class="lg:col-span-7">
				<a href="https://dosismart.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mb-4 rounded-full bg-primary/10 text-primary px-4 py-1.5 text-sm font-heading font-semibold hover:bg-primary/15 transition-colors">
					{t.home.hero.badge}
				</a>
				<h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-foreground tracking-tight">
					{t.home.hero.title}
				</h1>
				<p class="mt-6 text-lg text-muted-foreground max-w-xl">
					{t.home.hero.subtitle}
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-4">
					<a
						href={localePath(locale, '/product')}
						class="inline-flex items-center gap-2 h-12 px-6 text-base font-heading font-semibold text-primary-foreground bg-primary hover:bg-primary/90 rounded-lg shadow-lg transition-all duration-150 hover:shadow-xl"
						data-ph-cta="hero-trial"
					>
						{t.home.hero.trialButton}
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</a>
					<a
						href={localePath(locale, '/software')}
						class="inline-flex items-center gap-2 h-12 px-6 text-base font-heading font-semibold text-foreground border border-border hover:bg-muted rounded-lg transition-colors duration-150"
						data-ph-cta="hero-tools"
					>
						{t.home.hero.cta}
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</a>
				</div>
				<p class="mt-4 text-sm text-muted-foreground">
					{t.home.hero.priceNote}
				</p>
			</div>
			<div class="lg:col-span-5">
				<HeroCarousel slides={heroSlides} />
			</div>
		</div>
	</section>

	<!-- ══════════ PARTNER LOGOS ══════════ -->
	<section id="partners" data-ph-section="partners" class="border-y bg-muted/40 py-12">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="mb-8 text-center text-sm font-semibold uppercase tracking-widest text-muted-foreground">
				{locale === 'fr' ? 'Ils nous font confiance' : 'Trusted by'}
			</h2>
			<div class="relative overflow-hidden">
				<div class="partner-scroll flex items-center gap-12">
					{[...partnerImages, ...partnerImages].map((img, i) => (
						<Image
							src={img}
							alt={partnerLogoAlts[i % partnerImages.length]}
							height={48}
							width={120}
							class="h-10 w-auto shrink-0 object-contain opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0 sm:h-12"
							loading="lazy"
						/>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- ══════════ PRODUCT OVERVIEW CARDS ══════════ -->
	<section id="offers" data-ph-section="offers" class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-6">
			<div class="text-center max-w-2xl mx-auto">
				<h2 class="text-2xl md:text-3xl font-heading font-semibold text-foreground">
					{t.home.offers.title}
				</h2>
				<p class="mt-4 text-base text-muted-foreground">
					{t.home.offers.description}
				</p>
			</div>

			<div class="mt-12 grid gap-8 lg:grid-cols-3">
				{offerCards.map((card) => (
					<a
						href={card.href}
						target={'external' in card ? '_blank' : undefined}
						rel={'external' in card ? 'noopener noreferrer' : undefined}
						class="group block bg-card border border-border rounded-xl p-8 hover:shadow-md hover:-translate-y-1 transition-all duration-200"
					>
						<div class="flex h-14 w-14 items-center justify-center rounded-lg bg-primary/10 text-primary mb-4">
							{card.icon === 'calculator' && (
								<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><line x1="16" x2="16" y1="10" y2="10"/><line x1="12" x2="12" y1="10" y2="10"/><line x1="8" x2="8" y1="10" y2="10"/><line x1="12" x2="12" y1="14" y2="14"/><line x1="8" x2="8" y1="14" y2="14"/><line x1="12" x2="12" y1="18" y2="18"/><line x1="8" x2="8" y1="18" y2="18"/></svg>
							)}
							{card.icon === 'globe' && (
								<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
							)}
							{card.icon === 'graduation' && (
								<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>
							)}
						</div>
						<h3 class="text-xl font-heading font-semibold text-foreground">{card.title}</h3>
						<p class="mt-3 text-base text-muted-foreground">{card.description}</p>
						<span class="mt-5 inline-flex items-center gap-1 text-primary font-heading font-semibold">
							{card.linkLabel} <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
						</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ DOSISMART BANNER ══════════ -->
	<section id="dosismart" data-ph-section="dosismart" class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-6">
			<div class="relative overflow-hidden rounded-2xl bg-muted/40 p-8 md:p-12">
				<div class="absolute -top-20 -right-20 h-[400px] w-[400px] rounded-full bg-primary/5 blur-3xl" aria-hidden="true"></div>
				<div class="relative grid lg:grid-cols-2 gap-12 items-center">
					<div class="order-2 lg:order-1" data-lightbox>
						<img
							src="/Images/dosismart-screenshot.webp"
							srcset="/Images/dosismart-screenshot-sm.webp 640w, /Images/dosismart-screenshot.webp 1280w"
							sizes="(max-width: 1024px) 100vw, 640px"
							alt="Dosismart — Calcul gamma dans le navigateur"
							width="1280"
							height="761"
							class="w-full rounded-xl"
							loading="lazy"
						/>
					</div>
					<div class="order-1 lg:order-2">
						<h2 class="text-2xl md:text-3xl font-heading font-semibold text-foreground">
							{t.home.dosismart.title}
						</h2>
						<p class="mt-4 text-base text-muted-foreground max-w-lg">
							{t.home.dosismart.text}
						</p>
						<div class="mt-4 space-y-1">
							<p class="text-sm font-heading font-semibold text-foreground">
								<span class="inline-block w-2 h-2 rounded-full bg-success mr-2"></span>{t.home.dosismart.available}
							</p>
							<p class="text-sm font-heading text-muted-foreground">
								<span class="inline-block w-2 h-2 rounded-full bg-accent-400 mr-2"></span>{t.home.dosismart.coming}
							</p>
						</div>
						<a
							href="https://dosismart.com"
							target="_blank"
							rel="noopener noreferrer"
							class="mt-6 inline-flex items-center gap-2 h-12 px-6 text-base font-heading font-semibold text-primary-foreground bg-primary hover:bg-primary/90 rounded-lg shadow-lg transition-all duration-150 hover:shadow-xl"
							data-ph-cta="dosismart-trial"
						>
							{t.home.dosismart.button}
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ══════════ STATS COUNTER ══════════ -->
	<StatsCounter items={t.home.numbers.items} />

	<!-- ══════════ TOOL PACKS PREVIEW ══════════ -->
	<section id="packs" data-ph-section="packs" class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-6">
			<h2 class="text-2xl md:text-3xl font-heading font-semibold text-foreground">
				{t.home.packs.title}
			</h2>
			<p class="mt-2 text-base text-muted-foreground max-w-2xl">
				{t.home.packs.subtitle}
			</p>

			<!-- Tabs -->
			<div class="mt-8">
				<div class="flex border-b border-border gap-0" role="tablist" aria-label="Tool packs">
					{packs.map((pack, i) => (
						<button
							type="button"
							role="tab"
							id={`tab-${pack.id}`}
							aria-selected={i === 0 ? 'true' : 'false'}
							aria-controls={`panel-${pack.id}`}
							class:list={[
								'px-4 py-3 text-sm font-heading font-medium border-b-[3px] transition-colors duration-150 -mb-px cursor-pointer',
								i === 0
									? 'border-primary-600 text-foreground'
									: 'border-transparent text-muted-foreground hover:text-foreground',
							]}
						>
							{pack.label}
						</button>
					))}
				</div>

				{packs.map((pack, i) => (
					<div
						role="tabpanel"
						id={`panel-${pack.id}`}
						aria-labelledby={`tab-${pack.id}`}
						class:list={['mt-8', i !== 0 && 'hidden']}
					>
						<p class="text-base text-muted-foreground mb-6 max-w-2xl">{pack.description}</p>
						<div class="flex flex-wrap gap-2">
							{pack.tools.map((tool) => (
								<span class="inline-block text-sm bg-muted text-foreground rounded-lg px-3 py-1">
									{tool.name}
								</span>
							))}
						</div>
						<a
							href={localePath(locale, '/software')}
							class="mt-6 inline-flex items-center gap-1 text-primary font-heading font-semibold hover:underline"
						>
							{t.home.packs.allTools} <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
						</a>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ TESTIMONIAL ══════════ -->
	<section id="testimonial" data-ph-section="testimonial" class="py-12 md:py-20">
		<div class="mx-auto max-w-2xl px-6">
			<div class="relative rounded-2xl border bg-card p-6 shadow-sm md:p-8">
				<!-- Quote icon -->
				<div class="absolute -top-4 left-8 flex h-10 w-10 items-center justify-center rounded-full bg-primary-600 text-white" aria-hidden="true">
					<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
				</div>
				<blockquote class="mt-4">
					<p class="text-base md:text-lg text-foreground italic leading-relaxed">
						{t.home.opinion.text}
					</p>
				</blockquote>
				<div class="mt-6 flex items-center gap-3">
					<div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-primary font-heading font-bold text-lg">
						{t.home.opinion.name.charAt(0)}
					</div>
					<div>
						<div class="text-base font-heading font-semibold text-foreground">
							{t.home.opinion.name}
						</div>
						<div class="text-sm text-muted-foreground">
							{t.home.opinion.job}
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="mt-6 text-center">
			<a href={localePath(locale, "/testimonials")} class="inline-flex items-center gap-1 text-primary font-heading font-semibold hover:underline">
				{t.home.opinion.button} <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
			</a>
		</div>
	</section>

	<!-- ══════════ VIDEO ══════════ -->
	<section id="video" data-ph-section="video" class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-6">
			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<div>
					<VideoEmbed videoId={videoIds.presentation} title={t.home.videoTitle} />
				</div>
				<div>
					<h2 class="text-2xl md:text-3xl font-heading font-semibold text-foreground mb-4">
						{t.home.videoTitle}
					</h2>
					<p class="text-base text-muted-foreground mb-6">
						{locale === 'fr'
							? 'Découvrez DOSIMEX en vidéo : présentation des outils, tutoriels et cas pratiques.'
							: 'Discover DOSIMEX in video: tool presentations, tutorials and practical cases.'}
					</p>
					<a href={localePath(locale, '/videos')} class="inline-flex items-center gap-1 text-primary font-heading font-semibold hover:underline">
						{t.home.videos.button} <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ══════════ REFERENCES ══════════ -->
	<section id="references" data-ph-section="references" class="py-12 md:py-20 border-t">
		<div class="mx-auto max-w-7xl px-6">
			<h2 class="text-2xl font-heading font-semibold text-foreground mb-2">
				{t.home.references.title}
			</h2>
			<p class="text-base text-muted-foreground mb-8 max-w-2xl">
				{t.home.references.subtitle}
			</p>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{refsWithMeta.map((item) => (
					<a
						href={item.url}
						target="_blank"
						rel="noopener noreferrer"
						class="group block border border-border bg-card rounded-xl p-6 hover:shadow-md hover:-translate-y-1 transition-all duration-200"
					>
						<h3 class="text-sm font-heading font-semibold text-foreground line-clamp-2">
							{item.title}
						</h3>
						{'description' in item && (
							<p class="mt-2 text-sm text-muted-foreground line-clamp-3">
								{item.description}
							</p>
						)}
						<div class="mt-3 flex flex-wrap gap-2">
							{'authors' in item && (
								<span class="inline-block text-xs bg-muted text-muted-foreground rounded-full px-2 py-0.5">
									{item.authors}
								</span>
							)}
							{'year' in item && (
								<span class="inline-block text-xs bg-muted text-muted-foreground rounded-full px-2 py-0.5">
									{item.year}
								</span>
							)}
							{'journal' in item && (
								<span class="inline-block text-xs bg-muted text-muted-foreground rounded-full px-2 py-0.5 italic">
									{item.journal}
								</span>
							)}
						</div>
						<span class="mt-4 inline-flex items-center gap-1 text-sm text-primary font-heading font-semibold">
							{t.home.references.btnText} <svg class="w-3 h-3 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
						</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ CTA CLOSE ══════════ -->
	<section id="cta-close" data-ph-section="cta-close" class="py-16 md:py-24">
		<div class="mx-auto max-w-4xl px-6">
			<div class="rounded-2xl bg-gradient-to-r from-primary/15 via-accent/10 to-emerald-400/10 p-8 md:p-12 text-center">
				<h2 class="text-2xl md:text-3xl font-heading font-bold text-foreground">
					{t.home.close.title}
				</h2>
				<p class="mt-4 text-lg text-muted-foreground">
					{t.home.close.price} &mdash; {t.home.close.includes}
				</p>
				<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
					<a
						href={localePath(locale, '/contact')}
						class="inline-flex items-center gap-2 h-12 px-6 text-base font-heading font-semibold text-primary-foreground bg-primary hover:bg-primary/90 rounded-lg shadow-lg transition-all duration-150 hover:shadow-xl"
						data-ph-cta="close-quote"
					>
						{t.home.close.quoteButton}
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</a>
					<a
						href="https://dosismart.com"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 h-12 px-6 text-base font-heading font-semibold text-foreground border border-border hover:bg-muted rounded-lg transition-colors duration-150"
						data-ph-cta="close-trial"
					>
						{t.home.close.trialButton}
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</a>
				</div>
				<p class="mt-4 text-sm text-muted-foreground">
					{t.home.close.dosismartNote}
				</p>
			</div>
		</div>
	</section>

</Layout>

<!-- Tab switching script -->
<script>
	function initTabs() {
		const tabs = document.querySelectorAll<HTMLButtonElement>('[role="tab"]')
		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const panelId = tab.getAttribute('aria-controls')
				if (!panelId) return

				tabs.forEach((t) => {
					t.setAttribute('aria-selected', 'false')
					t.classList.remove('border-primary-600', 'text-foreground')
					t.classList.add('border-transparent', 'text-muted-foreground')
				})
				tab.setAttribute('aria-selected', 'true')
				tab.classList.add('border-primary-600', 'text-foreground')
				tab.classList.remove('border-transparent', 'text-muted-foreground')

				document.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach((p) => p.classList.add('hidden'))
				document.getElementById(panelId)?.classList.remove('hidden')
			})
		})
	}
	initTabs()
	document.addEventListener('astro:page-load', initTabs)
</script>
