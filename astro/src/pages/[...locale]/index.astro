---
import { Image } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import VideoEmbed from '@/components/VideoEmbed.astro'
import StatsCounter from '@/components/StatsCounter.astro'
import HeroCarousel from '@/components/HeroCarousel.astro'
import { getTranslations, getLocalePaths, localePath, type Locale } from '@/i18n/utils'
import { partnerLogos, partnerLogoAlts, videoIds } from '@/data/videos'
import { organizationSchema, websiteSchema } from '@/data/schemas'
import heroImg from '@/assets/images/home_header_carousel.png'

const heroSlides = [
	{ src: '/Images/dosismart-screenshot.webp', srcSm: '/Images/dosismart-screenshot-sm.webp', alt: 'Dosismart — Calcul gamma dans le navigateur', label: 'Dosismart — Application web', width: 1280, height: 761 },
	{ src: '/Images/ScreenCarousel2.webp', srcSm: '/Images/ScreenCarousel2-sm.webp', alt: 'DOSIMEX-GX — Générateur X', label: 'DOSIMEX-GX — Générateur X', width: 1280, height: 675 },
	{ src: '/Images/ScreenCarousel3.webp', srcSm: '/Images/ScreenCarousel3-sm.webp', alt: 'DOSIMEX-GX — Source cylindrique', label: 'DOSIMEX-GX — Source cylindrique', width: 1280, height: 783 },
	{ src: '/Images/ScreenCarousel1.webp', srcSm: '/Images/ScreenCarousel1-sm.webp', alt: 'DOSIMEX-B — Dose bêta', label: 'DOSIMEX-B — Dose bêta', width: 1280, height: 727 },
	{ src: '/Images/ScreenCarousel4.webp', srcSm: '/Images/ScreenCarousel4-sm.webp', alt: 'DOSIMEX-N — Dose neutrons', label: 'DOSIMEX-N — Dose neutrons', width: 1280, height: 638 },
]

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)

const partnerGlob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logo_partenaires/*.webp', { eager: true })
const partnerImages = partnerLogos.map((filename) => {
	const match = Object.entries(partnerGlob).find(([path]) => path.endsWith(`/${filename}`))
	return match![1].default
})

const offerCards = [
	{ ...t.home.offers.card1, href: localePath(locale, '/software'), icon: 'calculator' as const },
	{ ...t.home.offers.card2, href: 'https://dosismart.com', icon: 'globe' as const, external: true },
	{ ...t.home.offers.card3, href: localePath(locale, '/training'), icon: 'graduation' as const },
]

const packs = [
	{ id: 'ope', label: t.software.packOpe.title, description: t.software.packOpe.description, tools: t.software.packOpe.tools },
	{ id: 'peda', label: t.software.packPeda.title, description: t.software.packPeda.description, tools: t.software.packPeda.tools },
	{ id: 'mes', label: t.software.packMes.title, description: t.software.packMes.description, tools: t.software.packMes.tools },
]

const refsWithMeta = t.home.references.items.filter((item) => 'authors' in item).slice(0, 4)
---

<Layout title={t.seo.home.title} description={t.seo.home.description} jsonLd={[organizationSchema, websiteSchema(locale)]}>

	<!-- ══════════ HERO ══════════ -->
	<section id="hero" data-ph-section="hero" class="bg-slate-50 dark:bg-[#1A1917] py-16 lg:py-32">
		<div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-12 gap-12 items-center">
			<div class="lg:col-span-7">
				<h1 class="text-3xl md:text-5xl font-heading font-bold text-slate-950 dark:text-slate-100 tracking-tight">
					{t.home.hero.title}
				</h1>
				<p class="mt-6 text-lg text-slate-600 dark:text-slate-400 max-w-xl">
					{t.home.hero.subtitle}
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-4">
					<a
						href="https://dosismart.com"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center h-12 px-6 text-base font-heading font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-[8px] transition-colors duration-150"
						data-ph-cta="hero-trial"
					>
						{t.home.hero.trialButton}
					</a>
					<a
						href={localePath(locale, '/software')}
						class="inline-flex items-center h-12 px-6 text-base font-heading font-semibold text-slate-700 dark:text-slate-200 border-[1.5px] border-slate-300 dark:border-[#3D3A35] hover:bg-slate-100 dark:hover:bg-[#302D29] rounded-[8px] transition-colors duration-150"
						data-ph-cta="hero-tools"
					>
						{t.home.hero.cta}
					</a>
				</div>
				<p class="mt-4 text-sm text-slate-500">
					{t.home.hero.priceNote}
				</p>
			</div>
			<div class="lg:col-span-5">
				<HeroCarousel slides={heroSlides} />
			</div>
		</div>
	</section>

	<!-- ══════════ PARTNER LOGOS ══════════ -->
	<section id="partners" data-ph-section="partners" class="bg-[#E8E6E3] dark:bg-[#252320] py-10">
		<div class="mx-auto max-w-7xl px-6">
			<p class="text-center text-sm uppercase tracking-[0.1em] font-heading font-semibold text-slate-400 mb-8">
				{locale === 'fr' ? 'Ils nous font confiance' : 'Trusted by'}
			</p>
			<div class="flex flex-wrap items-center justify-center gap-8 lg:gap-12 min-h-[40px]">
				{partnerImages.map((img, i) => (
					<Image
						src={img}
						alt={partnerLogoAlts[i]}
						height={40}
						width={120}
						class="h-10 w-auto max-w-[120px] object-contain logo-grayscale"
						loading="lazy"
					/>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ PRODUCT OVERVIEW CARDS ══════════ -->
	<section id="offers" data-ph-section="offers" class="bg-slate-50 dark:bg-[#1A1917] py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-6">
			<div class="text-center max-w-2xl mx-auto">
				<h2 class="text-3xl font-heading font-semibold text-slate-950 dark:text-slate-100">
					{t.home.offers.title}
				</h2>
				<p class="mt-4 text-base text-slate-600 dark:text-slate-400">
					{t.home.offers.description}
				</p>
			</div>

			<div class="mt-12 grid gap-8 lg:grid-cols-3">
				{offerCards.map((card) => (
					<div class="bg-white dark:bg-[#252320] border border-slate-200 dark:border-[#3D3A35] rounded-lg p-8 hover:shadow-sm hover:-translate-y-0.5 transition-all duration-200">
						<div class="w-8 h-8 text-primary-600 mb-4">
							{card.icon === 'calculator' && (
								<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><line x1="16" x2="16" y1="10" y2="10"/><line x1="12" x2="12" y1="10" y2="10"/><line x1="8" x2="8" y1="10" y2="10"/><line x1="12" x2="12" y1="14" y2="14"/><line x1="8" x2="8" y1="14" y2="14"/><line x1="12" x2="12" y1="18" y2="18"/><line x1="8" x2="8" y1="18" y2="18"/></svg>
							)}
							{card.icon === 'globe' && (
								<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
							)}
							{card.icon === 'graduation' && (
								<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>
							)}
						</div>
						<h3 class="text-xl font-heading font-semibold text-slate-950 dark:text-slate-100">{card.title}</h3>
						<p class="mt-3 text-base text-slate-600 dark:text-slate-400">{card.description}</p>
						<a
							href={card.href}
							target={'external' in card ? '_blank' : undefined}
							rel={'external' in card ? 'noopener noreferrer' : undefined}
							class="mt-5 inline-flex items-center text-primary-600 font-heading font-semibold hover:underline"
						>
							{card.linkLabel} <span class="ml-1">&rarr;</span>
						</a>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ STATS COUNTER ══════════ -->
	<StatsCounter items={t.home.numbers.items} />

	<!-- ══════════ TOOL PACKS PREVIEW ══════════ -->
	<section id="packs" data-ph-section="packs" class="bg-slate-50 dark:bg-[#1A1917] py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-6">
			<h2 class="text-3xl font-heading font-semibold text-slate-950 dark:text-slate-100">
				{t.home.packs.title}
			</h2>
			<p class="mt-2 text-base text-slate-600 dark:text-slate-400 max-w-2xl">
				{t.home.packs.subtitle}
			</p>

			<!-- Tabs -->
			<div class="mt-8" role="tablist" aria-label="Tool packs">
				<div class="flex border-b border-slate-200 dark:border-[#3D3A35] gap-0">
					{packs.map((pack, i) => (
						<button
							type="button"
							role="tab"
							id={`tab-${pack.id}`}
							aria-selected={i === 0 ? 'true' : 'false'}
							aria-controls={`panel-${pack.id}`}
							class:list={[
								'px-4 py-3 text-sm font-heading font-medium border-b-[3px] transition-colors duration-150 -mb-px cursor-pointer',
								i === 0
									? 'border-primary-600 text-slate-950 dark:text-slate-100'
									: 'border-transparent text-slate-500 hover:text-slate-700 dark:hover:text-slate-300',
							]}
						>
							{pack.label}
						</button>
					))}
				</div>

				{packs.map((pack, i) => (
					<div
						role="tabpanel"
						id={`panel-${pack.id}`}
						aria-labelledby={`tab-${pack.id}`}
						class:list={['mt-8', i !== 0 && 'hidden']}
					>
						<p class="text-base text-slate-600 dark:text-slate-400 mb-6 max-w-2xl">{pack.description}</p>
						<div class="flex flex-wrap gap-2">
							{pack.tools.map((tool) => (
								<span class="inline-block text-sm bg-[#E8E6E3] dark:bg-[#302D29] text-slate-700 dark:text-slate-300 rounded-[6px] px-3 py-1">
									{tool.name}
								</span>
							))}
						</div>
						<a
							href={localePath(locale, '/software')}
							class="mt-6 inline-flex items-center text-primary-600 font-heading font-semibold hover:underline"
						>
							{t.home.packs.allTools} <span class="ml-1">&rarr;</span>
						</a>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ DOSISMART BANNER ══════════ -->
	<section id="dosismart" data-ph-section="dosismart" class="bg-primary-50 dark:bg-[#2a1f1f] py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-2 gap-12 items-center">
			<div class="order-2 lg:order-1" data-lightbox>
				<img
					src="/Images/dosismart-screenshot.webp"
					srcset="/Images/dosismart-screenshot-sm.webp 640w, /Images/dosismart-screenshot.webp 1280w"
					sizes="(max-width: 1024px) 100vw, 640px"
					alt="Dosismart — Calcul gamma dans le navigateur"
					width="1280"
					height="761"
					class="w-full rounded-lg"
					loading="lazy"
				/>
			</div>
			<div class="order-1 lg:order-2">
				<h2 class="text-3xl font-heading font-semibold text-slate-950 dark:text-slate-100">
					{t.home.dosismart.title}
				</h2>
				<p class="mt-4 text-base text-slate-600 dark:text-slate-400 max-w-lg">
					{t.home.dosismart.text}
				</p>
				<div class="mt-4 space-y-1">
					<p class="text-sm font-heading font-semibold text-slate-800 dark:text-slate-200">
						<span class="inline-block w-2 h-2 rounded-full bg-success mr-2"></span>{t.home.dosismart.available}
					</p>
					<p class="text-sm font-heading text-slate-500">
						<span class="inline-block w-2 h-2 rounded-full bg-accent-400 mr-2"></span>{t.home.dosismart.coming}
					</p>
				</div>
				<a
					href="https://dosismart.com"
					target="_blank"
					rel="noopener noreferrer"
					class="mt-6 inline-flex items-center h-12 px-6 text-base font-heading font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-[8px] transition-colors duration-150"
					data-ph-cta="dosismart-trial"
				>
					{t.home.dosismart.button}
				</a>
			</div>
		</div>
	</section>

	<!-- ══════════ TESTIMONIAL ══════════ -->
	<section id="testimonial" data-ph-section="testimonial" class="bg-[#E8E6E3] dark:bg-[#252320] py-12 md:py-20">
		<div class="mx-auto max-w-3xl px-6 text-center">
			<div class="text-6xl text-primary-200 leading-none select-none" aria-hidden="true">&ldquo;</div>
			<blockquote class="mt-2">
				<p class="text-xl md:text-2xl text-slate-800 dark:text-slate-200 italic leading-relaxed">
					{t.home.opinion.text}
				</p>
			</blockquote>
			<div class="mt-6">
				<div class="text-base font-heading font-semibold text-slate-900 dark:text-slate-100">
					{t.home.opinion.name}
				</div>
				<div class="text-sm text-slate-500">
					{t.home.opinion.job}
				</div>
			</div>
		</div>
	</section>

	<!-- ══════════ VIDEO ══════════ -->
	<section id="video" data-ph-section="video" class="bg-slate-50 dark:bg-[#1A1917] py-12 md:py-20">
		<div class="mx-auto max-w-4xl px-6">
			<h2 class="text-3xl font-heading font-semibold text-slate-950 dark:text-slate-100 text-center mb-8">
				{t.home.videoTitle}
			</h2>
			<VideoEmbed videoId={videoIds.presentation} title={t.home.videoTitle} />
			<div class="mt-6 text-center">
				<a href={localePath(locale, '/videos')} class="text-primary-600 font-heading font-semibold hover:underline">
					{t.home.videos.button} <span class="ml-1">&rarr;</span>
				</a>
			</div>
		</div>
	</section>

	<!-- ══════════ REFERENCES ══════════ -->
	<section id="references" data-ph-section="references" class="bg-[#E8E6E3] dark:bg-[#252320] py-12">
		<div class="mx-auto max-w-7xl px-6">
			<h2 class="text-2xl font-heading font-semibold text-slate-950 dark:text-slate-100 mb-6">
				{t.home.references.title}
			</h2>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{refsWithMeta.map((item) => (
					<a
						href={item.url}
						target="_blank"
						rel="noopener noreferrer"
						class="block bg-white dark:bg-[#1A1917] rounded-[8px] p-4 hover:shadow-sm transition-shadow"
					>
						<h3 class="text-sm font-heading font-semibold text-slate-900 dark:text-slate-100 line-clamp-2">
							{item.title}
						</h3>
						{'authors' in item && 'year' in item && (
							<p class="mt-2 text-xs text-slate-500">
								{item.authors} &middot; {item.year}
							</p>
						)}
						{'journal' in item && (
							<p class="mt-1 text-xs text-slate-400 italic">{item.journal}</p>
						)}
					</a>
				))}
			</div>
			<div class="mt-4">
				<a href={localePath(locale, '/manuals')} class="text-sm text-primary-600 font-heading font-semibold hover:underline">
					{t.home.references.btnText} <span class="ml-1">&rarr;</span>
				</a>
			</div>
		</div>
	</section>

	<!-- ══════════ CTA CLOSE ══════════ -->
	<section id="cta-close" data-ph-section="cta-close" class="bg-slate-950 bg-grid py-16 md:py-24">
		<div class="mx-auto max-w-3xl px-6 text-center">
			<h2 class="text-3xl font-heading font-bold text-white">
				{t.home.close.title}
			</h2>
			<p class="mt-4 text-lg text-slate-400">
				{t.home.close.price} &mdash; {t.home.close.includes}
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
				<a
					href={localePath(locale, '/contact')}
					class="inline-flex items-center h-12 px-6 text-base font-heading font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-[8px] transition-colors duration-150"
					data-ph-cta="close-quote"
				>
					{t.home.close.quoteButton}
				</a>
				<a
					href="https://dosismart.com"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center h-12 px-6 text-base font-heading font-semibold text-slate-300 border-[1.5px] border-slate-600 hover:bg-slate-800 rounded-[8px] transition-colors duration-150"
					data-ph-cta="close-trial"
				>
					{t.home.close.trialButton}
				</a>
			</div>
			<p class="mt-4 text-sm text-slate-500">
				{t.home.close.dosismartNote}
			</p>
		</div>
	</section>

</Layout>

<!-- Tab switching script -->
<script>
	function initTabs() {
		const tabs = document.querySelectorAll<HTMLButtonElement>('[role="tab"]')
		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const panelId = tab.getAttribute('aria-controls')
				if (!panelId) return

				tabs.forEach((t) => {
					t.setAttribute('aria-selected', 'false')
					t.classList.remove('border-primary-600', 'text-slate-950', 'dark:text-slate-100')
					t.classList.add('border-transparent', 'text-slate-500')
				})
				tab.setAttribute('aria-selected', 'true')
				tab.classList.add('border-primary-600', 'text-slate-950', 'dark:text-slate-100')
				tab.classList.remove('border-transparent', 'text-slate-500')

				document.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach((p) => p.classList.add('hidden'))
				document.getElementById(panelId)?.classList.remove('hidden')
			})
		})
	}
	initTabs()
	document.addEventListener('astro:page-load', initTabs)
</script>
