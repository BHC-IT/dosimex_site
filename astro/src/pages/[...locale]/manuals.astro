---
import Layout from '@/layouts/Layout.astro'
import { getTranslations, getLocalePaths, type Locale } from '@/i18n/utils'
import { getManualPdfs } from '@/data/videos'
import { organizationSchema } from '@/data/schemas'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const manualPdfs = getManualPdfs(locale)
const t = getTranslations(locale)
const m = t.manuals

const anchorIds = ['manuals', 'validations', 'internships'] as const

const manualImages = locale === 'fr'
	? ['/Images/manuel1.png', '/Images/manuel2.png', '/Images/manuel3.png', '/Images/manuel4.png']
	: ['/Images/handbook1.png', '/Images/handbook2.png', '/Images/manuel3.png', '/Images/manuel4.png']
const validationImages = locale === 'fr'
	? ['/Images/Validation1.png', '/Images/Validation2.png', '/Images/Validation3.png', '/Images/Validation4.png', '/Images/Validation5.png']
	: ['/Images/validation1en.png', '/Images/validation2en.png', '/Images/Validation3.png', '/Images/Validation4.png', '/Images/Validation5.png']
const internshipImages = ['/Images/Rapport1.png', '/Images/Rapport2.png', '/Images/Rapport3.png', '/Images/Rapport4.png']
---

<Layout title={t.seo.manuals.title} description={t.seo.manuals.description} jsonLd={[organizationSchema]}>

	<!-- Hero -->
	<section class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-foreground tracking-tight">
				{m.header.title}
			</h1>
			<p class="mt-6 max-w-3xl text-base text-slate-600 dark:text-slate-400 leading-relaxed">
				{m.header.description}
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				{m.header.anchors.map((label, i) => (
					<a
						href={`#${anchorIds[i]}`}
						class="inline-flex items-center gap-2 rounded-[8px] border-[1.5px] border-primary-600 text-primary-600 h-12 px-6 font-heading font-semibold hover:bg-primary-600/10 transition-colors"
					>
						{label}
						<span aria-hidden="true">&darr;</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Manuals section -->
	<section id="manuals" class="py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-2xl font-heading font-semibold text-foreground">{m.manuals.title}</h2>
			<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				{m.manuals.items.map((name, i) => (
					<a
						href={manualPdfs.manuals[i]}
						target="_blank"
						rel="noopener noreferrer"
						class="group rounded-lg border border-slate-200 dark:border-[#3D3A35] bg-white dark:bg-[#252320] overflow-hidden shadow-sm transition-shadow hover:shadow-md text-center"
						data-ph-cta="download_pdf"
					>
						<img
							src={manualImages[i]}
							alt={`${t.altText.manualCover} — ${name}`}
							class="w-full h-48 object-cover object-top"
							loading="lazy"
						/>
						<div class="p-4">
							<svg class="mx-auto h-8 w-8 text-primary transition-colors group-hover:text-primary/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
							</svg>
							<p class="mt-2 text-sm font-medium text-foreground">{name}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Validations section -->
	<section id="validations" class="bg-muted/40 py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-2xl font-heading font-semibold text-foreground">{m.validations.title}</h2>
			<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-5">
				{m.validations.items.map((name, i) => (
					<a
						href={manualPdfs.validations[i]}
						target="_blank"
						rel="noopener noreferrer"
						class="group rounded-lg border border-slate-200 dark:border-[#3D3A35] bg-white dark:bg-[#1a1816] overflow-hidden shadow-sm transition-shadow hover:shadow-md text-center"
						data-ph-cta="download_pdf"
					>
						<img
							src={validationImages[i]}
							alt={`${t.altText.manualCover} — ${name}`}
							class="w-full h-48 object-cover object-top"
							loading="lazy"
						/>
						<div class="p-4">
							<svg class="mx-auto h-8 w-8 text-primary transition-colors group-hover:text-primary/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
							</svg>
							<p class="mt-2 text-sm font-medium text-foreground">{name}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Internships section -->
	<section id="internships" class="py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-2xl font-heading font-semibold text-foreground">{m.internships.title}</h2>
			<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				{m.internships.items.map((name, i) => (
					<a
						href={manualPdfs.internships[i]}
						target="_blank"
						rel="noopener noreferrer"
						class="group rounded-lg border border-slate-200 dark:border-[#3D3A35] bg-white dark:bg-[#252320] overflow-hidden shadow-sm transition-shadow hover:shadow-md text-center"
						data-ph-cta="download_pdf"
					>
						<img
							src={internshipImages[i]}
							alt={`${t.altText.manualCover} — ${name}`}
							class="w-full h-48 object-cover object-top"
							loading="lazy"
						/>
						<div class="p-4">
							<svg class="mx-auto h-8 w-8 text-primary transition-colors group-hover:text-primary/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
							</svg>
							<p class="mt-2 text-sm font-medium text-foreground">{name}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

</Layout>
