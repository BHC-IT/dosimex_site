---
import { Image } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import { getTranslations, getLocalePaths, type Locale } from '@/i18n/utils'
import { bookUrls } from '@/data/videos'
import { organizationSchema } from '@/data/schemas'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }

const bookGlob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/livre*.png', { eager: true })
const bookImages = Object.entries(bookGlob)
	.sort(([a], [b]) => {
		const numA = parseInt(a.match(/livre(\d+)/)?.[1] ?? '0')
		const numB = parseInt(b.match(/livre(\d+)/)?.[1] ?? '0')
		return numA - numB
	})
	.map(([, m]) => m.default)

const t = getTranslations(locale)
const b = t.books

const bookSchemas = b.items.map((book, i) => ({
	'@context': 'https://schema.org',
	'@type': 'Book',
	name: book.title,
	author: { '@type': 'Person', name: book.author },
	url: bookUrls[i],
}))
---

<Layout title={t.seo.books.title} description={t.seo.books.description} jsonLd={[organizationSchema, ...bookSchemas]}>

	<!-- Hero -->
	<section class="relative py-20 lg:py-28">
		<div class="absolute inset-0 -z-10" aria-hidden="true">
			<div class="absolute -bottom-40 -right-[14rem] h-[380px] w-[500px] rounded-full bg-primary/20 blur-3xl dark:bg-primary/10"></div>
			<div class="absolute -bottom-56 -right-[18rem] h-[280px] w-[360px] rounded-full bg-brandred/[0.16] blur-3xl dark:bg-brandred/[0.14]"></div>
		</div>

		<div class="relative mx-auto max-w-7xl px-6">
			<h1 class="max-w-3xl text-balance text-4xl font-heading font-bold tracking-tight text-foreground md:text-5xl">
				{b.header.title}
			</h1>
			<p class="mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed">
				{t.seo.books.description}
			</p>
		</div>
	</section>

	<!-- Book Grid -->
	<section class="pb-16 md:pb-24">
		<div class="mx-auto max-w-7xl px-6">
			<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
				{b.items.map((book, index) => (
					<div class="rounded-2xl bg-card overflow-hidden shadow-sm hover:shadow-md transition-shadow">
						<div class="bg-muted dark:bg-secondary p-6 flex items-center justify-center" style="aspect-ratio: 3/4;">
							<Image
								src={bookImages[index]}
								alt={`${b.coverAlt} ${book.title} ${b.byAuthor} ${book.author}`}
								width={350}
								class="h-full w-full object-contain"
								loading="lazy"
							/>
						</div>
						<div class="p-6">
							<h2 class="text-lg font-heading font-semibold text-foreground leading-snug">
								{book.title}
							</h2>
							<p class="mt-2 text-sm font-semibold text-primary">
								{b.byAuthor} {book.author}
							</p>
							<p class="mt-3 text-sm text-foreground/70 leading-relaxed line-clamp-4">
								{book.extract}
							</p>
							<a
								href={bookUrls[index]}
								target="_blank"
								rel="noopener noreferrer"
								class="mt-4 inline-flex items-center gap-2 rounded-lg border border-border bg-background px-4 py-2 text-sm font-heading font-semibold text-foreground transition-colors hover:bg-muted"
							>
								{b.viewBook}
								<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
								</svg>
							</a>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

</Layout>
