---
import Layout from '@/layouts/Layout.astro'
import VideoEmbed from '@/components/VideoEmbed.astro'
import { getTranslations, getLocalePaths, localePath, type Locale } from '@/i18n/utils'
import { videoIds } from '@/data/videos'
import { organizationSchema } from '@/data/schemas'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)
const l = t.learn

const arrow = 'M5 12h14M12 5l7 7-7 7'
const external = 'M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14'

// Router cards: i18n copy + destination + icon, one idea each.
const resources = [
	{ data: l.resources.books, href: localePath(locale, '/books'), external: false, icon: 'book' },
	{ data: l.resources.videos, href: videoIds.channelUrl, external: true, icon: 'play' },
	{ data: l.resources.manuals, href: localePath(locale, '/manuals'), external: false, icon: 'file' },
	{ data: l.resources.training, href: localePath(locale, '/training'), external: false, icon: 'cap' },
]
---

<Layout title={t.seo.learn.title} description={t.seo.learn.description} jsonLd={[organizationSchema]}>

	<!-- ══════════ HERO ══════════ -->
	<section class="relative py-20 lg:py-32">
		<div class="absolute inset-0 -z-10" aria-hidden="true">
			<div class="absolute -bottom-40 -right-[14rem] h-[380px] w-[500px] rounded-full bg-primary/20 blur-3xl dark:bg-primary/10"></div>
			<div class="absolute -bottom-56 -right-[16rem] h-[280px] w-[360px] rounded-full bg-brandred/[0.16] blur-3xl dark:bg-brandred/[0.14]"></div>
			<div class="bg-dots absolute inset-0 opacity-70 [mask-image:radial-gradient(ellipse_at_center,black,transparent_70%)]"></div>
		</div>

		<div class="relative mx-auto max-w-7xl px-6">
			<p class="text-sm font-semibold uppercase tracking-widest text-primary">{l.header.eyebrow}</p>
			<h1 class="mt-4 max-w-3xl text-balance text-4xl font-heading font-bold tracking-tight text-foreground md:text-5xl">
				{l.header.title}
			</h1>
			<p class="mt-6 max-w-3xl text-lg text-muted-foreground leading-relaxed">
				{l.header.description}
			</p>
			<p class="mt-8 text-sm text-muted-foreground">
				{l.header.educationText}
				<a
					href={localePath(locale, '/contact')}
					class="ml-1 inline-flex items-center gap-1 font-heading font-semibold text-primary hover:underline"
					data-ph-cta="learn_education_contact"
				>
					{l.header.educationLink}
					<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d={arrow}/></svg>
				</a>
			</p>
		</div>
	</section>

	<!-- ══════════ LEARNING MODULES ══════════ -->
	<section class="py-16 md:py-28">
		<div class="reveal mx-auto max-w-7xl px-6">
			<div class="max-w-3xl">
				<div class="flex items-center gap-3">
					<span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
						<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
					</span>
					<p class="text-sm font-semibold uppercase tracking-widest text-primary">{l.modules.eyebrow}</p>
				</div>
				<h2 class="mt-4 text-3xl font-heading font-semibold tracking-tight text-foreground md:text-4xl">{l.modules.title}</h2>
				<p class="mt-4 text-lg text-muted-foreground leading-relaxed">{l.modules.description}</p>
			</div>

			<div class="mt-12 grid gap-6 lg:grid-cols-2">
				{l.modules.tools.map((tool) => (
					<div class="group flex flex-col rounded-2xl bg-card p-8 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/5">
						<div class="flex items-start justify-between gap-3">
							<h3 class="text-lg font-heading font-semibold text-foreground">{tool.name}</h3>
							<span class:list={[
								"shrink-0 rounded-full px-2.5 py-0.5 text-xs font-heading font-semibold",
								tool.frOnly
									? "bg-muted text-muted-foreground"
									: "bg-primary/10 text-primary"
							]}>
								{tool.frOnly ? 'FR' : 'FR / EN'}
							</span>
						</div>
						<p class="mt-3 text-sm text-muted-foreground leading-relaxed">{tool.description}</p>
						{tool.videoId && (
							<div class="mt-5 overflow-hidden rounded-xl">
								<VideoEmbed videoId={tool.videoId} title={tool.name} />
							</div>
						)}
					</div>
				))}
			</div>

			<p class="mt-10 text-sm text-muted-foreground">
				{l.modules.suiteNote}
				<a
					href={localePath(locale, '/software')}
					class="ml-1 inline-flex items-center gap-1 font-heading font-semibold text-primary hover:underline"
					data-ph-cta="learn_suite"
				>
					{l.modules.suiteLink}
					<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d={arrow}/></svg>
				</a>
			</p>
		</div>
	</section>

	<!-- ══════════ KEEP LEARNING ══════════ -->
	<section class="py-16 md:py-28">
		<div class="reveal mx-auto max-w-7xl px-6">
			<p class="text-sm font-semibold uppercase tracking-widest text-primary">{l.resources.eyebrow}</p>
			<h2 class="mt-3 text-3xl font-heading font-semibold tracking-tight text-foreground md:text-4xl">{l.resources.title}</h2>

			<div class="mt-12 grid gap-6 md:grid-cols-2">
				{resources.map((item) => (
					<a
						href={item.href}
						target={item.external ? '_blank' : undefined}
						rel={item.external ? 'noopener noreferrer' : undefined}
						class="group flex flex-col rounded-2xl bg-card p-8 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/5"
					>
						<span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-primary/10 text-primary">
							{item.icon === 'book' && (
								<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
							)}
							{item.icon === 'play' && (
								<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
							)}
							{item.icon === 'file' && (
								<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
							)}
							{item.icon === 'cap' && (
								<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>
							)}
						</span>
						<h3 class="mt-4 text-xl font-heading font-semibold text-foreground">{item.data.title}</h3>
						<p class="mt-2 text-sm text-muted-foreground leading-relaxed">{item.data.text}</p>
						<span class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-heading font-semibold text-primary">
							{item.data.link}
							<svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path d={item.external ? external : arrow} />
							</svg>
						</span>
					</a>
				))}
			</div>
		</div>
	</section>

</Layout>
