---
/**
 * HistoryPreview — a rebuilt glimpse of the Dosismart calculation history /
 * audit trail (a cloud-only differentiator over the desktop suite). Mirrors the
 * app's history grid: favorite star · name · radionuclide · dose-rate result ·
 * date, with the real column labels (historyPage.columns). Static, prop-free,
 * bilingual. See CLAUDE.md › "Voice & UI › Visuals".
 */
import type { Locale } from '@/i18n/utils'
import WindowFrame from './WindowFrame.astro'

interface Props {
	locale: Locale
	class?: string
}

const { locale, class: className = '' } = Astro.props
const isFr = locale === 'fr'

const title = isFr ? 'Historique des calculs' : 'Calculation History'
const subtitle = isFr
	? '4 calculs · synchronisés dans le cloud'
	: '4 calculations · synced to the cloud'

const cols = {
	name: isFr ? 'Nom' : 'Name',
	nuclide: isFr ? 'Radionucléide' : 'Radionuclide',
	doseRate: isFr ? 'Débit de dose' : 'Dose Rate',
	date: 'Date',
}

// Illustrative rows — realistic radionuclides, dose rates and use cases.
const rows = [
	{ fav: true, name: isFr ? 'Gammagraphie · chantier A' : 'Gammagraphy · site A', nuclide: 'Ir-192', dose: '1.24 mSv/h', date: isFr ? '28/07' : 'Jul 28' },
	{ fav: false, name: isFr ? 'Irradiateur · maintenance' : 'Irradiator · maintenance', nuclide: 'Co-60', dose: '312 µSv/h', date: isFr ? '27/07' : 'Jul 27' },
	{ fav: false, name: isFr ? 'Contrôle soudure' : 'Weld inspection', nuclide: 'Se-75', dose: '96 µSv/h', date: isFr ? '24/07' : 'Jul 24' },
	{ fav: true, name: isFr ? 'Source étalon' : 'Reference source', nuclide: 'Cs-137', dose: '48 µSv/h', date: isFr ? '18/07' : 'Jul 18' },
]
---

<WindowFrame class={className}>
	<div class="p-4 sm:p-5">
		<div class="mb-4 flex items-center justify-between gap-3">
			<h3 class="flex items-center gap-2 text-sm font-semibold text-foreground">
				<span class="h-2 w-2 rounded-full bg-blue-500" aria-hidden="true"></span>
				{title}
			</h3>
			<span class="text-xs text-muted-foreground">{subtitle}</span>
		</div>

		<div class="overflow-hidden rounded-lg border border-border">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-border bg-muted/40 text-xs text-muted-foreground">
						<th class="w-8 px-2 py-2"></th>
						<th class="px-2 py-2 text-left font-medium sm:px-3">{cols.name}</th>
						<th class="hidden px-2 py-2 text-left font-medium sm:table-cell sm:px-3">{cols.nuclide}</th>
						<th class="px-2 py-2 text-right font-medium sm:px-3">{cols.doseRate}</th>
						<th class="hidden px-2 py-2 text-right font-medium sm:table-cell sm:px-3">{cols.date}</th>
					</tr>
				</thead>
				<tbody>
					{rows.map((r) => (
						<tr class="border-b border-border last:border-0">
							<td class="px-2 py-2.5 text-center">
								<svg
									class:list={['inline h-3.5 w-3.5', r.fav ? 'text-amber-400' : 'text-muted-foreground/40']}
									viewBox="0 0 24 24"
									fill={r.fav ? 'currentColor' : 'none'}
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.12 2.12 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.12 2.12 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.12 2.12 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.12 2.12 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.12 2.12 0 0 0 1.597-1.16z" />
								</svg>
							</td>
							<td class="w-full max-w-0 px-2 py-2.5 font-medium text-foreground sm:px-3">
								<span class="block truncate">{r.name}</span>
								<span class="block text-xs font-normal text-muted-foreground sm:hidden">{r.nuclide}</span>
							</td>
							<td class="hidden px-2 py-2.5 text-muted-foreground sm:table-cell sm:px-3">{r.nuclide}</td>
							<td class="whitespace-nowrap px-2 py-2.5 text-right font-semibold tabular-nums text-foreground sm:px-3">{r.dose}</td>
							<td class="hidden px-2 py-2.5 text-right text-xs text-muted-foreground sm:table-cell sm:px-3">{r.date}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>
</WindowFrame>
