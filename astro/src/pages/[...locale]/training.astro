---
import Layout from '@/layouts/Layout.astro'
import VideoEmbed from '@/components/VideoEmbed.astro'
import { getTranslations, getLocalePaths, localePath, type Locale } from '@/i18n/utils'
import { videoIds } from '@/data/videos'
import { organizationSchema } from '@/data/schemas'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)
const tr = t.training
---

<Layout title={t.seo.training.title} description={t.seo.training.description} jsonLd={[organizationSchema]}>

	<!-- Hero -->
	<section class="py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid items-center gap-10 lg:grid-cols-2">
				<div>
					<h1 class="text-4xl font-extrabold tracking-tight text-foreground font-lato md:text-5xl">
						{tr.header.title}
					</h1>
					<p class="mt-6 text-lg text-foreground/70 leading-relaxed">
						{tr.header.description}
					</p>
				</div>
				<div>
					<VideoEmbed videoId={videoIds.presentation} title={tr.videoTitle} />
				</div>
			</div>
		</div>
	</section>

	<!-- Section 1: Training Topics -->
	<section class="bg-[#E8E6E3] dark:bg-[#252320] py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-2xl font-heading font-semibold text-foreground md:text-3xl">
				{tr.section1.title}
			</h2>
			<div class="mt-8 grid gap-4 md:grid-cols-2">
				{tr.section1.items.map((item) => (
					<div class="border-l-4 border-primary/30 pl-4 py-2">
						<p class="text-foreground/80">{item}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Section 2: Partner Training -->
	<section class="py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-2xl font-heading font-semibold text-foreground md:text-3xl">
				{tr.section2.title}
			</h2>
			<ul class="mt-8 space-y-3">
				{tr.section2.items.map((item) => (
					<li class="flex items-center gap-3 text-foreground/80">
						<svg class="h-4 w-4 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
						</svg>
						{item}
					</li>
				))}
			</ul>
			<a
				href="/Folders/catalogue_formations.pdf"
				target="_blank"
				rel="noopener noreferrer"
				class="mt-8 inline-flex items-center gap-2 rounded-[8px] bg-primary-600 hover:bg-primary-700 h-12 px-6 font-heading font-semibold text-white transition-colors"
				data-ph-cta="download_catalog"
			>
				{tr.section2.button}
				<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
				</svg>
			</a>
		</div>
	</section>

	<!-- Contact CTA -->
	<section class="bg-slate-950 py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="text-center">
				<h2 class="text-2xl font-heading font-semibold text-white md:text-3xl">
					{tr.questions.title}
				</h2>
				<p class="mx-auto mt-4 max-w-2xl text-slate-300">
					{tr.questions.text}
				</p>
				<a
					href={localePath(locale, '/contact')}
					class="mt-6 inline-flex items-center rounded-[8px] bg-primary-600 hover:bg-primary-700 h-12 px-6 font-heading font-semibold text-white transition-colors"
					data-ph-cta="contact_us"
				>
					{tr.questions.button}
				</a>
			</div>
		</div>
	</section>

</Layout>
