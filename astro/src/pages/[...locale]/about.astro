---
import { Image } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import { getTranslations, getLocalePaths, localePath, type Locale } from '@/i18n/utils'
import { organizationSchema } from '@/data/schemas'
import geraldImg from '@/assets/images/Gerald.png'
import alainImg from '@/assets/images/Alain.png'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)
const a = t.about

const arrow = 'M5 12h14M12 5l7 7-7 7'

const founders = [
	{ name: 'Gérald Lopez', img: geraldImg, path: a.gerald.path, intro: a.gerald.intro, outro: a.gerald.outro, paragraphs: null },
	{ name: 'Alain Vivier', img: alainImg, path: a.alain.path, intro: null, outro: null, paragraphs: a.alain.paragraphs },
]
---

<Layout title={t.seo.about.title} description={t.seo.about.description} jsonLd={[organizationSchema]}>

	<!-- ══════════ HERO ══════════ -->
	<section class="relative py-20 lg:py-28">
		<div class="absolute inset-0 -z-10" aria-hidden="true">
			<div class="absolute -bottom-40 -right-[14rem] hidden h-[380px] w-[500px] rounded-full bg-primary/20 blur-3xl dark:bg-primary/10 lg:block"></div>
			<div class="absolute -bottom-56 -right-[18rem] hidden h-[280px] w-[360px] rounded-full bg-brandred/[0.16] blur-3xl dark:bg-brandred/[0.14] lg:block"></div>
		</div>

		<div class="relative mx-auto max-w-7xl px-6">
			<h1 class="max-w-3xl text-balance text-4xl font-heading font-bold tracking-tight text-foreground md:text-5xl">
				{a.header.title}
			</h1>
			<p class="mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed">
				{a.header.subtitle}
			</p>
		</div>
	</section>

	<!-- ══════════ FOUNDERS ══════════ -->
	{founders.map((founder) => (
		<section class="py-14 md:py-20">
			<div class="reveal mx-auto max-w-6xl px-6">
				<div class="grid gap-10 lg:grid-cols-12 lg:gap-14">

					<!-- Profile column (sticky on desktop) -->
					<div class="lg:col-span-4">
						<div class="lg:sticky lg:top-28">
							<div class:list={["relative", founder.name === 'Alain Vivier' && "cursor-pointer"]} data-egg-source={founder.name === 'Alain Vivier' ? 'cats' : undefined}>
								<div class="absolute -inset-4 -z-10 rounded-[2rem] bg-primary/10 blur-2xl" aria-hidden="true"></div>
								<Image
									src={founder.img}
									alt={founder.name}
									width={480}
									height={600}
									class="aspect-[3/4] w-full max-w-[320px] rounded-2xl object-cover object-top shadow-xl shadow-primary/10 ring-1 ring-border"
									loading="lazy"
								/>
							</div>
							<h2 class="mt-6 text-2xl font-heading font-bold tracking-tight text-foreground">{founder.name}</h2>
							<div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1.5">
								{founder.path.map((step, i) => (
									<Fragment>
										{i > 0 && <span class="text-muted-foreground/40" aria-hidden="true">&rarr;</span>}
										<span class:list={[
											'rounded-full px-2.5 py-0.5 text-xs font-heading font-semibold',
											i === founder.path.length - 1 ? 'bg-primary/10 text-primary' : 'bg-muted text-muted-foreground',
										]}>
											{step}
										</span>
									</Fragment>
								))}
							</div>
						</div>
					</div>

					<!-- Narrative column -->
					<div class="lg:col-span-8">
						{founder.intro && (
							<div class="space-y-5">
								{founder.intro.map((paragraph) => (
									<p class="text-base text-muted-foreground leading-relaxed">{paragraph}</p>
								))}
							</div>
						)}

						{founder.outro && (
							<p class="mt-8 border-l-2 border-primary/30 pl-4 text-base font-medium text-foreground/90 leading-relaxed">
								{founder.outro}
							</p>
						)}

						{founder.paragraphs && (
							<div class="space-y-5">
								{founder.paragraphs.map((paragraph) => (
									<p class="text-base text-muted-foreground leading-relaxed">{paragraph}</p>
								))}
							</div>
						)}
					</div>

				</div>
			</div>
		</section>
	))}

	<!-- ══════════ EPILOGUE (pull-quote) ══════════ -->
	<section class="relative overflow-hidden py-16 md:py-24">
		<div class="absolute left-1/2 top-1/2 -z-10 h-[200px] w-[85vw] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/5 blur-3xl lg:h-[300px] lg:w-[560px]" aria-hidden="true"></div>
		<div class="reveal mx-auto max-w-3xl px-6 text-center">
			<svg class="mx-auto h-10 w-10 text-primary/25" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
			<blockquote class="mt-6">
				<p class="text-balance text-xl font-heading font-medium leading-relaxed text-foreground md:text-2xl md:leading-relaxed">
					{a.epilogue}
				</p>
			</blockquote>
		</div>
	</section>

	<!-- ══════════ CTA ══════════ -->
	<section class="py-16 md:py-24">
		<div class="reveal mx-auto max-w-7xl px-6">
			<div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary/[0.12] via-primary/[0.05] to-transparent p-10 text-center md:p-14">
				<div class="relative mx-auto max-w-2xl">
					<h2 class="text-3xl font-heading font-bold tracking-tight text-foreground md:text-4xl">{a.cta.title}</h2>
					<p class="mx-auto mt-5 max-w-xl text-lg text-muted-foreground">{a.cta.text}</p>
					<div class="mt-8 flex justify-center">
						<a
							href={localePath(locale, '/product')}
							class="btn btn-primary"
							data-ph-cta="view_product"
						>
							{a.cta.button}
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d={arrow}/></svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

</Layout>
