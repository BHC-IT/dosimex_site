---
/**
 * DashboardPreview — a live, rebuilt glimpse of the Dosismart gamma calculator,
 * framed in browser chrome on a soft glow backdrop (Proton pattern).
 *
 * This intentionally reuses the Dosismart app's real component idioms
 * (card = `rounded-lg border bg-card shadow-sm`, result value = `text-2xl
 * font-bold text-primary`, status dots, muted result boxes) so it reads as a
 * true preview of the product — NOT a screenshot. All values are prop-driven so
 * it stays a small edit (not a re-screenshot) when the real dashboard evolves.
 *
 * See CLAUDE.md › "Voice & UI › Visuals: NO screenshots — build live previews".
 */
import type { Locale } from '@/i18n/utils'
import WindowFrame from './WindowFrame.astro'

interface Props {
	locale: Locale
	/** Primary result, e.g. "1.24" */
	doseRate?: string
	doseUnit?: string
	/** Operational quantity label shown under the result, e.g. "H*(10)" */
	coefficient?: string
	doseWithoutShield?: string
	doseWithShield?: string
	class?: string
}

const {
	locale,
	doseRate = '1.24',
	doseUnit = 'mSv/h',
	coefficient = 'H*(10)',
	doseWithoutShield = '4.80',
	doseWithShield = '1.24',
	class: className = '',
} = Astro.props

const isFr = locale === 'fr'
// Labels mirror the app's real strings (features/localisation/locales/{fr,en}.json).
const l = {
	params: isFr ? 'Paramètres' : 'Parameters',
	radionuclide: isFr ? 'Radionucléide' : 'Radionuclide',
	activity: isFr ? 'Activité' : 'Activity',
	distance: isFr ? 'Distance' : 'Distance',
	shield: isFr ? 'Écran' : 'Shield',
	run: isFr ? 'Lancer le calcul' : 'Run calculation',
	result: isFr ? 'Résultat' : 'Result',
	resultLabel: isFr ? 'Débit de dose' : 'Dose rate',
	details: isFr ? 'Détails du calcul' : 'Calculation Details',
	without: isFr ? 'Débit de dose sans écran' : 'Dose rate without shields',
	with: isFr ? 'Débit de dose avec écrans' : 'Dose rate with shields',
}

const fields = [
	{ label: l.radionuclide, value: 'Ir-192' },
	{ label: l.activity, value: '370 GBq' },
	{ label: l.distance, value: '100 cm' },
	{ label: l.shield, value: 'Pb · 10 mm' },
]

// Collapsed app-sidebar rail: Débit de dose (active), Historique, Inventaire,
// Éditeur de zones, Études de poste — the app's Gamma + Conformité nav.
const rail = [
	{ active: true, svg: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z"/>' },
	{ active: false, svg: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/>' },
	{ active: false, svg: '<path d="M3 12h.01"/><path d="M3 18h.01"/><path d="M3 6h.01"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M8 6h13"/>' },
	{ active: false, svg: '<path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/>' },
	{ active: false, svg: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>' },
]
---

<WindowFrame class={className}>
	<div class="flex">
		<!-- collapsed app sidebar (Gamma + Conformité nav) -->
		<div class="hidden w-11 shrink-0 flex-col items-center gap-1 border-r border-border bg-muted/30 py-3 md:flex" aria-hidden="true">
			{rail.map((item) => (
				<span
					class:list={[
						'flex h-8 w-8 items-center justify-center rounded-md',
						item.active ? 'bg-primary/10 text-primary' : 'text-muted-foreground',
					]}
				>
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.svg} />
				</span>
			))}
		</div>

		<!-- app body -->
		<div class="grid flex-1 gap-4 p-4 sm:p-5 md:grid-cols-2">
			<!-- inputs -->
			<div class="rounded-lg border bg-card p-4 shadow-sm">
				<h3 class="mb-3 flex items-center gap-2 text-sm font-semibold text-foreground">
					<span class="h-2 w-2 rounded-full bg-slate-400" aria-hidden="true"></span>
					{l.params}
				</h3>
				<div class="space-y-2.5">
					{fields.map((f) => (
						<div>
							<div class="mb-1 text-xs text-muted-foreground">{f.label}</div>
							<div class="flex h-9 items-center rounded-md border border-input bg-background px-3 text-sm text-foreground">
								{f.value}
							</div>
						</div>
					))}
				</div>
				<div class="mt-3 flex h-9 w-full items-center justify-center rounded-md bg-primary text-sm font-medium text-primary-foreground">
					{l.run}
				</div>
			</div>

			<!-- results -->
			<div class="space-y-4">
				<div class="rounded-lg border bg-card p-4 shadow-sm">
					<h3 class="mb-1 flex items-center gap-2 text-sm font-semibold text-foreground">
						<span class="h-2 w-2 rounded-full bg-green-500" aria-hidden="true"></span>
						{l.result}
					</h3>
					<p class="mb-3 text-xs text-muted-foreground">{l.resultLabel}</p>
					<div class="rounded-lg border bg-muted/50 p-4 text-center">
						<p class="mb-1 text-2xl font-bold text-primary tabular-nums">
							{doseRate}<span class="ml-1 text-base font-semibold text-muted-foreground">{doseUnit}</span>
						</p>
						<p class="text-xs text-muted-foreground">{coefficient}</p>
					</div>
				</div>

				<div class="rounded-lg border bg-card p-4 shadow-sm">
					<h3 class="mb-3 flex items-center gap-2 text-sm font-semibold text-foreground">
						<span class="h-2 w-2 rounded-full bg-orange-500" aria-hidden="true"></span>
						{l.details}
					</h3>
					<div class="grid grid-cols-2 gap-3">
						<div class="rounded-lg bg-muted/30 p-3 text-center">
							<p class="text-base font-semibold text-foreground tabular-nums">
								{doseWithoutShield}<span class="ml-1 text-xs font-normal text-muted-foreground">{doseUnit}</span>
							</p>
							<p class="text-xs text-muted-foreground">{l.without}</p>
						</div>
						<div class="rounded-lg bg-muted/30 p-3 text-center">
							<p class="text-base font-semibold text-foreground tabular-nums">
								{doseWithShield}<span class="ml-1 text-xs font-normal text-muted-foreground">{doseUnit}</span>
							</p>
							<p class="text-xs text-muted-foreground">{l.with}</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</WindowFrame>
