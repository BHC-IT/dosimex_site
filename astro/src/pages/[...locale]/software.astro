---
import Layout from '@/layouts/Layout.astro'
import VideoEmbed from '@/components/VideoEmbed.astro'
import { getTranslations, getLocalePaths, localePath, type Locale } from '@/i18n/utils'
import { organizationSchema } from '@/data/schemas'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)
const isFr = locale === 'fr'
const s = t.software

const arrow = 'M5 12h14M12 5l7 7-7 7'

// Each pack gets a Proton-style eyebrow + icon so the catalogs read as
// distinct chapters rather than identical grids. The learning pack is
// presented on /learn — a compact cross-link keeps its place (and anchor) here.
const packs = [
	{
		id: 'pack-ope',
		data: s.packOpe,
		eyebrow: isFr ? 'Codes de calcul' : 'Calculation codes',
		icon: 'calc',
	},
	{
		id: 'pack-mes',
		data: s.packMes,
		eyebrow: isFr ? 'Mesure' : 'Measurement',
		icon: 'gauge',
	},
]
---

<Layout title={t.seo.software.title} description={t.seo.software.description} jsonLd={[organizationSchema]}>

	<!-- ══════════ HERO ══════════ -->
	<section class="relative py-20 lg:py-28">
		<!-- Decorative backdrop bleeding into the sections below — proton-style. -->
		<div class="absolute inset-0 -z-10" aria-hidden="true">
			<div class="absolute -bottom-40 -right-[14rem] h-[380px] w-[500px] rounded-full bg-primary/20 blur-3xl dark:bg-primary/10"></div>
			<div class="absolute -bottom-56 -right-[16rem] h-[280px] w-[360px] rounded-full bg-brandred/[0.16] blur-3xl dark:bg-brandred/[0.14]"></div>
			<div class="bg-dots absolute inset-0 opacity-70 [mask-image:radial-gradient(ellipse_at_center,black,transparent_70%)]"></div>
		</div>

		<div class="relative mx-auto max-w-7xl px-6">
			<h1 class="text-balance text-4xl font-heading font-bold tracking-tight text-foreground md:text-5xl">
				{s.header.title}
			</h1>
			<p class="mt-6 max-w-3xl text-lg text-muted-foreground leading-relaxed">
				{s.header.description}
			</p>
			<p class="mt-4 inline-flex items-center gap-2 text-sm text-muted-foreground">
				<svg class="h-4 w-4 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="10" />
					<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
					<path d="M2 12h20" />
				</svg>
				{s.header.langNote}
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				{s.header.anchors.map((anchor) => (
					<a
						href={anchor.href}
						class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-4 py-1.5 text-sm font-heading font-semibold text-primary transition-colors duration-150 hover:bg-primary/15"
					>
						{anchor.label}
						<span aria-hidden="true">&darr;</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ INCLUDED & PREREQUISITES ══════════ -->
	<section class="pb-4 md:pb-8">
		<div class="mx-auto max-w-7xl px-6">
			<div class="grid gap-6 md:grid-cols-2">
				{[s.included, s.prerequisites].map((item) => (
					<div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
						<h2 class="text-sm font-heading font-semibold uppercase tracking-widest text-primary">{item.title}</h2>
						<p class="mt-3 text-sm text-muted-foreground leading-relaxed">{item.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ PACKS ══════════ -->
	{packs.map((pack, packIndex) => (
		<>
			<section id={pack.id} class="py-16 md:py-24">
				<div class="mx-auto max-w-7xl px-6">
					<div class="max-w-3xl">
						<div class="flex items-center gap-3">
							<span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
								{pack.icon === 'calc' && (
									<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><line x1="8" x2="8" y1="14" y2="14"/><line x1="12" x2="12" y1="14" y2="14"/><line x1="8" x2="8" y1="18" y2="18"/><line x1="12" x2="12" y1="18" y2="18"/></svg>
								)}
								{pack.icon === 'gauge' && (
									<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
								)}
							</span>
							<p class="text-sm font-semibold uppercase tracking-widest text-primary">{pack.eyebrow}</p>
						</div>
						<h2 class="mt-4 text-3xl font-heading font-semibold tracking-tight text-foreground md:text-4xl">{pack.data.title}</h2>
						<p class="mt-4 text-lg text-muted-foreground leading-relaxed">{pack.data.description}</p>
					</div>

					<div class="mt-12 grid gap-6 lg:grid-cols-2">
						{pack.data.tools.map((tool) => (
							<div class="group flex flex-col rounded-2xl bg-card p-8 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:shadow-primary/5">
								<div class="flex items-start justify-between gap-3">
									<h3 class="text-lg font-heading font-semibold text-foreground">{tool.name}</h3>
									<span class:list={[
										"shrink-0 rounded-full px-2.5 py-0.5 text-xs font-heading font-semibold",
										tool.frOnly
											? "bg-muted text-muted-foreground"
											: "bg-primary/10 text-primary"
									]}>
										{tool.frOnly ? 'FR' : 'FR / EN'}
									</span>
								</div>
								<p class="mt-3 text-sm text-muted-foreground leading-relaxed">{tool.description}</p>
								{tool.videoId && (
									<div class="mt-5 overflow-hidden rounded-xl">
										<VideoEmbed videoId={tool.videoId} title={tool.name} />
									</div>
								)}
							</div>
						))}
					</div>
				</div>
			</section>

			{packIndex === 0 && (
				<section id="pack-peda" class="py-8 md:py-12">
					<div class="mx-auto max-w-7xl px-6">
						<a
							href={localePath(locale, '/learn')}
							class="group flex flex-col gap-6 rounded-2xl border border-primary/20 bg-primary/5 p-8 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:shadow-primary/5 md:flex-row md:items-center md:justify-between"
							data-ph-cta="software_learn_pack"
						>
							<div class="flex items-start gap-4">
								<span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
									<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
								</span>
								<div>
									<h2 class="text-lg font-heading font-semibold text-foreground">{s.learnPeda.title}</h2>
									<p class="mt-2 max-w-3xl text-sm text-muted-foreground leading-relaxed">{s.learnPeda.text}</p>
								</div>
							</div>
							<span class="inline-flex shrink-0 items-center gap-2 font-heading font-semibold text-primary">
								{s.learnPeda.linkLabel}
								<svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d={arrow}/></svg>
							</span>
						</a>
					</div>
				</section>
			)}
		</>
	))}

	<!-- ══════════ MORE RESOURCES ══════════ -->
	<section class="py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-6">
			<p class="text-sm font-semibold uppercase tracking-widest text-primary">{isFr ? 'Ressources' : 'Resources'}</p>
			<h2 class="mt-3 text-3xl font-heading font-semibold tracking-tight text-foreground md:text-4xl">{s.more.title}</h2>
			<ul class="mt-10 grid gap-x-8 gap-y-1 sm:grid-cols-2">
				{s.more.links.map((link) => (
					<li>
						<a
							href={'pdf' in link ? link.href : localePath(locale, link.href)}
							target={'pdf' in link ? '_blank' : undefined}
							rel={'pdf' in link ? 'noopener noreferrer' : undefined}
							class="group flex items-center justify-between gap-4 rounded-2xl px-5 py-4 transition-all duration-200 hover:bg-card hover:shadow-md"
						>
							<span class="flex items-center gap-3 font-heading font-semibold text-foreground transition-colors group-hover:text-primary">
								{'pdf' in link && (
									<svg class="h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
								)}
								{link.label}
							</span>
							<svg class="h-4 w-4 shrink-0 text-primary transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								{'pdf' in link
									? <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
									: <path d={arrow} />}
							</svg>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- ══════════ CONTACT CTA ══════════ -->
	<section class="py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-6">
			<div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary/[0.12] via-primary/[0.05] to-transparent p-10 text-center md:p-14">
				<div class="relative mx-auto max-w-2xl">
					<h2 class="text-3xl font-heading font-bold tracking-tight text-foreground md:text-4xl">{s.ask.title}</h2>
					<p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground">
						{s.ask.text}
					</p>
					<div class="mt-9 flex justify-center">
						<a
							href={localePath(locale, '/contact')}
							class="btn btn-primary"
							data-ph-cta="contact_us"
						>
							{s.ask.labelButton}
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d={arrow}/></svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

</Layout>
