---
import Layout from '@/layouts/Layout.astro'
import VideoEmbed from '@/components/VideoEmbed.astro'
import { getTranslations, getLocalePaths, localePath, type Locale } from '@/i18n/utils'
import { videoIds } from '@/data/videos'
import { organizationSchema } from '@/data/schemas'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)
const isFr = locale === 'fr'
const tr = t.training

const arrow = 'M5 12h14M12 5l7 7-7 7'

// Format facts — pulled from the intro copy so the hero states the practical
// shape of a session at a glance (fits training content, not a software catalog).
const facts = isFr
	? ['1 à 3 jours', 'Intra-entreprise', 'Sur site ou visio', 'Travaux dirigés']
	: ['1 to 3 days', 'On-premise', 'On-site or remote', 'Hands-on workshops']
---

<Layout title={t.seo.training.title} description={t.seo.training.description} jsonLd={[organizationSchema]}>

	<!-- ══════════ HERO ══════════ -->
	<section class="py-20 lg:py-28">
		<div class="mx-auto max-w-7xl px-6">
			<div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
				<div>
					<h1 class="text-balance text-4xl font-heading font-bold tracking-tight text-foreground md:text-5xl">
						{tr.header.title}
					</h1>
					<p class="mt-6 max-w-xl text-lg text-muted-foreground leading-relaxed">
						{tr.header.description}
					</p>
					<ul class="mt-8 flex flex-wrap gap-2">
						{facts.map((fact) => (
							<li class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3.5 py-1.5 text-sm font-heading font-semibold text-foreground/80">
								<span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true"></span>
								{fact}
							</li>
						))}
					</ul>
					<div class="mt-9 flex flex-wrap items-center gap-4">
						<a
							href={localePath(locale, '/contact')}
							class="btn btn-primary"
							data-ph-cta="training-quote"
						>
							{isFr ? 'Demander un devis' : 'Request a quote'}
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d={arrow}/></svg>
						</a>
						<a href="#themes" class="btn btn-secondary">
							{isFr ? 'Voir les thématiques' : 'See the topics'}
							<span aria-hidden="true">&darr;</span>
						</a>
					</div>
				</div>

				<div class="relative">
					<!-- Soft blue glow blooming under the video — Proton preview pattern. -->
					<div class="pointer-events-none absolute -inset-4 -z-10 rounded-[2.5rem] bg-primary/20 blur-3xl lg:-inset-8" aria-hidden="true"></div>
					<div class="pointer-events-none absolute -bottom-8 left-1/2 -z-10 h-24 w-4/5 -translate-x-1/2 rounded-full bg-primary/30 blur-3xl lg:-bottom-12 lg:h-44" aria-hidden="true"></div>
					<VideoEmbed videoId={videoIds.training} title={tr.videoTitle} />
				</div>
			</div>
		</div>
	</section>

	<!-- ══════════ THEMES (real-world cases) ══════════ -->
	<section id="themes" class="scroll-mt-24 py-16 md:py-24">
		<div class="reveal mx-auto max-w-7xl px-6">
			<div class="max-w-3xl">
				<h2 class="text-3xl font-heading font-semibold tracking-tight text-foreground md:text-4xl">
					{isFr ? 'Thématiques abordées' : 'Topics we cover'}
				</h2>
				<p class="mt-4 text-lg text-muted-foreground leading-relaxed">{tr.section1.title}</p>
			</div>

			<ul class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{tr.section1.items.map((item) => (
					<li class="group flex items-start gap-3 rounded-xl border border-border bg-card px-4 py-3.5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5">
						<svg class="mt-0.5 h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
						<span class="text-sm text-foreground/80 leading-snug">{item}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- ══════════ PARTNER (Veolia Nuclear Solutions) ══════════ -->
	<section class="py-16 md:py-24">
		<div class="reveal mx-auto max-w-7xl px-6">
			<div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
				<div>
					<h2 class="text-3xl font-heading font-semibold tracking-tight text-foreground md:text-4xl">
						{isFr ? 'Avec Veolia Nuclear Solutions' : 'With Veolia Nuclear Solutions'}
					</h2>
					<p class="mt-4 text-lg text-muted-foreground leading-relaxed">{tr.section2.title}</p>
					<ul class="mt-8 grid gap-3 sm:grid-cols-2">
						{tr.section2.items.map((item) => (
							<li class="flex items-center gap-3 rounded-xl bg-primary/[0.06] px-4 py-3 text-sm font-heading font-semibold text-foreground/80">
								<svg class="h-4 w-4 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
								{item}
							</li>
						))}
					</ul>
					<a
						href="/Folders/Catalogue formation VNS v7.pdf"
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-primary mt-8"
						data-ph-cta="download_catalog"
					>
						{tr.section2.button}
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
						</svg>
					</a>
				</div>

				<div class="relative lg:order-last">
					<div class="absolute -inset-6 -z-10 rounded-[2rem] bg-primary/10 blur-3xl" aria-hidden="true"></div>
					<img
						src="/Images/formation.png"
						alt={isFr ? 'Formation Dosimex en radioprotection' : 'Dosimex radiation protection training'}
						class="w-full rounded-2xl shadow-xl shadow-primary/5"
						loading="lazy"
						width="800"
						height="600"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- ══════════ CONTACT CTA ══════════ -->
	<section class="py-16 md:py-24">
		<div class="reveal mx-auto max-w-7xl px-6">
			<div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary/[0.12] via-primary/[0.05] to-transparent p-10 text-center md:p-14">
				<div class="relative mx-auto max-w-2xl">
					<h2 class="text-3xl font-heading font-bold tracking-tight text-foreground md:text-4xl">{tr.questions.title}</h2>
					<p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground">
						{tr.questions.text}
					</p>
					<div class="mt-9 flex justify-center">
						<a
							href={localePath(locale, '/contact')}
							class="btn btn-primary"
							data-ph-cta="contact_us"
						>
							{tr.questions.button}
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d={arrow}/></svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

</Layout>
