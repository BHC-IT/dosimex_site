---
/**
 * Annotated Dosismart dashboard tour.
 *
 * A stylized browser frame reproducing the real app's sidebar. Hovering,
 * focusing or tapping an entry highlights it and swaps the explanation in
 * the main panel (tablist/tabpanel semantics, arrow-key navigation).
 * Entry 1 is active by default so the panel is never empty without JS.
 */
interface Entry {
	icon: string
	label: string
	text: string
	badge?: string
}

interface Props {
	entries: readonly Entry[]
	caption: string
	label?: string
}

const { entries, caption, label = 'Dosismart' } = Astro.props
const uid = Math.random().toString(36).slice(2, 8)
---

<div class="rounded-xl border border-border bg-card shadow-lg overflow-hidden" data-dash-tour>
	<!-- Browser chrome -->
	<div class="flex items-center gap-3 border-b border-border bg-muted/60 px-4 py-2.5">
		<div class="flex items-center gap-1.5" aria-hidden="true">
			<span class="h-2.5 w-2.5 rounded-full bg-red-400/80"></span>
			<span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
			<span class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></span>
		</div>
		<div class="mx-auto flex items-center gap-1.5 rounded-md border border-border bg-background px-3 py-1 text-xs text-muted-foreground">
			<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<rect x="3" y="11" width="18" height="11" rx="2" />
				<path d="M7 11V7a5 5 0 0 1 10 0v4" />
			</svg>
			dosismart.com
		</div>
		<div class="w-12" aria-hidden="true"></div>
	</div>

	<!-- Sidebar + panel -->
	<div class="grid sm:grid-cols-[230px_1fr]">
		<nav
			class="border-b border-border bg-muted/30 p-2 sm:border-b-0 sm:border-r"
			role="tablist"
			aria-label={label}
			aria-orientation="vertical"
		>
			{entries.map((entry, i) => (
				<>
					{i === 5 && <div class="my-2 border-t border-border" aria-hidden="true"></div>}
					<button
						type="button"
						role="tab"
						id={`tour-${uid}-tab-${i}`}
						aria-controls={`tour-${uid}-panel-${i}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						tabindex={i === 0 ? 0 : -1}
						data-tour-tab
						class="group flex w-full items-center gap-2.5 rounded-md px-3 py-2 text-left text-sm font-medium text-muted-foreground transition-colors duration-150 hover:bg-muted hover:text-foreground aria-selected:bg-primary/10 aria-selected:text-primary"
					>
						<span class="shrink-0" aria-hidden="true">
							{entry.icon === 'calc' && (
								<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><line x1="8" x2="8" y1="14" y2="14"/><line x1="12" x2="12" y1="14" y2="14"/><line x1="8" x2="8" y1="18" y2="18"/><line x1="12" x2="12" y1="18" y2="18"/><line x1="8" x2="8" y1="10" y2="10"/><line x1="12" x2="12" y1="10" y2="10"/><line x1="16" x2="16" y1="10" y2="10"/></svg>
							)}
							{entry.icon === 'history' && (
								<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
							)}
							{entry.icon === 'inventory' && (
								<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="5" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
							)}
							{entry.icon === 'map' && (
								<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg>
							)}
							{entry.icon === 'doc' && (
								<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
							)}
							{entry.icon === 'download' && (
								<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
							)}
							{entry.icon === 'team' && (
								<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
							)}
						</span>
						<span class="flex-1">{entry.label}</span>
						{entry.badge && (
							<span class="shrink-0 rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary">{entry.badge}</span>
						)}
						<span class="relative hidden h-1.5 w-1.5 shrink-0 group-aria-selected:block" aria-hidden="true">
							<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-60"></span>
							<span class="relative block h-1.5 w-1.5 rounded-full bg-primary"></span>
						</span>
					</button>
				</>
			))}
		</nav>

		<div class="min-h-[150px] p-6 sm:min-h-[220px] sm:p-8">
			{entries.map((entry, i) => (
				<div
					id={`tour-${uid}-panel-${i}`}
					role="tabpanel"
					aria-labelledby={`tour-${uid}-tab-${i}`}
					data-tour-panel
					class={i === 0 ? '' : 'hidden'}
				>
					<h4 class="flex items-center gap-2 font-heading font-semibold text-foreground">
						{entry.label}
						{entry.badge && (
							<span class="rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary">{entry.badge}</span>
						)}
					</h4>
					<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{entry.text}</p>
				</div>
			))}
		</div>
	</div>
</div>
<p class="mt-3 text-center text-xs text-muted-foreground">{caption}</p>

<script>
	function initDashTours() {
		document.querySelectorAll<HTMLElement>('[data-dash-tour]').forEach((root) => {
			if (root.dataset.init) return
			root.dataset.init = '1'

			const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tour-tab]'))
			const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-tour-panel]'))

			function activate(index: number, focus = false) {
				tabs.forEach((tab, j) => {
					tab.setAttribute('aria-selected', j === index ? 'true' : 'false')
					tab.tabIndex = j === index ? 0 : -1
				})
				panels.forEach((panel, j) => panel.classList.toggle('hidden', j !== index))
				if (focus) tabs[index].focus()
			}

			tabs.forEach((tab, i) => {
				tab.addEventListener('mouseenter', () => activate(i))
				tab.addEventListener('click', () => activate(i))
				tab.addEventListener('focus', () => activate(i))
				tab.addEventListener('keydown', (e) => {
					if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
						e.preventDefault()
						activate((i + 1) % tabs.length, true)
					} else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
						e.preventDefault()
						activate((i - 1 + tabs.length) % tabs.length, true)
					} else if (e.key === 'Home') {
						e.preventDefault()
						activate(0, true)
					} else if (e.key === 'End') {
						e.preventDefault()
						activate(tabs.length - 1, true)
					}
				})
			})
		})
	}

	initDashTours()
	document.addEventListener('astro:page-load', initDashTours)
</script>
