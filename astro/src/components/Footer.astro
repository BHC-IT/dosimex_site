---
import { localePath, type Translations, type Locale } from '@/i18n/utils'
import { videoIds } from '@/data/videos'
import ObfuscatedEmail from '@/components/ObfuscatedEmail.astro'

interface Props {
	t: Translations
	locale: Locale
}

const { t, locale } = Astro.props
const year = new Date().getFullYear()
---

<footer>
	<div class="mx-auto max-w-7xl px-6 pt-28 pb-8 md:pt-40">
		<div class="flex flex-col gap-12 lg:flex-row lg:justify-between lg:gap-16">
			<!-- Brand block -->
			<div class="max-w-xs">
				<a href={localePath(locale, '/')}>
					<img src="/Images/logo_dosimex_blue.webp" alt="Dosimex" class="h-7 w-auto" loading="lazy" />
				</a>
				<p class="mt-4 text-sm text-muted-foreground">
					{locale === 'fr' ? 'Outils de calculs en radioprotection.' : 'Radiation protection calculation tools.'}
				</p>
			</div>

			<!-- Link columns -->
			<div class="grid grid-cols-2 gap-10 sm:grid-cols-4 lg:gap-16">
				<!-- Software -->
				<div>
					<h3 class="mb-4 text-sm font-heading font-semibold text-foreground">
						{t.footer.columns.software}
					</h3>
					<ul class="space-y-3 text-sm">
						<li><a href={localePath(locale, '/dosismart')} class="text-muted-foreground transition-colors hover:text-primary">{t.navbar.dosismart}</a></li>
						<li><a href={localePath(locale, '/software')} class="text-muted-foreground transition-colors hover:text-primary">{t.navbar.suite}</a></li>
						<li><a href={localePath(locale, '/product')} class="text-muted-foreground transition-colors hover:text-primary">{t.navbar.pricing}</a></li>
					</ul>
				</div>

				<!-- Resources -->
				<div>
					<h3 class="mb-4 text-sm font-heading font-semibold text-foreground">
						{t.footer.columns.resources}
					</h3>
					<ul class="space-y-3 text-sm">
						<li><a href={localePath(locale, '/learn')} class="text-muted-foreground transition-colors hover:text-primary">{t.navbar.learn}</a></li>
						<li><a href={localePath(locale, '/manuals')} class="text-muted-foreground transition-colors hover:text-primary">{t.navbar.documentation}</a></li>
						<li><a href={localePath(locale, '/books')} class="text-muted-foreground transition-colors hover:text-primary">{t.navbar.books}</a></li>
						<li><a href={localePath(locale, '/blog')} class="text-muted-foreground transition-colors hover:text-primary">{t.navbar.blog}</a></li>
						<li><a href={videoIds.channelUrl} target="_blank" rel="noopener noreferrer" class="text-muted-foreground transition-colors hover:text-primary">YouTube</a></li>
					</ul>
				</div>

				<!-- Company -->
				<div>
					<h3 class="mb-4 text-sm font-heading font-semibold text-foreground">
						{t.footer.columns.company}
					</h3>
					<ul class="space-y-3 text-sm">
						<li><a href={localePath(locale, '/about')} class="text-muted-foreground transition-colors hover:text-primary">{t.navbar.story}</a></li>
						<li><a href={localePath(locale, '/training')} class="text-muted-foreground transition-colors hover:text-primary">{t.navbar.training}</a></li>
						<li><a href={localePath(locale, '/references')} class="text-muted-foreground transition-colors hover:text-primary">{t.navbar.references}</a></li>
						<li><a href={localePath(locale, '/contact')} class="text-muted-foreground transition-colors hover:text-primary">{t.navbar.contact}</a></li>
						<li><a href="tel:+33689709035" class="text-muted-foreground transition-colors hover:text-primary">06 89 70 90 35</a></li>
						<li><ObfuscatedEmail user="alain.vivier" domain="dosimex.fr" class="text-muted-foreground transition-colors hover:text-primary" /></li>
					</ul>
				</div>

				<!-- Legal -->
				<div>
					<h3 class="mb-4 text-sm font-heading font-semibold text-foreground">
						{locale === 'fr' ? 'Légal' : 'Legal'}
					</h3>
					<ul class="space-y-3 text-sm">
						<li><a href={localePath(locale, '/legal')} class="text-muted-foreground transition-colors hover:text-primary">{locale === 'fr' ? 'Mentions légales' : 'Legal notice'}</a></li>
						<li><a href={localePath(locale, '/privacy')} class="text-muted-foreground transition-colors hover:text-primary">{locale === 'fr' ? 'Confidentialité' : 'Privacy policy'}</a></li>
						<li><a href={localePath(locale, '/terms')} class="text-muted-foreground transition-colors hover:text-primary">{locale === 'fr' ? 'CGU' : 'Terms of use'}</a></li>
						<li><button id="manage-cookies-footer" type="button" class="cursor-pointer text-muted-foreground transition-colors hover:text-primary">{t.footer.manageCookies}</button></li>
					</ul>
				</div>
			</div>
		</div>

		<!-- Bottom bar -->
		<div class="mt-16 flex flex-col-reverse items-start gap-6 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-sm text-muted-foreground">
				&copy; {year} Dosimex. {locale === 'fr' ? 'Tous droits réservés.' : 'All rights reserved.'}
			</p>
			<div class="flex items-center gap-4">
				<!-- LinkedIn -->
				<a href="https://www.linkedin.com/company/dosimex" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-muted-foreground transition-colors hover:text-primary">
					<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
				</a>
				<!-- YouTube -->
				<a href={videoIds.channelUrl} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-muted-foreground transition-colors hover:text-primary">
					<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
				</a>
			</div>
		</div>
	</div>
</footer>

<script>
	import * as CookieConsent from 'vanilla-cookieconsent'

	function initFooterCookies() {
		document.getElementById('manage-cookies-footer')?.addEventListener('click', () => {
			CookieConsent.showPreferences()
		})
	}
	initFooterCookies()
	document.addEventListener('astro:page-load', initFooterCookies)
</script>
