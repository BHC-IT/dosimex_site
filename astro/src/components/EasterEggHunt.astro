---
import type { Translations, Locale } from '@/i18n/utils'

interface Props {
	t: Translations
	locale: Locale
}

const { t } = Astro.props

// Radiation trefoil (central disc + three 60°-wide blades, 60° gaps) drawn as
// an SVG path so it renders identically everywhere (no emoji font variance).
// 16×16 viewBox, centred at (8,8); blades point up / lower-right / lower-left.
const trefoilPath = ((): string => {
	const cx = 8
	const cy = 8
	const ri = 2.4
	const ro = 7
	const pt = (r: number, deg: number): string => {
		const a = (deg * Math.PI) / 180
		return `${(cx + r * Math.cos(a)).toFixed(2)},${(cy + r * Math.sin(a)).toFixed(2)}`
	}
	const blade = (base: number): string =>
		`M${pt(ri, base - 30)} A${ri},${ri} 0 0 1 ${pt(ri, base + 30)} L${pt(ro, base + 30)} A${ro},${ro} 0 0 0 ${pt(ro, base - 30)} Z`
	return [-90, 30, 150].map(blade).join(' ')
})()
---

<!-- Easter Egg Hunt: serialised copy for the client script -->
<script type="application/json" id="egg-copy" set:html={JSON.stringify(t.easterEgg)}></script>

<!-- Spotlight mascot: a bright copy of the navbar mascot, shown above the dim
     overlay so Dosi stays visible while he speaks. Aligned to the real one at
     runtime (see syncSpotlight). -->
<img id="egg-spotlight-mascot" src="/Images/bonhomme_dosi.gif" alt="" class="hidden fixed z-[80] pointer-events-none" />

<!-- ─── INTRO MODAL ────────────────────────────────────────────────────── -->
<div id="egg-intro-overlay" role="dialog" aria-modal="true" aria-labelledby="egg-intro-title"
	class="hidden fixed inset-0 z-[70] bg-background/70 backdrop-blur-sm">
	<div class="absolute left-6 top-[4.5rem] w-80 max-w-[calc(100vw-3rem)] rounded-2xl border border-border bg-card p-5 shadow-xl lg:left-16">
		<!-- Tail pointing up to the navbar mascot -->
		<div class="absolute -top-1.5 left-6 h-3 w-3 rotate-45 border-l border-t border-border bg-card" aria-hidden="true"></div>
		<h2 id="egg-intro-title" class="mb-2 text-base font-heading font-semibold leading-tight text-foreground"></h2>
		<p id="egg-intro-body" class="text-sm text-muted-foreground mb-5"></p>
		<button id="egg-intro-cta" type="button"
			class="w-full bg-primary text-primary-foreground rounded-lg px-4 py-2 text-sm font-medium hover:bg-primary/90 transition-colors">
		</button>
	</div>
</div>

<!-- ─── GEIGER WIDGET ──────────────────────────────────────────────────── -->
<div id="egg-widget" aria-label="Geiger counter"
	class="hidden fixed bottom-4 right-4 z-[60] rounded-xl border border-border bg-card shadow-lg p-3 w-56">
	<!-- Header -->
	<div class="flex items-center justify-between mb-2">
		<span class="flex items-center gap-1.5">
			<svg viewBox="0 0 16 16" class="h-4 w-4 text-yellow-500 dark:text-yellow-400" aria-hidden="true">
				<circle cx="8" cy="8" r="1.5" fill="currentColor" />
				<path d={trefoilPath} fill="currentColor" />
			</svg>
			<span id="egg-widget-label" class="text-xs font-heading font-semibold text-foreground uppercase tracking-wide"></span>
		</span>
		<div class="flex items-center gap-2">
			<span class="text-xs text-muted-foreground">
				<span data-egg-count>0</span>/5
				<span id="egg-widget-progress"></span>
			</span>
			<button id="egg-widget-close" type="button"
				class="flex h-5 w-5 items-center justify-center rounded text-muted-foreground leading-none transition-colors hover:bg-muted hover:text-foreground">
				<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</button>
		</div>
	</div>

	<!-- Analog dial -->
	<div class="flex justify-center my-1">
		<svg viewBox="0 0 100 56" class="w-full max-w-[180px]" aria-hidden="true">
			<defs>
				<linearGradient id="egg-gauge-grad" x1="0" y1="0" x2="1" y2="0">
					<stop offset="0%" stop-color="#22C55E" />
					<stop offset="50%" stop-color="#EAB308" />
					<stop offset="100%" stop-color="#EF4444" />
				</linearGradient>
			</defs>
			<!-- Single green → yellow → red scale arc -->
			<path
				d="M14,52 A36,36 0 0,1 86,52"
				fill="none"
				stroke="url(#egg-gauge-grad)"
				stroke-width="7"
				stroke-linecap="round"
			/>
			<!-- Pivot dot -->
			<circle cx="50" cy="52" r="3.5" fill="currentColor" class="text-foreground" />
			<!-- Needle -->
			<g data-egg-needle
				style="transform-box: fill-box; transform-origin: 50% 100%; transform: rotate(var(--egg-angle, -80deg)); transition: transform 120ms ease-out;">
				<line x1="50" y1="52" x2="50" y2="18"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					class="text-foreground" />
				<circle cx="50" cy="18" r="2" fill="currentColor" class="text-foreground" />
			</g>
		</svg>
	</div>

	<!-- Digital readout -->
	<div class="text-center text-xs tabular-nums text-foreground mb-1">
		<span data-egg-cps>0</span> cps
	</div>
	<div class="text-center text-xs tabular-nums text-muted-foreground mb-2">
		<span id="egg-widget-dose-label"></span>: <span data-egg-dose>0.0</span> µSv
	</div>

	<!-- Hint -->
	<p id="egg-widget-hint" class="text-xs text-muted-foreground text-center leading-tight"></p>
</div>

<!-- ─── REVEAL PANEL ───────────────────────────────────────────────────── -->
<div id="egg-reveal-overlay" role="dialog" aria-modal="true" aria-labelledby="egg-reveal-title"
	class="hidden fixed inset-0 z-[70] bg-background/70 backdrop-blur-sm">
	<div class="absolute left-6 top-[4.5rem] w-80 max-w-[calc(100vw-3rem)] rounded-2xl border border-border bg-card p-5 shadow-xl lg:left-16">
		<div class="absolute -top-1.5 left-6 h-3 w-3 rotate-45 border-l border-t border-border bg-card" aria-hidden="true"></div>
		<h3 id="egg-reveal-title" class="mb-2 text-base font-heading font-semibold text-foreground"></h3>
		<p id="egg-reveal-body" class="text-sm text-muted-foreground mb-4"></p>
		<!-- Cats placeholder (shown only when id === 'cats') -->
		<div id="egg-cats-block" class="hidden mb-4 flex flex-col items-center gap-2">
			<div class="rounded-lg border border-border bg-muted aspect-[3/4] w-40 flex items-center justify-center text-4xl">
				🐈
			</div>
			<p id="egg-cats-caption" class="text-xs text-muted-foreground"></p>
		</div>
		<button id="egg-reveal-next" type="button"
			class="w-full bg-primary text-primary-foreground rounded-lg px-4 py-2 text-sm font-medium hover:bg-primary/90 transition-colors">
		</button>
	</div>
</div>

<!-- ─── CERTIFICATE MODAL ──────────────────────────────────────────────── -->
<div id="egg-cert-overlay" role="dialog" aria-modal="true" aria-labelledby="egg-cert-title"
	class="hidden fixed inset-0 z-[70] bg-background/70 backdrop-blur-sm">
	<div class="absolute left-6 top-[4.5rem] w-80 max-w-[calc(100vw-3rem)] rounded-2xl border border-border bg-card p-5 shadow-xl lg:left-16 text-center">
		<div class="absolute -top-1.5 left-6 h-3 w-3 rotate-45 border-l border-t border-border bg-card" aria-hidden="true"></div>
		<h2 id="egg-cert-title" class="mb-2 text-lg font-heading font-semibold text-foreground"></h2>
		<span id="egg-cert-subtitle"
			class="inline-block rounded-full border border-border px-2.5 py-0.5 text-xs font-semibold text-primary mb-4">
		</span>
		<p id="egg-cert-body" class="text-sm text-muted-foreground mb-2"></p>
		<p id="egg-cert-dose" class="text-sm font-medium text-foreground mb-1"></p>
		<p id="egg-cert-signature" class="text-xs text-muted-foreground mb-1 italic"></p>
		<p id="egg-cert-serial" class="text-xs text-muted-foreground mb-5 font-mono"></p>
		<button id="egg-cert-close" type="button"
			class="w-full bg-primary text-primary-foreground rounded-lg px-4 py-2 text-sm font-medium hover:bg-primary/90 transition-colors">
		</button>
	</div>
</div>

<script>
	// ─── Types ──────────────────────────────────────────────────────────────
	type SourceId = 'banana' | 'cats' | 'zonage' | 'rpcirkus' | 'book'
	type HuntState = 'not-started' | 'armed' | 'done'

	interface HuntData {
		state: HuntState
		found: SourceId[]
		dismissed?: boolean
	}

	interface EggCopy {
		intro: { title: string; body: string; cta: string }
		widget: { label: string; progress: string; dose: string; hint: string; hintMobile: string }
		reveal: { counter: string; next: string }
		sources: Record<SourceId, string>
		catsPlaceholder: string
		certificate: {
			title: string
			subtitle: string
			body: string
			dose: string
			signature: string
			serial: string
			close: string
		}
	}

	// ─── Constants ──────────────────────────────────────────────────────────
	const STORAGE_KEY = 'dosimex-egghunt'
	// Doses in µSv. One banana ≈ 100 nSv = 0.1 µSv (banana equivalent dose).
	// Four real sources at ~0.1 µSv each → 0.4 µSv total = "a few bananas".
	// RP Cirkus is 0 — it's a "source of information", not a radioactive one.
	const SOURCE_DOSES: Record<SourceId, number> = {
		banana: 0.1,
		cats: 0.1,
		zonage: 0.1,
		rpcirkus: 0.0,
		book: 0.1,
	}
	const TOTAL = 5

	// ─── Module-level guards ─────────────────────────────────────────────────
	let docListenersWired = false
	let pendingSourceId: SourceId | null = null
	let afterRevealCallback: (() => void) | null = null
	let spotlightObserved = false
	let isTouchDevice = false

	// ─── Storage helpers ─────────────────────────────────────────────────────
	function load(): HuntData {
		try {
			const raw = localStorage.getItem(STORAGE_KEY)
			if (!raw) return { state: 'not-started', found: [] }
			const parsed: unknown = JSON.parse(raw)
			if (
				parsed !== null &&
				typeof parsed === 'object' &&
				'state' in parsed &&
				'found' in parsed &&
				Array.isArray((parsed as HuntData).found)
			) {
				return parsed as HuntData
			}
		} catch {
			// ignore parse errors
		}
		return { state: 'not-started', found: [] }
	}

	function save(data: HuntData): void {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(data))
	}

	function deriveDose(found: SourceId[]): number {
		return found.reduce((acc, id) => acc + SOURCE_DOSES[id], 0)
	}

	// ─── DOM helpers ────────────────────────────────────────────────────────
	function el<T extends HTMLElement>(id: string): T | null {
		return document.getElementById(id) as T | null
	}

	function show(elem: HTMLElement | null): void {
		elem?.classList.remove('hidden')
	}

	function hide(elem: HTMLElement | null): void {
		elem?.classList.add('hidden')
	}

	function setText(id: string, text: string): void {
		const elem = el(id)
		if (elem) elem.textContent = text
	}

	// ─── Needle / cps update ────────────────────────────────────────────────
	function setNeedle(angleDeg: number, cps: number): void {
		const widget = el('egg-widget')
		if (widget) {
			widget.style.setProperty('--egg-angle', `${angleDeg}deg`)
		}
		const cpsEl = document.querySelector<HTMLElement>('[data-egg-cps]')
		if (cpsEl) cpsEl.textContent = String(Math.round(cps))
	}

	// Drive the needle from a point: nearest unfound source → higher reading.
	// On desktop the point is the cursor; on touch it is the viewport centre.
	function updateProximity(px: number, py: number): void {
		const currentData = load()
		if (currentData.state === 'not-started') return
		const unfound = Array.from(document.querySelectorAll<HTMLElement>('[data-egg-source]')).filter((sourceEl) => {
			const sid = sourceEl.dataset.eggSource as SourceId | undefined
			return sid !== undefined && !currentData.found.includes(sid)
		})
		if (unfound.length === 0) {
			setNeedle(-80, 0)
			return
		}
		let minDist = Infinity
		for (const sourceEl of unfound) {
			const rect = sourceEl.getBoundingClientRect()
			const cx = rect.left + rect.width / 2
			const cy = rect.top + rect.height / 2
			const dist = Math.sqrt((px - cx) ** 2 + (py - cy) ** 2)
			if (dist < minDist) minDist = dist
		}
		const NEAR = 60
		const FAR = 600
		const t = (Math.max(NEAR, Math.min(FAR, minDist)) - NEAR) / (FAR - NEAR)
		const jitter = t < 0.2 ? (Math.random() - 0.5) * 12 : 0
		setNeedle(80 - t * 160 + jitter, (1 - t) * (200 + Math.random() * 50))
	}

	// After a spike, settle back: touch recomputes from the scroll position,
	// desktop drops to idle (the next pointer move refines it).
	function settleNeedle(): void {
		if (isTouchDevice) updateProximity(window.innerWidth / 2, window.innerHeight / 2)
		else setNeedle(-80, 0)
	}

	function spikeNeedle(): void {
		setNeedle(80, 250 + Math.random() * 50)
		setTimeout(settleNeedle, 800)
	}

	// ─── Count & dose display ───────────────────────────────────────────────
	function updateCountDisplay(found: SourceId[]): void {
		const countEl = document.querySelector<HTMLElement>('[data-egg-count]')
		if (countEl) countEl.textContent = String(found.length)
		const doseEl = document.querySelector<HTMLElement>('[data-egg-dose]')
		if (doseEl) doseEl.textContent = deriveDose(found).toFixed(1)
	}

	// Keep a bright copy of the mascot pinned over the real (dimmed) navbar one
	// whenever a bubble is open, so Dosi is visible while he speaks.
	function syncSpotlight(): void {
		const spot = el('egg-spotlight-mascot')
		if (!spot) return
		const anyOpen = ['egg-intro-overlay', 'egg-reveal-overlay', 'egg-cert-overlay'].some((oid) => {
			const o = el(oid)
			return o !== null && !o.classList.contains('hidden')
		})
		const mascot = document.querySelector<HTMLElement>('[data-egg-mascot]')
		if (anyOpen && mascot) {
			// The navbar auto-hides on scroll; snap it back into view (without its
			// slide animation) so the mascot is on-screen and the spotlight aligns.
			const nav = document.getElementById('site-nav')
			if (nav) {
				nav.style.transition = 'none'
				nav.classList.remove('nav-hidden')
				nav.classList.add('nav-visible')
				void nav.offsetHeight
			}
			const r = mascot.getBoundingClientRect()
			spot.style.top = `${r.top}px`
			spot.style.left = `${r.left}px`
			spot.style.width = `${r.width}px`
			spot.style.height = `${r.height}px`
			show(spot)
			if (nav) requestAnimationFrame(() => { nav.style.transition = '' })
		} else {
			hide(spot)
		}
	}

	// ─── Certificate ────────────────────────────────────────────────────────
	function openCertificate(COPY: EggCopy, found: SourceId[]): void {
		const overlay = el('egg-cert-overlay')
		const serial = 'DSMX-' + Date.now().toString(36).toUpperCase().slice(-6)
		const dose = deriveDose(found).toFixed(1)

		setText('egg-cert-title', COPY.certificate.title)
		setText('egg-cert-subtitle', COPY.certificate.subtitle)
		setText('egg-cert-body', COPY.certificate.body)
		setText('egg-cert-dose', COPY.certificate.dose.replace('{dose}', dose))
		setText('egg-cert-signature', COPY.certificate.signature)
		setText('egg-cert-serial', COPY.certificate.serial.replace('{serial}', serial))
		setText('egg-cert-close', COPY.certificate.close)
		show(overlay)
	}

	// Closing the certificate ends the hunt: tuck the counter away too and
	// remember it so it stays hidden on later visits.
	function closeCertificate(): void {
		hide(el('egg-cert-overlay'))
		hide(el('egg-widget'))
		const data = load()
		data.dismissed = true
		save(data)
	}

	// ─── Reveal panel ───────────────────────────────────────────────────────
	function openReveal(COPY: EggCopy, id: SourceId, onNext: () => void): void {
		const overlay = el('egg-reveal-overlay')
		const data = load()

		const counterText = `${COPY.reveal.counter} ${data.found.length}/${TOTAL}`
		setText('egg-reveal-title', counterText)
		setText('egg-reveal-body', COPY.sources[id])
		setText('egg-reveal-next', COPY.reveal.next)

		const catsBlock = el('egg-cats-block')
		if (id === 'cats') {
			setText('egg-cats-caption', COPY.catsPlaceholder)
			show(catsBlock)
		} else {
			hide(catsBlock)
		}

		afterRevealCallback = onNext
		show(overlay)
	}

	// ─── Source activated ───────────────────────────────────────────────────
	function onSourceActivated(COPY: EggCopy, id: SourceId): void {
		const data = load()

		if (data.state === 'not-started') {
			pendingSourceId = id
			startHunt(COPY)
			return
		}

		if (data.found.includes(id)) return

		data.found.push(id)
		// Activating a source is intent to play — un-dismiss the HUD.
		data.dismissed = false
		save(data)

		show(el('egg-widget'))
		updateCountDisplay(data.found)
		spikeNeedle()

		const isDone = data.found.length >= TOTAL

		openReveal(COPY, id, () => {
			if (isDone) {
				data.state = 'done'
				save(data)
				openCertificate(COPY, data.found)
			}
		})
	}

	// ─── Start hunt ─────────────────────────────────────────────────────────
	function startHunt(COPY: EggCopy): void {
		const data = load()
		if (data.state === 'done') return

		data.state = 'armed'
		save(data)

		// Populate intro copy
		setText('egg-intro-title', COPY.intro.title)
		setText('egg-intro-body', COPY.intro.body)
		setText('egg-intro-cta', COPY.intro.cta)

		show(el('egg-intro-overlay'))
	}

	// ─── Init ────────────────────────────────────────────────────────────────
	function init(): void {
		// Parse copy from JSON script tag
		const copyEl = document.getElementById('egg-copy')
		const COPY: EggCopy | null = copyEl
			? ((): EggCopy | null => {
					try {
						return JSON.parse(copyEl.textContent ?? '{}') as EggCopy
					} catch {
						return null
					}
				})()
			: null

		if (!COPY) return

		// ── Populate static copy ───────────────────────────────────────────
		const isTouch = window.matchMedia('(hover: none), (pointer: coarse)').matches
		isTouchDevice = isTouch

		setText('egg-widget-label', COPY.widget.label)
		setText('egg-widget-progress', COPY.widget.progress)
		setText('egg-widget-dose-label', COPY.widget.dose)
		setText('egg-widget-hint', isTouch ? COPY.widget.hintMobile : COPY.widget.hint)

		// Localised aria-label for the widget close button (reuse "Close" copy)
		const closeBtn = el('egg-widget-close')
		if (closeBtn) closeBtn.setAttribute('aria-label', COPY.certificate.close)

		// ── Restore state ─────────────────────────────────────────────────
		// Auto-show only if armed/done AND the user hasn't dismissed the HUD.
		const data = load()
		if ((data.state === 'armed' || data.state === 'done') && !data.dismissed) {
			show(el('egg-widget'))
			updateCountDisplay(data.found)
			setNeedle(-80, 0)
		}

		// ── Mascot triple-click ────────────────────────────────────────────
		const mascot = document.querySelector<HTMLElement>('[data-egg-mascot]')
		if (mascot && !mascot.dataset.eggBound) {
			mascot.dataset.eggBound = '1'
			let clickCount = 0
			let lastClickTime = 0

			mascot.addEventListener('click', (e) => {
				const current = load()
				if (current.state === 'done') return

				e.preventDefault()
				e.stopPropagation()

				const now = Date.now()
				if (now - lastClickTime > 1000) {
					clickCount = 1
				} else {
					clickCount++
				}
				lastClickTime = now

				if (clickCount >= 3) {
					clickCount = 0
					startHunt(COPY)
				}
			})
		}

		// ── Sources on this page ───────────────────────────────────────────
		document.querySelectorAll<HTMLElement>('[data-egg-source]').forEach((sourceEl) => {
			if (sourceEl.dataset.eggBound) return
			sourceEl.dataset.eggBound = '1'

			const id = sourceEl.dataset.eggSource as SourceId | undefined
			if (!id || !(id in SOURCE_DOSES)) return

			sourceEl.addEventListener('click', (e) => {
				e.preventDefault()
				e.stopPropagation()
				onSourceActivated(COPY, id)
			})
		})

		// ── Proximity detection (cursor on desktop, scroll on touch) ───────
		if (!docListenersWired) {
			docListenersWired = true
			let rafPending = false
			const schedule = (px: number, py: number): void => {
				if (rafPending) return
				rafPending = true
				requestAnimationFrame(() => {
					rafPending = false
					updateProximity(px, py)
				})
			}
			if (isTouch) {
				// No cursor to sweep — "balayage" becomes scrolling: the needle
				// climbs as an unfound source nears the middle of the screen.
				const onScroll = (): void => schedule(window.innerWidth / 2, window.innerHeight / 2)
				window.addEventListener('scroll', onScroll, { passive: true })
				window.addEventListener('resize', onScroll)
			} else {
				document.addEventListener('pointermove', (e) => schedule(e.clientX, e.clientY))
			}
		}

		// Reflect the current position right away (idles at -80 if nothing near).
		if (isTouch) updateProximity(window.innerWidth / 2, window.innerHeight / 2)

		// ── Spotlight: mirror any bubble open/close onto a bright mascot ────
		if (!spotlightObserved) {
			spotlightObserved = true
			const obs = new MutationObserver(syncSpotlight)
			;['egg-intro-overlay', 'egg-reveal-overlay', 'egg-cert-overlay'].forEach((oid) => {
				const o = el(oid)
				if (o) obs.observe(o, { attributes: true, attributeFilter: ['class'] })
			})
			window.addEventListener('resize', syncSpotlight)
		}

		// ── Document-level listeners (once per document lifecycle) ─────────
		if (!document.documentElement.dataset.eggDocWired) {
			document.documentElement.dataset.eggDocWired = '1'

			// Intro CTA
			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement | null
				if (!target) return

				// Intro CTA button
				if (target.id === 'egg-intro-cta' || target.closest('#egg-intro-cta')) {
					const copyEl2 = document.getElementById('egg-copy')
					const copy2: EggCopy | null = copyEl2
						? ((): EggCopy | null => {
								try {
									return JSON.parse(copyEl2.textContent ?? '{}') as EggCopy
								} catch {
									return null
								}
							})()
						: null
					if (!copy2) return

					hide(el('egg-intro-overlay'))
					// Starting/resuming from the intro un-dismisses the HUD.
					const introData = load()
					introData.dismissed = false
					save(introData)
					show(el('egg-widget'))
					updateCountDisplay(introData.found)
					setNeedle(-80, 0)

					// If there's a pending source from a cold click, reveal it
					if (pendingSourceId !== null) {
						const sid = pendingSourceId
						pendingSourceId = null
						onSourceActivated(copy2, sid)
					}
				}

				// Reveal next button
				if (target.id === 'egg-reveal-next' || target.closest('#egg-reveal-next')) {
					hide(el('egg-reveal-overlay'))
					if (afterRevealCallback) {
						const cb = afterRevealCallback
						afterRevealCallback = null
						cb()
					}
				}

				// Certificate close button
				if (target.id === 'egg-cert-close' || target.closest('#egg-cert-close')) {
					closeCertificate()
				}

				// Widget close button — hide the HUD and remember the choice
				if (target.id === 'egg-widget-close' || target.closest('#egg-widget-close')) {
					const dismissData = load()
					dismissData.dismissed = true
					save(dismissData)
					hide(el('egg-widget'))
				}

				// Overlay click to close (but not if clicking the card itself)
				const introOverlay = el('egg-intro-overlay')
				const revealOverlay = el('egg-reveal-overlay')
				const certOverlay = el('egg-cert-overlay')

				if (introOverlay && !introOverlay.classList.contains('hidden') && target === introOverlay) {
					hide(introOverlay)
				}
				if (revealOverlay && !revealOverlay.classList.contains('hidden') && target === revealOverlay) {
					hide(revealOverlay)
					if (afterRevealCallback) {
						const cb = afterRevealCallback
						afterRevealCallback = null
						cb()
					}
				}
				if (certOverlay && !certOverlay.classList.contains('hidden') && target === certOverlay) {
					closeCertificate()
				}
			})

			// Escape key closes open dialogs
			document.addEventListener('keydown', (e) => {
				if (e.key !== 'Escape') return
				const introOverlay = el('egg-intro-overlay')
				const revealOverlay = el('egg-reveal-overlay')
				const certOverlay = el('egg-cert-overlay')

				if (introOverlay && !introOverlay.classList.contains('hidden')) {
					hide(introOverlay)
					return
				}
				if (revealOverlay && !revealOverlay.classList.contains('hidden')) {
					hide(revealOverlay)
					if (afterRevealCallback) {
						const cb = afterRevealCallback
						afterRevealCallback = null
						cb()
					}
					return
				}
				if (certOverlay && !certOverlay.classList.contains('hidden')) {
					closeCertificate()
				}
			})
		}
	}

	init()
	document.addEventListener('astro:page-load', init)
</script>
