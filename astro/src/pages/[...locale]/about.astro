---
import { Image } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import { getTranslations, getLocalePaths, localePath, type Locale } from '@/i18n/utils'
import { organizationSchema } from '@/data/schemas'
import geraldImg from '@/assets/images/Gerald.png'
import alainImg from '@/assets/images/Alain.png'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)
const a = t.about

const readMoreLabel = locale === 'fr' ? 'Lire la suite' : 'Read more'
---

<Layout title={t.seo.about.title} description={t.seo.about.description} jsonLd={[organizationSchema]}>

	<!-- ═══════════════════════════ HERO ═══════════════════════════ -->
	<section class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-3xl font-semibold tracking-tight text-foreground font-heading md:text-4xl lg:text-5xl">
				{a.header.title}
			</h1>
		</div>
	</section>

	<!-- ═══════════════════════════ FOUNDER CARDS ═══════════════════════════ -->
	<section class="pb-12 md:pb-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid gap-8 lg:grid-cols-2">

				<!-- Gerald Lopez -->
				<div class="rounded-lg border border-slate-200 dark:border-[#3D3A35] bg-white dark:bg-[#252320] p-8 hover:shadow-sm transition">
					<div class="flex flex-col items-center text-center mb-6">
						<Image
							src={geraldImg}
							alt="Gerald Lopez"
							width={120}
							height={120}
							class="rounded-full object-cover w-[120px] h-[120px] shadow-md"
							loading="lazy"
						/>
						<h2 class="mt-4 text-xl font-semibold text-foreground font-heading">
							Gerald Lopez
						</h2>
						<p class="mt-1 text-sm text-slate-500 italic">
							Marine Nationale &rarr; Orano la Hague &rarr; Dosimex
						</p>
					</div>

					<p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
						{a.gerald.paragraphs[0]}
					</p>

					{a.gerald.paragraphs.length > 1 && (
						<details class="mt-4 group">
							<summary class="flex items-center gap-2 text-primary-600 font-heading font-semibold hover:underline cursor-pointer">
								<span>{readMoreLabel}</span>
								<svg class="faq-chevron h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
								</svg>
							</summary>
							<div class="mt-4 space-y-4">
								{a.gerald.paragraphs.slice(1).map((paragraph) => (
									<p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">{paragraph}</p>
								))}
							</div>
						</details>
					)}
				</div>

				<!-- Alain Vivier -->
				<div class="rounded-lg border border-slate-200 dark:border-[#3D3A35] bg-white dark:bg-[#252320] p-8 hover:shadow-sm transition">
					<div class="flex flex-col items-center text-center mb-6">
						<Image
							src={alainImg}
							alt="Alain Vivier"
							width={120}
							height={120}
							class="rounded-full object-cover w-[120px] h-[120px] shadow-md"
							loading="lazy"
						/>
						<h2 class="mt-4 text-xl font-semibold text-foreground font-heading">
							Alain Vivier
						</h2>
						<p class="mt-1 text-sm text-slate-500 italic">
							Armee de l'Air &rarr; CEA &rarr; INSTN &rarr; Dosimex
						</p>
					</div>

					<p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
						{a.alain.paragraphs[0]}
					</p>

					{a.alain.paragraphs.length > 1 && (
						<details class="mt-4 group">
							<summary class="flex items-center gap-2 text-primary-600 font-heading font-semibold hover:underline cursor-pointer">
								<span>{readMoreLabel}</span>
								<svg class="faq-chevron h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
								</svg>
							</summary>
							<div class="mt-4 space-y-4">
								{a.alain.paragraphs.slice(1).map((paragraph) => (
									<p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">{paragraph}</p>
								))}
							</div>
						</details>
					)}
				</div>

			</div>
		</div>
	</section>

	<!-- ═══════════════════════════ EPILOGUE ═══════════════════════════ -->
	<section class="bg-[#E8E6E3] dark:bg-[#252320] py-12 md:py-20">
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
			<p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed italic">
				{a.epilogue}
			</p>
		</div>
	</section>

	<!-- ═══════════════════════════ CTA ═══════════════════════════ -->
	<section class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="text-3xl font-semibold text-foreground font-heading">{a.cta.title}</h2>
			<a
				href={localePath(locale, '/product')}
				class="mt-6 inline-flex items-center rounded-[8px] bg-primary-600 hover:bg-primary-700 text-white h-12 px-6 font-heading font-semibold transition-colors"
				data-ph-cta="view_product"
			>
				{a.cta.button}
			</a>
		</div>
	</section>

</Layout>
