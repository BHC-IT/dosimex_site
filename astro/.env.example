# Contact form — https://dashboard.emailjs.com
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# Analytics — https://eu.posthog.com
# Leave PUBLIC_POSTHOG_KEY empty to disable analytics entirely.
PUBLIC_POSTHOG_KEY=
# Ingestion host: the managed reverse-proxy domain.
PUBLIC_POSTHOG_HOST=https://f.dosismart.com
# App host, needed so in-app links resolve correctly behind the proxy.
PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# Optional
# always | never | identified_only (default: identified_only)
PUBLIC_POSTHOG_PERSON_PROFILES=identified_only
# Session replay — consent-gated, all inputs masked. (default: false)
PUBLIC_POSTHOG_SESSION_RECORDING=false
# Run without cookies/localStorage. 'on_reject' keeps anonymous aggregates when
# the banner is declined. Must also be enabled in the PostHog project settings.
# PUBLIC_POSTHOG_COOKIELESS=on_reject
# Verbose PostHog console logging. (default: false)
PUBLIC_POSTHOG_DEBUG=false
# Capture from `pnpm dev` too — off by default so dev traffic stays out. (default: false)
PUBLIC_POSTHOG_ENABLE_IN_DEV=false
