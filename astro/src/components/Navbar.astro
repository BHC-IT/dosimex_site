---
import ThemeToggle from './ThemeToggle.astro'
import LanguageSwitcher from './LanguageSwitcher.astro'
import MobileMenu from './MobileMenu.astro'
import { localePath, getAlternateUrl, type Translations, type Locale } from '@/i18n/utils'

interface Props {
	t: Translations
	locale: Locale
	alternateUrl?: string
}

const { t, locale, alternateUrl: alternateOverride } = Astro.props
const currentPath = Astro.url.pathname

interface NavLink {
	label: string
	href: string
}
type MenuEntry =
	| { type: 'link'; label: string; href: string }
	| { type: 'dropdown'; label: string; links: NavLink[] }

// Logiciels dropdown — Dosismart first (the product we sell now), then the
// Suite Dosimex (the heritage the codes evolve from).
const softwareLinks: NavLink[] = [
	{ label: t.navbar.dosismart, href: localePath(locale, '/dosismart') },
	{ label: t.navbar.suite, href: localePath(locale, '/software') },
]
// Ressources dropdown — pedagogy first (Comprendre), then the reference material.
const resourceLinks: NavLink[] = [
	{ label: t.navbar.learn, href: localePath(locale, '/learn') },
	{ label: t.navbar.documentation, href: localePath(locale, '/manuals') },
	{ label: t.navbar.blog, href: localePath(locale, '/blog') },
	{ label: t.navbar.books, href: localePath(locale, '/books') },
]
// Final top-level order: Logiciels ▾ · Tarifs · Ressources ▾ · Formations ·
// Références · Histoire · Contact.
const menu: MenuEntry[] = [
	{ type: 'dropdown', label: t.navbar.software, links: softwareLinks },
	{ type: 'link', label: t.navbar.pricing, href: localePath(locale, '/product') },
	{ type: 'dropdown', label: t.navbar.resources, links: resourceLinks },
	{ type: 'link', label: t.navbar.training, href: localePath(locale, '/training') },
	{ type: 'link', label: t.navbar.references, href: localePath(locale, '/references') },
	{ type: 'link', label: t.navbar.story, href: localePath(locale, '/about') },
	{ type: 'link', label: t.navbar.contact, href: localePath(locale, '/contact') },
]
// Mobile: grouped sections (Logiciels, Ressources) then the flat links.
const mobileGroups = [
	{ label: t.navbar.software, links: softwareLinks },
	{ label: t.navbar.resources, links: resourceLinks },
]
const mobileLinks: NavLink[] = menu.filter(
	(entry): entry is Extract<MenuEntry, { type: 'link' }> => entry.type === 'link'
)

const alternateUrl = alternateOverride ?? getAlternateUrl(currentPath)
// Primary CTA is Dosismart-first ("Essayer Dosismart"); the quote/founder path
// stays the secondary CTA on the home and contact pages.
const quoteLabel = locale === 'en' ? 'Try Dosismart' : 'Essayer Dosismart'
const quoteHref = 'https://dosismart.com'
---

<header
	id="site-nav"
	class="sticky top-0 z-50 bg-background transition-transform duration-300"
>
	<div class="w-full px-6 lg:px-16 flex items-center justify-between h-16">
		<!-- Left: logo + page links -->
		<div class="flex items-center gap-8">
		<!-- Logo -->
		<a href={localePath(locale, '/')} class="flex-shrink-0 flex items-center gap-2">
			<img
				src="/Images/bonhomme_dosi.gif"
				alt=""
				class="h-12 -my-2"
				width="48"
				height="48"
			/>
			<img
				src="/Images/logo_dosimex_new.webp"
				alt={t.altText.logo}
				class="h-7"
				width="140"
				height="28"
			/>
		</a>

		<!-- Desktop nav -->
		<nav class="hidden lg:flex items-center gap-4" aria-label="Main navigation">
			{menu.map((entry) =>
				entry.type === 'dropdown' ? (
					<div class="relative group">
						<button
							type="button"
							class="flex items-center gap-1 font-heading text-sm font-semibold text-foreground transition-colors hover:text-primary group-focus-within:text-primary"
							aria-haspopup="true"
							aria-expanded="false"
						>
							{entry.label}
							<svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
						</button>
						<div class="invisible absolute left-0 top-full min-w-[12rem] pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
							<div class="rounded-lg border border-border bg-background p-1.5 shadow-lg">
								{entry.links.map((link) => (
									<a
										href={link.href}
										class="block rounded-md px-3 py-2 text-sm font-medium text-foreground/80 transition-colors hover:bg-muted hover:text-primary"
									>
										{link.label}
									</a>
								))}
							</div>
						</div>
					</div>
				) : (
					<a
						href={entry.href}
						class="font-heading text-sm font-semibold text-foreground transition-colors hover:text-primary"
					>
						{entry.label}
					</a>
				)
			)}
		</nav>
		</div>

		<!-- Right cluster -->
		<div class="hidden lg:flex items-center gap-3">
			<LanguageSwitcher locale={locale} alternateUrl={alternateUrl} />

			<ThemeToggle locale={locale} />

			<!-- CTA: Try Dosismart -->
			<a
				href={quoteHref}
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-700"
				data-ph-cta="nav-trial"
			>
				{quoteLabel}
			</a>
		</div>

		<!-- Mobile: hamburger -->
		<div class="flex lg:hidden items-center">
			<MobileMenu
				groups={mobileGroups}
				navLinks={mobileLinks}
				alternateUrl={alternateUrl}
				locale={locale}
				quoteLabel={quoteLabel}
				quoteHref={quoteHref}
			/>
		</div>
	</div>
</header>

<script>
	function initNavScroll() {
		const nav = document.getElementById('site-nav')
		if (!nav) return

		let lastScrollY = 0
		const threshold = 10

		window.addEventListener('scroll', () => {
			const currentY = window.scrollY
			if (currentY < threshold) {
				nav.classList.remove('nav-hidden')
				nav.classList.add('nav-visible')
			} else if (currentY > lastScrollY + threshold) {
				nav.classList.add('nav-hidden')
				nav.classList.remove('nav-visible')
			} else if (currentY < lastScrollY - threshold) {
				nav.classList.remove('nav-hidden')
				nav.classList.add('nav-visible')
			}
			lastScrollY = currentY
		}, { passive: true })
	}

	initNavScroll()
	document.addEventListener('astro:page-load', initNavScroll)

	// Language switch: preserve scroll position
	function initLangSwitch() {
		document.querySelectorAll('[data-lang-switch]').forEach(link => {
			link.addEventListener('click', () => {
				sessionStorage.setItem('scrollY', String(window.scrollY))
			})
		})
		const savedY = sessionStorage.getItem('scrollY')
		if (savedY) {
			sessionStorage.removeItem('scrollY')
			requestAnimationFrame(() => window.scrollTo(0, parseInt(savedY)))
		}
	}
	initLangSwitch()
	document.addEventListener('astro:page-load', initLangSwitch)
</script>
