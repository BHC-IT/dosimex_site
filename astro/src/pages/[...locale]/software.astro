---
import Layout from '@/layouts/Layout.astro'
import VideoEmbed from '@/components/VideoEmbed.astro'
import { getTranslations, getLocalePaths, localePath, type Locale } from '@/i18n/utils'
import { organizationSchema } from '@/data/schemas'

export const getStaticPaths = getLocalePaths

const { locale } = Astro.props as { locale: Locale }
const t = getTranslations(locale)
const s = t.software
---

<Layout title={t.seo.software.title} description={t.seo.software.description} jsonLd={[organizationSchema]}>

	<!-- ═══════════════════════════ HERO ═══════════════════════════ -->
	<section class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h1 class="text-3xl font-semibold tracking-tight text-foreground font-heading md:text-4xl lg:text-5xl">
				{s.header.title}
			</h1>
			<p class="mt-6 max-w-3xl text-base text-slate-600 dark:text-slate-400 leading-relaxed">
				{s.header.description}
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				{s.header.anchors.map((anchor) => (
					<a
						href={anchor.href}
						class="inline-flex items-center gap-2 rounded-[8px] border-[1.5px] border-slate-300 dark:border-[#3D3A35] text-slate-700 dark:text-slate-300 h-12 px-6 font-heading font-semibold hover:bg-slate-100 dark:hover:bg-[#3D3A35] transition-colors"
					>
						{anchor.label}
						<span aria-hidden="true">&darr;</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════ DOSISMART BANNER ═══════════════════════════ -->
	<section class="bg-primary-50 dark:bg-primary-950/20 py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl font-semibold text-foreground font-heading">
				{s.dosismartBanner.title}
			</h2>
			<p class="mt-4 max-w-2xl text-base text-slate-600 dark:text-slate-400">
				{s.dosismartBanner.text}
			</p>
			<a
				href="https://dosismart.com"
				target="_blank"
				rel="noopener noreferrer"
				class="mt-6 inline-flex items-center gap-2 rounded-[8px] bg-primary-600 hover:bg-primary-700 text-white h-12 px-6 font-heading font-semibold transition-colors"
				data-ph-cta="try_dosismart"
			>
				{s.dosismartBanner.button}
				<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
				</svg>
			</a>
		</div>
	</section>

	<!-- ═══════════════════════════ PACK OPERATIONNEL ═══════════════════════════ -->
	<section id="pack-ope" class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-10">
				<h2 class="text-3xl font-semibold text-foreground font-heading">{s.packOpe.title}</h2>
				<p class="mt-3 max-w-3xl text-base text-slate-600 dark:text-slate-400">{s.packOpe.description}</p>
			</div>
			<div class="grid gap-6 lg:grid-cols-2">
				{s.packOpe.tools.map((tool) => (
					<div class="rounded-lg border border-slate-200 dark:border-[#3D3A35] bg-white dark:bg-[#252320] p-8 hover:shadow-sm hover:-translate-y-0.5 transition">
						<div class="flex items-start justify-between gap-3">
							<h3 class="text-lg font-semibold text-foreground font-heading">{tool.name}</h3>
							<div class="flex items-center gap-2 shrink-0">
								{tool.frOnly && (
									<span class="text-xs bg-[#E8E6E3] dark:bg-[#3D3A35] text-slate-500 rounded px-2 py-0.5">FR only</span>
								)}
							</div>
						</div>
						<p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{tool.description}</p>
						{tool.videoId && (
							<div class="mt-4">
								<VideoEmbed videoId={tool.videoId} title={tool.name} />
							</div>
						)}
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════ PACK PEDAGOGIQUE ═══════════════════════════ -->
	<section id="pack-peda" class="bg-[#E8E6E3] dark:bg-[#252320] py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-10">
				<h2 class="text-3xl font-semibold text-foreground font-heading">{s.packPeda.title}</h2>
				<p class="mt-3 max-w-3xl text-base text-slate-600 dark:text-slate-400">{s.packPeda.description}</p>
			</div>
			<div class="grid gap-6 lg:grid-cols-2">
				{s.packPeda.tools.map((tool) => (
					<div class="rounded-lg border border-slate-200 dark:border-[#3D3A35] bg-white dark:bg-[#1A1917] p-8 hover:shadow-sm hover:-translate-y-0.5 transition">
						<div class="flex items-start justify-between gap-3">
							<h3 class="text-lg font-semibold text-foreground font-heading">{tool.name}</h3>
							<div class="flex items-center gap-2 shrink-0">
								{tool.frOnly && (
									<span class="text-xs bg-[#E8E6E3] dark:bg-[#3D3A35] text-slate-500 rounded px-2 py-0.5">FR only</span>
								)}
							</div>
						</div>
						<p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{tool.description}</p>
						{tool.videoId && (
							<div class="mt-4">
								<VideoEmbed videoId={tool.videoId} title={tool.name} />
							</div>
						)}
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════ PACK MESURES ═══════════════════════════ -->
	<section id="pack-mes" class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-10">
				<h2 class="text-3xl font-semibold text-foreground font-heading">{s.packMes.title}</h2>
				<p class="mt-3 max-w-3xl text-base text-slate-600 dark:text-slate-400">{s.packMes.description}</p>
			</div>
			<div class="grid gap-6 lg:grid-cols-2">
				{s.packMes.tools.map((tool) => (
					<div class="rounded-lg border border-slate-200 dark:border-[#3D3A35] bg-white dark:bg-[#252320] p-8 hover:shadow-sm hover:-translate-y-0.5 transition">
						<div class="flex items-start justify-between gap-3">
							<h3 class="text-lg font-semibold text-foreground font-heading">{tool.name}</h3>
							<div class="flex items-center gap-2 shrink-0">
								{tool.frOnly && (
									<span class="text-xs bg-[#E8E6E3] dark:bg-[#3D3A35] text-slate-500 rounded px-2 py-0.5">FR only</span>
								)}
							</div>
						</div>
						<p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{tool.description}</p>
						{tool.videoId && (
							<div class="mt-4">
								<VideoEmbed videoId={tool.videoId} title={tool.name} />
							</div>
						)}
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════ MORE RESOURCES ═══════════════════════════ -->
	<section class="bg-[#E8E6E3] dark:bg-[#252320] py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl font-semibold text-foreground font-heading">{s.more.title}</h2>
			<ul class="mt-6 space-y-3">
				{s.more.links.map((link) => (
					<li>
						<a
							href={localePath(locale, link.href)}
							class="text-primary-600 font-heading font-semibold hover:underline"
						>
							{link.label} &rarr;
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- ═══════════════════════════ CONTACT CTA ═══════════════════════════ -->
	<section class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="text-3xl font-semibold text-foreground font-heading">{s.ask.title}</h2>
			<p class="mx-auto mt-4 max-w-2xl text-base text-slate-600 dark:text-slate-400">
				{s.ask.text}
			</p>
			<a
				href={localePath(locale, '/contact')}
				class="mt-6 inline-flex items-center rounded-[8px] bg-primary-600 hover:bg-primary-700 text-white h-12 px-6 font-heading font-semibold transition-colors"
				data-ph-cta="contact_us"
			>
				{s.ask.labelButton}
			</a>
		</div>
	</section>

</Layout>
