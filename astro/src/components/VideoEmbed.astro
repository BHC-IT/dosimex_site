---
interface Props {
	videoId: string
	title?: string
	class?: string
}

const { videoId, title = 'YouTube video', class: className = '' } = Astro.props
---

<div class:list={['relative aspect-video w-full overflow-hidden rounded-xl', className]}>
	<iframe
		src={`https://www.youtube.com/embed/${videoId}`}
		title={title}
		allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
		allowfullscreen
		loading="lazy"
		class="absolute inset-0 h-full w-full"
	></iframe>
</div>
