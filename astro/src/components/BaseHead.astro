---
import { getCanonicalUrl, getAlternateUrl } from '@/i18n/utils'

interface Props {
	title: string
	description: string
	ogImage?: string
	robots?: string
	jsonLd?: Record<string, unknown>[]
}

const { title, description, ogImage = '/og-default.png', robots, jsonLd } = Astro.props
const site = Astro.site?.toString() ?? 'https://dosimex.fr'
const canonicalUrl = getCanonicalUrl(site, Astro.url.pathname)
const alternateUrl = getCanonicalUrl(site, getAlternateUrl(Astro.url.pathname))
const isEn = Astro.url.pathname.startsWith('/en')
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${site.replace(/\/$/, '')}${ogImage}`
---

<!-- SEO -->
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}

<!-- Canonical + hreflang -->
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="fr" href={isEn ? alternateUrl : canonicalUrl} />
<link rel="alternate" hreflang="en" href={isEn ? canonicalUrl : alternateUrl} />
<link rel="alternate" hreflang="x-default" href={isEn ? alternateUrl : canonicalUrl} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content={isEn ? 'en_US' : 'fr_FR'} />
<meta property="og:locale:alternate" content={isEn ? 'fr_FR' : 'en_US'} />
<meta property="og:site_name" content="Dosimex" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- JSON-LD -->
{jsonLd?.map((schema) => (
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
