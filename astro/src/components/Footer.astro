---
import { localePath, type Translations, type Locale } from '@/i18n/utils'
import { videoIds } from '@/data/videos'

interface Props {
	t: Translations
	locale: Locale
}

const { t, locale } = Astro.props
const year = new Date().getFullYear()
---

<footer class="mt-20 border-t bg-foreground text-background/70">
	<div class="mx-auto max-w-7xl px-6 pt-16 pb-8">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-12 pb-8">
			<!-- Column 1: Brand + Copyright + Social -->
			<div>
				<a href={localePath(locale, '/')} class="text-xl font-heading font-bold text-background tracking-wider">
					DOSIMEX
				</a>
				<p class="mt-4 text-sm text-background/60 max-w-xs">
					{locale === 'fr' ? 'Outils de calculs radioprotection validés MCNP.' : 'MCNP-validated radiation protection calculation tools.'}
				</p>
				<div class="mt-6 flex items-center gap-4">
					<!-- LinkedIn -->
					<a href="https://www.linkedin.com/company/dosimex" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-background/60 hover:text-background transition-colors">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
					</a>
					<!-- YouTube -->
					<a href={videoIds.channelUrl} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-background/60 hover:text-background transition-colors">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"/><path fill="#fff" d="M9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
					</a>
				</div>
				<p class="mt-6 text-sm text-background/50">
					&copy; {year} Dosimex. {locale === 'fr' ? 'Tous droits réservés.' : 'All rights reserved.'}
				</p>
			</div>

			<!-- Column 2: Software + Resources -->
			<div>
				<h3 class="text-sm font-heading font-semibold uppercase tracking-wider text-background/60 mb-4">
					{locale === 'fr' ? 'Logiciel' : 'Software'}
				</h3>
				<ul class="space-y-3 text-sm">
					<li><a href={localePath(locale, '/software')} class="hover:text-background transition-colors">{locale === 'fr' ? 'Outils de calcul' : 'Calculation tools'}</a></li>
					<li><a href={localePath(locale, '/product')} class="hover:text-background transition-colors">{locale === 'fr' ? 'Tarifs' : 'Pricing'}</a></li>
					<li><a href="https://dosismart.com" target="_blank" rel="noopener noreferrer" class="hover:text-background transition-colors">Dosismart</a></li>
					<li><a href={localePath(locale, '/videos')} class="hover:text-background transition-colors">{locale === 'fr' ? 'Vidéos' : 'Videos'}</a></li>
					<li><a href={localePath(locale, '/manuals')} class="hover:text-background transition-colors">{locale === 'fr' ? 'Documentation' : 'Documentation'}</a></li>
					<li><a href={localePath(locale, '/books')} class="hover:text-background transition-colors">{locale === 'fr' ? 'Lectures' : 'Books'}</a></li>
					<li><a href={localePath(locale, '/blog')} class="hover:text-background transition-colors">Blog</a></li>
				</ul>
			</div>

			<!-- Column 3: Company -->
			<div>
				<h3 class="text-sm font-heading font-semibold uppercase tracking-wider text-background/60 mb-4">
					{locale === 'fr' ? 'Entreprise' : 'Company'}
				</h3>
				<ul class="space-y-3 text-sm">
					<li><a href={localePath(locale, '/about')} class="hover:text-background transition-colors">{locale === 'fr' ? 'Qui sommes-nous' : 'About us'}</a></li>
					<li><a href={localePath(locale, '/training')} class="hover:text-background transition-colors">{locale === 'fr' ? 'Formations' : 'Training'}</a></li>
					<li><a href={localePath(locale, '/contact')} class="hover:text-background transition-colors">Contact</a></li>
					<li>06 89 70 90 35</li>
					<li><button id="manage-cookies-footer" type="button" class="hover:text-background transition-colors cursor-pointer">{t.footer.manageCookies}</button></li>
				</ul>
			</div>
		</div>
	</div>
</footer>

<script>
	function initFooterCookies() {
		document.getElementById('manage-cookies-footer')?.addEventListener('click', () => {
			if (typeof window !== 'undefined' && 'CookieConsent' in window) {
				(window as Record<string, unknown>).CookieConsent
			}
		})
	}
	initFooterCookies()
</script>
