---
interface NavLink {
	label: string
	href: string
}

interface Props {
	navLinks: NavLink[]
	alternateUrl: string
	locale: string
	quoteLabel: string
	quoteHref: string
	trialLabel: string
}

const { navLinks, alternateUrl, locale, quoteLabel, quoteHref, trialLabel } = Astro.props
---

<!-- Hamburger button -->
<button
	type="button"
	id="mobile-menu-toggle"
	aria-label="Open menu"
	aria-expanded="false"
	aria-controls="mobile-menu-panel"
	class="relative w-8 h-8 flex flex-col justify-center items-center gap-1.5"
>
	<span id="hamburger-top" class="block h-0.5 w-5 bg-foreground/70 transition-all duration-200"></span>
	<span id="hamburger-bottom" class="block h-0.5 w-5 bg-foreground/70 transition-all duration-200"></span>
</button>

<!-- Full-page overlay menu -->
<div
	id="mobile-menu-panel"
	class="fixed inset-0 z-50 flex flex-col backdrop-blur-xl opacity-0 pointer-events-none transition-opacity duration-250 ease-out"
	style="background-color: color-mix(in srgb, var(--color-background) 88%, transparent)"
>
	<!-- Header row: logo + close -->
	<div class="flex items-center justify-between h-16 px-6 border-b border-border/30">
		<img
			src="/Images/logo_dosimex_new.webp"
			alt="Dosimex"
			class="h-7"
			width="140"
			height="28"
		/>
		<button
			type="button"
			id="mobile-menu-close"
			aria-label="Close menu"
			class="p-2 -mr-2 text-foreground/60 hover:text-foreground transition-colors"
		>
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M18 6L6 18M6 6l12 12" />
			</svg>
		</button>
	</div>

	<!-- Nav links — centered -->
	<nav class="flex-1 flex flex-col items-center justify-center gap-5 px-6">
		{navLinks.map((link) => (
			<a
				href={link.href}
				class="mobile-menu-link text-xl font-heading font-semibold text-foreground/80 hover:text-primary transition-colors"
			>
				{link.label}
			</a>
		))}

		<!-- Lang + mode row -->
		<div class="flex items-center gap-4 mt-2">
			<!-- Language switch -->
			<a
				href={alternateUrl}
				data-lang-switch
				class="mobile-menu-link inline-flex items-center gap-2 rounded-md border border-border px-3 py-1.5 text-sm font-bold text-foreground/60 hover:text-foreground transition-colors"
			>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0">
					<circle cx="12" cy="12" r="10" />
					<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
					<path d="M2 12h20" />
				</svg>
				{locale === 'fr' ? 'EN' : 'FR'}
			</a>

			<!-- Dark mode toggle -->
			<button
				type="button"
				data-mobile-theme
				aria-label="Toggle dark mode"
				class="inline-flex items-center gap-2 rounded-md border border-border px-3 py-1.5 text-sm font-medium text-foreground/60 hover:text-foreground transition-colors"
			>
				<svg class="hidden dark:block w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="5" />
					<path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
				</svg>
				<svg class="block dark:hidden w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
				</svg>
				<span class="hidden dark:inline">{locale === 'fr' ? 'Clair' : 'Light'}</span>
				<span class="inline dark:hidden">{locale === 'fr' ? 'Sombre' : 'Dark'}</span>
			</button>
		</div>

		<!-- CTA buttons -->
		<div class="flex flex-col gap-3 w-full max-w-xs mt-4">
			<a
				href="https://dosismart.com"
				target="_blank"
				rel="noopener noreferrer"
				class="mobile-menu-link flex items-center justify-center h-12 rounded-lg border border-primary text-sm font-heading font-semibold text-primary transition-colors hover:bg-primary/10"
				data-ph-cta="nav-trial-mobile"
			>
				{trialLabel}
			</a>
			<a
				href={quoteHref}
				class="mobile-menu-link flex items-center justify-center h-12 rounded-lg bg-primary text-sm font-heading font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
				data-ph-cta="nav-quote-mobile"
			>
				{quoteLabel}
			</a>
		</div>
	</nav>
</div>

<!-- Blocking script: paint a cover immediately if returning from lang switch -->
<script is:inline>
	if (sessionStorage.getItem('mobile-menu-open')) {
		var c = document.createElement('div');
		c.id = 'menu-lang-cover';
		c.style.cssText = 'position:fixed;inset:0;z-index:9999;backdrop-filter:blur(24px);background-color:color-mix(in srgb,var(--color-background) 88%,transparent)';
		document.documentElement.appendChild(c);
	}
</script>

<script>
	function initMobileMenu() {
		const toggle = document.getElementById('mobile-menu-toggle')
		const panel = document.getElementById('mobile-menu-panel')
		if (!toggle || !panel) return

		// Prevent double init
		if (panel.dataset.init) return
		panel.dataset.init = '1'

		// Move panel to body so fixed positioning works
		// (header's backdrop-filter creates a containing block)
		document.body.appendChild(panel)

		const close = panel.querySelector<HTMLElement>('#mobile-menu-close')
		const themeBtn = panel.querySelector<HTMLButtonElement>('[data-mobile-theme]')
		const links = panel.querySelectorAll<HTMLElement>('a.mobile-menu-link:not([data-lang-switch])')
		const topBar = document.getElementById('hamburger-top')
		const bottomBar = document.getElementById('hamburger-bottom')

		function open() {
			panel.classList.remove('opacity-0', 'pointer-events-none')
			panel.classList.add('opacity-100')
			toggle.setAttribute('aria-expanded', 'true')
			toggle.setAttribute('aria-label', 'Close menu')
			topBar?.classList.add('translate-y-[4px]', 'rotate-45')
			bottomBar?.classList.add('-translate-y-[4px]', '-rotate-45')
			document.body.style.overflow = 'hidden'
		}

		function closeMenu() {
			panel.classList.add('opacity-0', 'pointer-events-none')
			panel.classList.remove('opacity-100')
			toggle.setAttribute('aria-expanded', 'false')
			toggle.setAttribute('aria-label', 'Open menu')
			topBar?.classList.remove('translate-y-[4px]', 'rotate-45')
			bottomBar?.classList.remove('-translate-y-[4px]', '-rotate-45')
			document.body.style.overflow = ''
		}

		toggle.addEventListener('click', () => {
			const isOpen = toggle.getAttribute('aria-expanded') === 'true'
			isOpen ? closeMenu() : open()
		})

		close?.addEventListener('click', closeMenu)

		// Keep menu open across language switch
		const langLink = panel.querySelector<HTMLElement>('a[data-lang-switch]')
		langLink?.addEventListener('click', () => {
			sessionStorage.setItem('mobile-menu-open', '1')
		})

		// Reopen menu if returning from a language switch
		if (sessionStorage.getItem('mobile-menu-open')) {
			sessionStorage.removeItem('mobile-menu-open')
			open()
			document.getElementById('menu-lang-cover')?.remove()
		}

		links.forEach(link => {
			link.addEventListener('click', closeMenu)
		})

		themeBtn?.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark')
			localStorage.setItem('theme', isDark ? 'dark' : 'light')
		})

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				closeMenu()
			}
		})
	}

	initMobileMenu()
	document.addEventListener('astro:page-load', initMobileMenu)
</script>
